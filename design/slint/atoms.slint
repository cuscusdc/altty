// Átomos de referência do design system do Kazzu (Slint 1.19). Compilados e conferidos no design; o kazzu-app deve
// MOVER/ADAPTAR estes arquivos, não reinventar. Nada aqui chama Rust além de callbacks.
// Receita do vidro: SLINT_SPEC.md §2.  Tokens: tokens.slint (gerado de tokens.json).

import { Theme } from "tokens.slint";

// ---------------------------------------------------------------------------------------------
// PALCO VIVO (v2): o fundo ambiente que dá ao vidro algo para desfocar. Malha de 4 manchões com o matiz da capa
// (Theme.stage-a..d, calculados no Rust com a fórmula de DESIGN.md §3.5) + a própria capa em grande escala, já
// desfocada e escurecida pelo Rust (96x96, sigma 4, saturação 1.35, brilho 0.72) + véu inferior.
// Vai UMA vez, atrás de tudo, ocupando a janela inteira. Sem ele o vidro vira cartão escuro opaco (erro da v1).
// ---------------------------------------------------------------------------------------------
export component Stage inherits Rectangle {
    in property <image> backdrop;         // capa pré-desfocada pelo Rust; vazia = só a malha
    in property <bool> has-cover: false;
    in property <bool> show-cover: true;  // false com "Reduzir movimento" se o autor quiser palco estático
    background: Theme.stage-base;
    clip: true;
    // manchão A (alto-esquerda), B (direita), C (meio-esquerda), D (rodapé): posições de tokens.json > stage.layout
    Rectangle { width: max(parent.width, parent.height) * 1.3; height: self.width; x: parent.width * 0.12 - self.width / 2; y: parent.height * 0.08 - self.height / 2;
        background: @radial-gradient(circle, Theme.stage-a 0%, Theme.stage-a.with-alpha(0.0) 70%); }
    Rectangle { width: max(parent.width, parent.height) * 1.2; height: self.width; x: parent.width * 0.98 - self.width / 2; y: parent.height * 0.34 - self.height / 2;
        background: @radial-gradient(circle, Theme.stage-b 0%, Theme.stage-b.with-alpha(0.0) 70%); }
    Rectangle { width: max(parent.width, parent.height) * 1.2; height: self.width; x: parent.width * 0.10 - self.width / 2; y: parent.height * 0.72 - self.height / 2;
        background: @radial-gradient(circle, Theme.stage-c 0%, Theme.stage-c.with-alpha(0.0) 70%); }
    Rectangle { width: max(parent.width, parent.height) * 1.1; height: self.width; x: parent.width * 0.88 - self.width / 2; y: parent.height * 0.96 - self.height / 2;
        background: @radial-gradient(circle, Theme.stage-d 0%, Theme.stage-d.with-alpha(0.0) 70%); }
    if root.has-cover && root.show-cover : Image {
        source: root.backdrop; image-fit: cover; opacity: Theme.ambient-opacity;
        width: root.width * 1.5; height: root.height * 1.5; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2 - root.height * 0.1;
    }
    Rectangle { background: @linear-gradient(180deg, transparent 55%, Theme.stage-base.with-alpha(0.55) 100%); }
}

// ---------------------------------------------------------------------------------------------
// VIDRO (v2): 3 níveis de profundidade. Receita, de baixo para cima:
//   1. backdrop-blur (20 / 32 / 40)           2. fill translúcido = glass-tint (matiz da capa) com alfa por nível
//   3. brilho superior (gradiente 50% da altura)  4. borda de 1 px em GRADIENTE de luz (forte no canto superior esquerdo)
//   5. fio especular de 1 px no topo           6. sombra (e por nível)
// Nível 1 = conteúdo (cartões, grupos)  | 2 = cromo flutuante (dock, mini player, campo)  | 3 = folhas, menus, diálogos.
// Quanto mais alto, mais opaco e mais sombra (contraste AA garantido, ver tokens.json/gen_tokens.py).
// Sem blur (renderer software) ou Theme.reduce-transparency: fill sólido, blur 0, mesma hierarquia (Theme.glass-live).
// Limites: <= Theme "max-blurred-layers" (6) painéis com blur visíveis; nunca dentro de ListView; nunca aninhar
// GlassPanel dentro de GlassPanel (o filho borraria o pai, não o palco): filhos usam `Theme.ink.with-alpha(0.12)` simples.
// ---------------------------------------------------------------------------------------------
export component GlassPanel inherits Rectangle {
    in property <length> radius: Theme.r-lg;
    in property <int> level: 1;            // 1 conteúdo | 2 cromo flutuante | 3 folhas e menus
    in property <bool> strong: false;      // LEGADO v1: equivale a level 2
    in property <bool> light-blur: false;  // LEGADO v1: botões pequenos (blur 16)
    in property <bool> elevated: true;     // sombra do nível

    property <int> lv: root.strong ? 2 : root.level;
    border-radius: radius;
    background: lv == 3 ? Theme.glass-bg-3 : (lv == 2 ? Theme.glass-bg-strong : Theme.glass-bg);
    backdrop-blur: light-blur ? Theme.glass-blur-light-radius : (lv == 3 ? Theme.glass-blur-3 : (lv == 2 ? Theme.glass-blur-2 : Theme.glass-blur-1));
    // borda de luz em gradiente (FemtoVG/Skia aceitam brush em border-color). Se um renderer ignorar, cai na cor de repouso.
    border-width: 1px;
    border-color: @linear-gradient(155deg, Theme.glass-edge 0%, Theme.glass-edge-low 34%, Theme.glass-edge-low 66%, Theme.glass-edge.with-alpha(0.4) 100%);
    drop-shadow-blur: elevated ? (lv == 3 ? Theme.glass-shadow-blur-3 : (lv == 2 ? Theme.glass-shadow-blur-2 : Theme.glass-shadow-blur-1)) : 0px;
    drop-shadow-offset-y: lv == 3 ? Theme.glass-shadow-y-3 : (lv == 2 ? Theme.glass-shadow-y-2 : Theme.glass-shadow-y-1);
    drop-shadow-color: Theme.e2-color;
    clip: true;

    // brilho superior: gradiente na metade de cima
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height * 0.52;
        background: @linear-gradient(180deg, Theme.glass-sheen 0%, transparent 100%);
    }
    // brilho especular: fio de 1px no topo, esvaecendo nas pontas
    Rectangle {
        x: root.radius; y: 0px; width: max(0px, parent.width - 2 * root.radius); height: 1px;
        background: @linear-gradient(90deg, transparent 0%, Theme.glass-edge 22%, Theme.glass-edge 78%, transparent 100%);
    }
    @children
}

// ---------------------------------------------------------------------------------------------
// "Vidro leve": chip, pílula de ação, campo. SEM blur próprio (nunca aninhar blur): translúcido sobre o palco.
// `selected`: preenchido com Theme.ink (chip ativo, texto Theme.bg).
// ---------------------------------------------------------------------------------------------
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();
    height: Theme.chip-h; border-radius: self.height / 2;
    width: lbl.preferred-width + 32px;
    background: selected ? Theme.ink : Theme.ink.with-alpha(0.12);
    border-width: selected ? 0px : 1px; border-color: Theme.ink.with-alpha(0.16);
    accessible-role: button; accessible-label: text; accessible-checkable: true; accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
    lbl := Text { text: root.text; font-size: Theme.fs-subhead; font-weight: Theme.fw-caption; color: root.selected ? Theme.bg : Theme.ink; x: 16px; y: (parent.height - self.height) / 2; }
    // alvo de toque de 48 (o chip tem 40): área invisível de 4px acima e abaixo
    TouchArea { y: -4px; height: parent.height + 8px; clicked => { root.clicked(); } }
}

// ---------------------------------------------------------------------------------------------
// Capa com contorno de 1px (separa capas escuras do fundo). `radius` por contexto: 10 miniatura, 16 cartão, 28 player.
// ---------------------------------------------------------------------------------------------
export component CoverImage inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.thumb-radius;
    in property <color> placeholder: Theme.surface-2;
    border-radius: radius;
    background: placeholder;
    clip: true;
    Image { source: root.source; width: 100%; height: 100%; image-fit: cover; }
    Rectangle { border-radius: root.radius; border-width: 1px; border-color: Theme.dark ? #ffffff14 : #00000014; }
}

// ---------------------------------------------------------------------------------------------
// Botão de ícone: alvo 44px, foco visível, rótulo de acessibilidade OBRIGATÓRIO.
// ---------------------------------------------------------------------------------------------
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;                 // accessible-label (pt-BR)
    in property <color> tint: Theme.ink-2;
    in property <bool> active: false;           // equivale a aria-pressed
    in property <length> glyph: Theme.icon;
    in property <length> size: Theme.hit;
    in property <bool> enabled: true;
    callback clicked();

    width: size; height: size; border-radius: size / 2;
    background: !enabled ? transparent : ta.pressed ? Theme.surface-3 : ta.has-hover ? Theme.accent-soft : transparent;
    opacity: enabled ? 1.0 : 0.5;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    animate background { duration: Theme.dur-micro; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }

    Image {
        source: root.icon; width: root.glyph; height: root.glyph;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        colorize: root.active ? Theme.accent : root.tint;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    // anel de foco: 2px, deslocado 2px, aparece na hora (sem animação)
    Rectangle {
        visible: fs.has-focus;
        x: -Theme.focus-offset; y: -Theme.focus-offset;
        width: parent.width + 2 * Theme.focus-offset; height: parent.height + 2 * Theme.focus-offset;
        border-radius: (parent.width + 2 * Theme.focus-offset) / 2;
        border-width: Theme.focus-ring-w; border-color: Theme.focus-ring;
    }
}

// ---------------------------------------------------------------------------------------------
// Selo de formato: FLAC | 24/96. `hires` (>= 24 bits) usa a cor de destaque.
// ---------------------------------------------------------------------------------------------
export component FormatBadge inherits Rectangle {
    in property <string> codec: "FLAC";
    in property <string> detail: "24/96";
    in property <bool> hires: false;
    in property <color> ink: Theme.ink-2;          // no player (imersivo): Theme.im-ink-2
    in property <color> strong-ink: Theme.ink;
    height: 22px; border-radius: 7px;
    border-width: 1px;
    border-color: hires ? Theme.accent.with-alpha(0.55) : Theme.line-strong;
    width: row.preferred-width + 16px;
    accessible-role: text;
    accessible-label: codec + " " + detail;
    row := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
        Text { text: root.codec; font-family: Theme.font-mono; font-size: Theme.fs-badge; font-weight: Theme.fw-badge; color: root.hires ? Theme.accent : root.strong-ink; vertical-alignment: center; }
        Rectangle { width: 1px; height: 10px; background: Theme.line-strong; y: (root.height - 10px) / 2 - 1px; }
        Text { text: root.detail; font-family: Theme.font-mono; font-size: Theme.fs-badge; font-weight: Theme.fw-badge; color: root.ink; vertical-alignment: center; }
    }
}

// ---------------------------------------------------------------------------------------------
// Interruptor 52x32 (alvo 44 com margem invisível). `locked` = ligado e não editável (Sem telemetria).
// ---------------------------------------------------------------------------------------------
export component KSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> locked: false;
    in property <string> label;
    callback toggled(bool);
    width: 52px; height: 32px; border-radius: 16px;
    background: (checked || locked) ? Theme.accent : Theme.surface-3;
    accessible-role: switch;
    accessible-label: label;
    accessible-checked: checked || locked;
    accessible-enabled: !locked;
    accessible-action-default => { root.flip(); }
    animate background { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    function flip() { if (!locked) { root.checked = !root.checked; root.toggled(root.checked); } }
    Rectangle {
        y: 3px; width: 26px; height: 26px; border-radius: 13px;
        x: (root.checked || root.locked) ? 23px : 3px;
        background: (root.checked || root.locked) ? Theme.accent-ink : Theme.ink;
        animate x { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    }
    TouchArea { x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px; enabled: !root.locked; clicked => { root.flip(); } }
    fs := FocusScope { focus-on-click: false;
        enabled: !root.locked;
        key-pressed(e) => { if (e.text == " " || e.text == Key.Return) { root.flip(); return accept; } return reject; }
    }
    Rectangle {
        visible: fs.has-focus;
        x: -Theme.focus-offset; y: -Theme.focus-offset; width: parent.width + 4px; height: parent.height + 4px;
        border-radius: 18px; border-width: Theme.focus-ring-w; border-color: Theme.focus-ring;
    }
}

// ---------------------------------------------------------------------------------------------
// Barra de progresso/volume. value 0..1. Trilho 6px (10px com hover/foco/arraste), alvo de 44px, polegar 20px.
// `immersive`: cores do player (trilho branco 24%, preenchimento branco ou acento).
// ---------------------------------------------------------------------------------------------
export component KSlider inherits Rectangle {
    // ALTERAÇÃO do kazzu-app (ver docs/UI_NOTES.md): `value` é `in`, para a ligação com AppState.progress não ser
    // quebrada pelo arraste; o valor mostrado durante o arraste (e por 300 ms depois, até o motor confirmar) é interno.
    in property <float> value: 0.0;
    in property <bool> immersive: true;
    in property <bool> accent-fill: false;
    in property <string> label;
    in property <string> value-text;
    in property <bool> enabled: true;
    callback changed(float);     // durante o arraste e por teclado
    callback released(float);    // ao soltar (seek efetivo)

    height: Theme.hit;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value-text;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: 0.05;
    accessible-enabled: enabled;
    opacity: enabled ? 1.0 : 0.45;

    property <bool> dragging: false;
    property <bool> pending: false;
    property <float> held: 0.0;
    property <float> shown: (dragging || pending) ? held : value;
    changed value => { root.pending = false; }
    property <bool> engaged: ta.has-hover || fs.has-focus || ta.pressed;
    property <length> track-h: engaged ? Theme.progress-h-active : Theme.progress-h;
    animate track-h { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    function nudge(delta: float) {
        root.held = clamp(root.shown + delta, 0.0, 1.0);
        root.pending = true; hold.running = true;
        root.changed(root.held); root.released(root.held);
    }
    hold := Timer { interval: 300ms; running: false; triggered => { root.pending = false; self.running = false; } }

    Rectangle { // trilho
        y: (parent.height - self.height) / 2; height: root.track-h; border-radius: self.height / 2;
        background: root.immersive ? Theme.im-track : Theme.surface-3;
        Rectangle { // preenchimento
            x: 0px; width: parent.width * clamp(root.shown, 0.0, 1.0); height: parent.height; border-radius: parent.border-radius;
            background: root.accent-fill ? Theme.accent : (root.immersive ? Theme.im-ink : Theme.accent);
        }
    }
    Rectangle { // polegar
        visible: root.engaged;
        width: Theme.slider-thumb; height: Theme.slider-thumb; border-radius: Theme.slider-thumb / 2;
        x: parent.width * clamp(root.shown, 0.0, 1.0) - self.width / 2; y: (parent.height - self.height) / 2;
        background: root.immersive ? Theme.im-ink : Theme.ink;
        drop-shadow-blur: Theme.e1-blur; drop-shadow-offset-y: Theme.e1-y; drop-shadow-color: Theme.e1-color;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragging = true; root.held = clamp(self.mouse-x / root.width, 0.0, 1.0); root.changed(root.held);
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.dragging) {
                    root.dragging = false; root.pending = true; hold.running = true;
                    root.released(root.held);
                }
            }
        }
        moved => { if (self.pressed) { root.held = clamp(self.mouse-x / root.width, 0.0, 1.0); root.changed(root.held); } }
    }
    fs := FocusScope { focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) { root.nudge(0.05); return accept; }
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) { root.nudge(-0.05); return accept; }
            return reject;
        }
    }
    Rectangle {
        visible: fs.has-focus;
        x: -Theme.focus-offset; y: (parent.height - Theme.progress-h-active) / 2 - Theme.focus-offset - 4px;
        width: parent.width + 2 * Theme.focus-offset; height: Theme.progress-h-active + 2 * Theme.focus-offset + 8px;
        border-radius: 12px; border-width: Theme.focus-ring-w; border-color: Theme.focus-ring;
    }
}
