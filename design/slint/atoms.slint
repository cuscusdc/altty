// Átomos de referência do design system do Kazzu v3 (Apple-like, Slint 1.19). Compilados e renderizados no design
// (design/tools/slint-shot); o kazzu-app deve MOVER/ADAPTAR estes arquivos, não reinventar. Nada aqui chama Rust além de callbacks.
// Receita do vidro: DESIGN.md §6 e SLINT_SPEC.md §2.  Tokens: tokens.slint (gerado de tokens.json).
//
// v3 em uma frase: fundo NEUTRO, cor vem das CAPAS, e o cromo flutuante (barra, mini player, cabeçalho de rolagem, folhas,
// legendas sobre capas) é VIDRO CLARO sobre o conteúdo que passa por trás. Sem malha de gradiente, sem vidro "esfumaçado" tingido.

import { Theme } from "tokens.slint";

// ---------------------------------------------------------------------------------------------
// FUNDO (v3). Neutro: preto verdadeiro / grafite no escuro, cinza-sistema no claro. Sem manchões coloridos.
// `immersive` (SÓ no player): a capa pré-desfocada pelo Rust (96×96, σ 4) esticada em 150%, um véu escuro neutro e um degradê
// inferior para o texto ter contraste. Sem capa: grafite. A cor do player é a da capa, nunca um laranja forçado.
// ---------------------------------------------------------------------------------------------
export component Stage inherits Rectangle {
    in property <image> backdrop;         // capa pré-desfocada pelo Rust; vazia = grafite
    in property <bool> has-cover: false;
    in property <bool> immersive: false;  // true só no player
    background: immersive ? Theme.surface : Theme.bg;
    clip: true;
    if root.immersive && root.has-cover : Image {
        source: root.backdrop; image-fit: ImageFit.cover;
        width: root.width * 1.5; height: root.height * 1.5;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2 - root.height * 0.12;
    }
    if root.immersive : Rectangle { background: Theme.im-veil; }
    if root.immersive : Rectangle { background: @linear-gradient(180deg, Theme.im-scrim-top 0%, Theme.im-scrim-mid 30%, Theme.im-scrim-bottom 100%); }
}

// ---------------------------------------------------------------------------------------------
// VIDRO (v3): 3 materiais Apple-like. Receita, de baixo para cima:
//   1. backdrop-blur forte (24 / 32 / 40)
//   2. SOMBREADO neutro (preto 36–52% no escuro; nenhum no claro)   ← garante contraste sem tingir
//   3. TINT claro translúcido (branco 10–20% no escuro; 55–75% no claro)  ← é isto que faz ler "vidro", não "fumaça"
//   4. brilho especular: gradiente branco no topo (52% da altura)
//   5. borda de luz de 1 px em GRADIENTE (forte no canto superior esquerdo) + fio especular de 1 px no topo
//   6. sombra neutra do nível
// Nível 1 = fino (legendas sobre capa, banners, botões) | 2 = regular (barra, mini player, NowBar, cabeçalho) | 3 = espesso (folhas).
// SÓ lê como vidro com CONTEÚDO COLORIDO passando por trás: o cromo fica sempre sobre a lista/capas (DESIGN.md §6.1).
// Sem blur (renderer software) ou Theme.reduce-transparency: fundo sólido (glass-solid*), tint some, mesma hierarquia.
// Limites: <= 6 painéis com blur visíveis; nunca dentro de ListView; nunca aninhar GlassPanel (o filho borraria o pai).
// ---------------------------------------------------------------------------------------------
export component GlassPanel inherits Rectangle {
    in property <length> radius: Theme.r-lg;
    in property <int> level: 1;            // 1 fino | 2 regular | 3 espesso
    in property <bool> elevated: true;     // sombra do nível
    in property <bool> light-blur: false;  // botões pequenos (blur 16)

    property <int> lv: root.level;
    border-radius: radius;
    background: lv == 3 ? Theme.glass-bg-3 : (lv == 2 ? Theme.glass-bg-2 : Theme.glass-bg-1);
    backdrop-blur: light-blur ? Theme.glass-blur-light-radius : (lv == 3 ? Theme.glass-blur-3 : (lv == 2 ? Theme.glass-blur-2 : Theme.glass-blur-1));
    border-width: 1px;
    border-color: @linear-gradient(155deg, Theme.glass-edge 0%, Theme.glass-edge-low 34%, Theme.glass-edge-low 66%, Theme.glass-edge.with-alpha(0.45) 100%);
    drop-shadow-blur: elevated ? (lv == 3 ? Theme.glass-shadow-blur-3 : (lv == 2 ? Theme.glass-shadow-blur-2 : Theme.glass-shadow-blur-1)) : 0px;
    drop-shadow-offset-y: lv == 3 ? Theme.glass-shadow-y-3 : (lv == 2 ? Theme.glass-shadow-y-2 : Theme.glass-shadow-y-1);
    drop-shadow-color: Theme.e2-color;
    clip: true;

    // tint claro translúcido
    Rectangle { background: lv == 3 ? Theme.glass-tint-3 : (lv == 2 ? Theme.glass-tint-2 : Theme.glass-tint-1); opacity: Theme.glass-tint-on; }
    // brilho superior (gradiente na metade de cima)
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height * 0.52; opacity: Theme.glass-tint-on;
        background: @linear-gradient(180deg, Theme.glass-sheen 0%, transparent 100%);
    }
    // fio especular de 1 px no topo, esvaecendo nas pontas
    Rectangle {
        x: root.radius; y: 0px; width: max(0px, parent.width - 2 * root.radius); height: 1px; opacity: Theme.glass-tint-on;
        background: @linear-gradient(90deg, transparent 0%, Theme.glass-edge 22%, Theme.glass-edge 78%, transparent 100%);
    }
    @children
}

// ---------------------------------------------------------------------------------------------
// Degradê de borda de rolagem (scroll edge): o conteúdo some suavemente sob o cromo, garante contraste do texto do vidro sobre
// capas claras. `top: true` desce do topo; senão sobe do rodapé. Cor = Theme.edge-fade (preto / cinza-sistema).
// ---------------------------------------------------------------------------------------------
export component EdgeFade inherits Rectangle {
    in property <bool> top: false;
    in property <float> strength: 0.55;
    background: top ? @linear-gradient(180deg, Theme.edge-fade.with-alpha(root.strength) 0%, Theme.edge-fade.with-alpha(0.0) 100%)
                    : @linear-gradient(180deg, Theme.edge-fade.with-alpha(0.0) 0%, Theme.edge-fade.with-alpha(root.strength * 0.6) 45%, Theme.edge-fade.with-alpha(root.strength) 100%);
}

// ---------------------------------------------------------------------------------------------
// Separador fino de listas agrupadas (1 px, recuado até o texto).
// ---------------------------------------------------------------------------------------------
export component Divider inherits Rectangle {
    in property <length> inset: 0px;
    height: 1px;
    Rectangle { x: root.inset; width: parent.width - root.inset; background: Theme.line; }
}

// ---------------------------------------------------------------------------------------------
// Lista agrupada (inset grouped): cartão opaco de cantos grandes (raio 20), separadores finos. NÃO é vidro: o vidro é só o que flutua.
// ---------------------------------------------------------------------------------------------
export component GroupCard inherits Rectangle {
    in property <length> radius: Theme.group-radius;
    background: Theme.surface;
    border-radius: radius;
    clip: true;
    VerticalLayout { spacing: 0px; @children }
}

// ---------------------------------------------------------------------------------------------
// Pílula de neutra translúcida (chip). Sem blur próprio. `selected`: tinta invertida (texto Theme.bg).
// ---------------------------------------------------------------------------------------------
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();
    height: Theme.chip-h; border-radius: self.height / 2;
    width: lbl.preferred-width + 32px;
    background: selected ? Theme.ink : Theme.fill;
    accessible-role: button; accessible-label: text; accessible-checkable: true; accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
    lbl := Text { text: root.text; font-family: Theme.font-sans; font-size: Theme.fs-subhead; font-weight: 600; letter-spacing: Theme.ls-subhead; color: root.selected ? Theme.bg : Theme.ink; x: 16px; y: (parent.height - self.height) / 2; }
    // alvo de toque de 48 (o chip tem 40): área invisível de 4px acima e abaixo
    TouchArea { y: -4px; height: parent.height + 8px; mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false;
        key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } return reject; }
    }
    Rectangle { visible: fs.has-focus; border-radius: parent.height / 2; border-width: Theme.focus-ring-w; border-color: Theme.focus-ring; }
}

// ---------------------------------------------------------------------------------------------
// Capa com contorno de 1px (separa capas escuras do fundo). `radius` por contexto: 10 miniatura, 14 tile, 22 player.
// ---------------------------------------------------------------------------------------------
export component CoverImage inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.thumb-radius;
    in property <color> placeholder: Theme.surface-2;
    border-radius: radius;
    background: placeholder;
    clip: true;
    Image { source: root.source; width: 100%; height: 100%; image-fit: ImageFit.cover; }
    Rectangle { border-radius: root.radius; border-width: 1px; border-color: Theme.dark ? #ffffff1a : #0000001a; }
}

// ---------------------------------------------------------------------------------------------
// Botão de ícone: alvo 48px, foco visível, rótulo de acessibilidade OBRIGATÓRIO.
// ---------------------------------------------------------------------------------------------
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;                 // accessible-label (pt-BR)
    in property <color> tint: Theme.ink;
    in property <bool> active: false;           // equivale a aria-pressed
    in property <length> glyph: Theme.icon;
    in property <length> size: Theme.hit;
    in property <bool> enabled: true;
    callback clicked();

    width: size; height: size; border-radius: size / 2;
    background: !enabled ? transparent : ta.pressed ? Theme.fill-2 : ta.has-hover ? Theme.fill : transparent;
    opacity: enabled ? 1.0 : 0.5;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    animate background { duration: Theme.dur-micro; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }

    Image {
        source: root.icon; width: root.glyph; height: root.glyph;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        colorize: root.active ? Theme.accent : root.tint;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    // anel de foco: 2px, deslocado 2px, aparece na hora (sem animação)
    Rectangle {
        visible: fs.has-focus;
        x: -Theme.focus-offset; y: -Theme.focus-offset;
        width: parent.width + 2 * Theme.focus-offset; height: parent.height + 2 * Theme.focus-offset;
        border-radius: (parent.width + 2 * Theme.focus-offset) / 2;
        border-width: Theme.focus-ring-w; border-color: Theme.focus-ring;
    }
}

// ---------------------------------------------------------------------------------------------
// Botão circular de VIDRO (voltar, mais, ajustes, curtir sobre capa): GlassPanel nível 1, sem aninhar blur.
// ---------------------------------------------------------------------------------------------
export component GlassIconButton inherits GlassPanel {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <length> size: Theme.hit;
    callback clicked();
    width: size; height: size; radius: size / 2; level: 1; light-blur: true;
    IconButton {
        x: 0px; y: 0px; size: root.size; icon: root.icon; label: root.label; active: root.active; tint: Theme.ink;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------------------------
// Botão em pílula (48 de altura). primary = neutro invertido (ink sobre Theme.bg; UM por tela); secondary = preenchimento neutro.
// O acento NÃO é cor de botão: aparece só em estado (aba ativa, curtir, foco, interruptor).
// ---------------------------------------------------------------------------------------------
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    callback clicked();
    height: Theme.hit; border-radius: self.height / 2;
    width: row.preferred-width + 40px;
    background: primary ? (ta.pressed ? Theme.ink-2 : Theme.ink) : (ta.pressed ? Theme.fill-2 : Theme.fill);
    accessible-role: button; accessible-label: text;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.dur-micro; }
    row := HorizontalLayout {
        padding-left: 20px; padding-right: 20px; spacing: 8px; alignment: center;
        if root.icon.width > 0 : Image { source: root.icon; width: 20px; height: 20px; y: (root.height - self.height) / 2; colorize: root.primary ? Theme.bg : Theme.ink; }
        Text { text: root.text; font-family: Theme.font-sans; font-size: Theme.fs-callout; font-weight: 600; letter-spacing: Theme.ls-callout; color: root.primary ? Theme.bg : Theme.ink; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false;
        key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } return reject; }
    }
    Rectangle { visible: fs.has-focus; x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; border-radius: self.height / 2; border-width: Theme.focus-ring-w; border-color: Theme.focus-ring; }
}

// ---------------------------------------------------------------------------------------------
// Selo de formato: FLAC | 24/96. `hires` (>= 24 bits) usa o acento.
// ---------------------------------------------------------------------------------------------
export component FormatBadge inherits Rectangle {
    in property <string> codec: "FLAC";
    in property <string> detail: "24/96";
    in property <bool> hires: false;
    in property <color> ink: Theme.ink-2;          // sobre vidro/player: Theme.ink-glass-2 / Theme.im-ink-2
    in property <color> strong-ink: Theme.ink;
    height: 22px; border-radius: 7px;
    border-width: 1px;
    border-color: hires ? Theme.accent.with-alpha(0.7) : Theme.line-strong;
    width: row.preferred-width;
    accessible-role: text;
    accessible-label: codec + " " + detail;
    row := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
        Text { text: root.codec; font-family: Theme.font-mono; font-size: Theme.fs-badge; font-weight: Theme.fw-badge; color: root.hires ? Theme.accent : root.strong-ink; vertical-alignment: center; }
        Rectangle { width: 1px; height: 10px; background: Theme.line-strong; y: (root.height - 10px) / 2 - 1px; }
        Text { text: root.detail; font-family: Theme.font-mono; font-size: Theme.fs-badge; font-weight: Theme.fw-badge; color: root.ink; vertical-alignment: center; }
    }
}

// ---------------------------------------------------------------------------------------------
// Etiqueta de fonte ("Do YouTube Music"): pílula de 28 com ícone `cloud`. Nunca usa a marca de terceiros.
// ---------------------------------------------------------------------------------------------
export component SourceTag inherits Rectangle {
    in property <string> text: "Do YouTube Music";
    height: 28px; border-radius: 14px; background: Theme.fill;
    width: row.preferred-width;
    accessible-role: AccessibleRole.text; accessible-label: text;
    row := HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 6px; alignment: center;
        Image { source: @image-url("../assets/icons/cloud.svg"); width: 16px; height: 16px; y: (root.height - self.height) / 2; colorize: Theme.ink-2; }
        Text { text: root.text; font-family: Theme.font-sans; font-size: Theme.fs-caption; font-weight: 600; color: Theme.ink-2; vertical-alignment: center; }
    }
}

// ---------------------------------------------------------------------------------------------
// Interruptor 52x32 (alvo 64x48 com margem invisível). `locked` = ligado e não editável (Sem telemetria).
// ---------------------------------------------------------------------------------------------
export component KSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> locked: false;
    in property <string> label;
    callback toggled(bool);
    width: 52px; height: 32px; border-radius: 16px;
    background: (checked || locked) ? Theme.accent : Theme.fill-2;
    accessible-role: switch;
    accessible-label: label;
    accessible-checked: checked || locked;
    accessible-enabled: !locked;
    accessible-action-default => { root.flip(); }
    animate background { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    function flip() { if (!locked) { root.checked = !root.checked; root.toggled(root.checked); } }
    Rectangle {
        y: 2px; width: 28px; height: 28px; border-radius: 14px;
        x: (root.checked || root.locked) ? 22px : 2px;
        background: #ffffff;
        drop-shadow-blur: 4px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000040;
        animate x { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    }
    // alvo de toque de 48 (o interruptor tem 32 de altura): 8 px invisíveis acima e abaixo, 6 nas laterais
    TouchArea { x: -6px; y: (parent.height - Theme.hit) / 2; width: parent.width + 12px; height: Theme.hit; enabled: !root.locked; clicked => { root.flip(); } }
    fs := FocusScope { focus-on-click: false;
        enabled: !root.locked;
        key-pressed(e) => { if (e.text == " " || e.text == Key.Return) { root.flip(); return accept; } return reject; }
    }
    Rectangle {
        visible: fs.has-focus;
        x: -Theme.focus-offset; y: -Theme.focus-offset; width: parent.width + 4px; height: parent.height + 4px;
        border-radius: 18px; border-width: Theme.focus-ring-w; border-color: Theme.focus-ring;
    }
}

// ---------------------------------------------------------------------------------------------
// Barra de progresso/volume FINA e arredondada (6 px; 10 com hover/foco/arraste), alvo de 48 px. value 0..1.
// `immersive`: trilho branco 24% e preenchimento branco (player); senão trilho neutro e preenchimento `ink`.
// O polegar só aparece com hover/foco/arraste (Apple Music: barra limpa em repouso).
// ---------------------------------------------------------------------------------------------
export component KSlider inherits Rectangle {
    // `value` é `in`, para a ligação com AppState.progress não ser quebrada pelo arraste; o valor mostrado durante o arraste
    // (e por 300 ms depois, até o motor confirmar) é interno. (Correção herdada do kazzu-app, ver docs/UI_NOTES.md.)
    in property <float> value: 0.0;
    in property <bool> immersive: true;
    in property <bool> accent-fill: false;
    in property <string> label;
    in property <string> value-text;
    in property <bool> enabled: true;
    callback changed(float);     // durante o arraste e por teclado
    callback released(float);    // ao soltar (seek efetivo)

    height: Theme.hit;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value-text;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: 0.05;
    accessible-enabled: enabled;
    opacity: enabled ? 1.0 : 0.45;

    property <bool> dragging: false;
    property <bool> pending: false;
    property <float> held: 0.0;
    property <float> shown: (dragging || pending) ? held : value;
    changed value => { root.pending = false; }
    property <bool> engaged: ta.has-hover || fs.has-focus || ta.pressed;
    property <length> track-h: engaged ? Theme.progress-h-active : Theme.progress-h;
    animate track-h { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    function nudge(delta: float) {
        root.held = clamp(root.shown + delta, 0.0, 1.0);
        root.pending = true; hold.running = true;
        root.changed(root.held); root.released(root.held);
    }
    hold := Timer { interval: 300ms; running: false; triggered => { root.pending = false; self.running = false; } }

    Rectangle { // trilho
        y: (parent.height - self.height) / 2; height: root.track-h; border-radius: self.height / 2;
        background: root.immersive ? Theme.im-track : Theme.fill-2;
        clip: true;
        Rectangle { // preenchimento
            x: 0px; width: parent.width * clamp(root.shown, 0.0, 1.0); height: parent.height; border-radius: parent.border-radius;
            background: root.accent-fill ? Theme.accent : (root.immersive ? Theme.im-ink : Theme.ink);
        }
    }
    Rectangle { // polegar
        visible: root.engaged;
        width: Theme.slider-thumb; height: Theme.slider-thumb; border-radius: Theme.slider-thumb / 2;
        x: parent.width * clamp(root.shown, 0.0, 1.0) - self.width / 2; y: (parent.height - self.height) / 2;
        background: root.immersive ? Theme.im-ink : Theme.ink;
        drop-shadow-blur: Theme.e1-blur; drop-shadow-offset-y: Theme.e1-y; drop-shadow-color: Theme.e1-color;
    }
    // a barra pode ser fina (32, volume do NowBar): a área de toque cresce para 48 de altura, centrada (mouse-x não muda)
    ta := TouchArea {
        y: min(0px, (parent.height - Theme.hit) / 2); height: max(parent.height, Theme.hit);
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragging = true; root.held = clamp(self.mouse-x / root.width, 0.0, 1.0); root.changed(root.held);
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.dragging) {
                    root.dragging = false; root.pending = true; hold.running = true;
                    root.released(root.held);
                }
            }
        }
        moved => { if (self.pressed) { root.held = clamp(self.mouse-x / root.width, 0.0, 1.0); root.changed(root.held); } }
    }
    fs := FocusScope { focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) { root.nudge(0.05); return accept; }
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) { root.nudge(-0.05); return accept; }
            return reject;
        }
    }
    Rectangle {
        visible: fs.has-focus;
        x: -Theme.focus-offset; y: (parent.height - Theme.progress-h-active) / 2 - Theme.focus-offset - 4px;
        width: parent.width + 2 * Theme.focus-offset; height: Theme.progress-h-active + 2 * Theme.focus-offset + 8px;
        border-radius: 12px; border-width: Theme.focus-ring-w; border-color: Theme.focus-ring;
    }
}
