// GERADO por design/tools/gen_tokens.py a partir de design/tokens.json. NÃO edite à mão.
// Uso: `import { Theme } from "tokens.slint";`  ->  `background: Theme.bg;`
// v3 (Apple-like): fundo NEUTRO (preto/grafite no escuro, cinza-sistema no claro), vidro CLARO translúcido sobre conteúdo,
// UM acento discreto. Sem malha de gradiente: `stage-*` e `glass-tint-*/dark|light` da v2 deixaram de existir (ver SLINT_SPEC.md §0).

export global Theme {
    // ---- estado de tema (o kazzu-app escreve) ------------------------------------------------
    in-out property <bool> dark: true;
    in-out property <bool> reduce-motion: false;
    /// largura da janela; o AppWindow atualiza em `changed width`.
    in property <length> window-w: 390px;
    /// classes de janela (Material 3): compact < 600 (celular, base) | medium 600–839 | expanded 840–1199 | wide >= 1200.
    out property <bool> compact: window-w < bp-regular;
    out property <bool> expanded: window-w >= bp-expanded;
    out property <bool> wide: window-w >= bp-wide;
    out property <length> bp-regular: 600px;
    out property <length> bp-expanded: 840px;
    out property <length> bp-wide: 1200px;

    // ---- transparência / blur (Slint 1.19 backdrop-blur: Skia e FemtoVG) --------------------------
    /// preferência do usuário (Configurações > Aparência > Reduzir transparência).
    in-out property <bool> reduce-transparency: false;
    /// o Rust escreve false quando o renderer é o software (sem backdrop-blur).
    in property <bool> blur-supported: true;
    out property <bool> glass-live: blur-supported && !reduce-transparency;

    // ---- acento: UM só, discreto (âmbar da marca). `use-dynamic-accent` (opcional) deriva da capa, ver DESIGN.md §3.4 ----
    in-out property <bool> use-dynamic-accent: false;
    in-out property <color> dynamic-accent: #ffa154;
    in-out property <color> dynamic-accent-ink: #190c04;
    out property <color> accent: use-dynamic-accent ? dynamic-accent : (dark ? #ffa154 : #ab4b01);
    out property <color> accent-ink: use-dynamic-accent ? dynamic-accent-ink : (dark ? #190c04 : #fefbf8);
    out property <color> accent-soft: accent.with-alpha(dark ? 0.18 : 0.14);
    out property <color> focus-ring: accent;

    // ---- paleta neutra (claro/escuro) ------------------------------------------------------------
    out property <color> bg: dark ? #000000 : #f2f2f7;
    out property <color> surface: dark ? #1c1c1e : #ffffff;
    out property <color> surface-2: dark ? #2c2c2e : #ebebf0;
    out property <color> surface-3: dark ? #3a3a3c : #e0e0e6;
    out property <color> ink: dark ? #ffffff : #000000;
    out property <color> ink-2: dark ? #b5b5bb : #505056;
    out property <color> ink-3: dark ? #98989e : #68686e;
    out property <color> ink-disabled: dark ? #636366 : #aeaeb2;
    out property <color> line: dark ? #ffffff1f : #3c3c4333;
    out property <color> line-strong: dark ? #ffffff40 : #3c3c434d;
    out property <color> fill: dark ? #ffffff1f : #78788029;
    out property <color> fill-2: dark ? #ffffff33 : #7878803d;
    out property <color> success: dark ? #32d74b : #1f7a3a;
    out property <color> warning: dark ? #ffd60a : #8a5a00;
    out property <color> danger: dark ? #ff6961 : #c4262b;
    out property <color> glass-tint-1: dark ? #ffffff1a : #ffffff8c;
    out property <color> glass-tint-2: dark ? #ffffff26 : #ffffffa6;
    out property <color> glass-tint-3: dark ? #ffffff33 : #ffffffbf;
    out property <color> glass-shade-1: dark ? #00000052 : #00000000;
    out property <color> glass-shade-2: dark ? #00000066 : #00000000;
    out property <color> glass-shade-3: dark ? #0000007a : #00000000;
    out property <color> glass-solid: dark ? #242426 : #fafafc;
    out property <color> glass-solid-strong: dark ? #2a2a2c : #fcfcfe;
    out property <color> glass-solid-3: dark ? #303033 : #ffffff;
    out property <color> glass-edge: dark ? #ffffff80 : #fffffff2;
    out property <color> glass-edge-low: dark ? #ffffff14 : #0000001a;
    out property <color> glass-sheen: dark ? #ffffff2e : #ffffffb3;
    out property <color> glass-ring: dark ? #ffffff1f : #0000000f;
    out property <color> shadow: dark ? #000000a6 : #00000029;
    out property <color> scrim: dark ? #00000061 : #00000047;
    out property <color> edge-fade: dark ? #000000 : #f2f2f7;
    out property <color> cell: dark ? #1c1c1e : #ffffff;
    out property <color> cell-hover: dark ? #2c2c2e : #ebebf0;
    out property <color> ink-glass-2: dark ? #fffffff5 : #44444a;

    // ---- vidro: 3 materiais. camadas de baixo p/ cima: SOMBREADO neutro (glass-shade) -> TINT claro (glass-tint) -> brilho ->
    //      borda de luz. Com blur ao vivo; sem blur (software / reduzir transparência) vale o sólido `glass-solid*`.
    out property <length> glass-blur-1: glass-live ? 24px : 0px;
    out property <length> glass-blur-2: glass-live ? 32px : 0px;
    out property <length> glass-blur-3: glass-live ? 40px : 0px;
    out property <length> glass-blur-light-radius: glass-live ? 16px : 0px;
    /// fundo do painel por nível: sombreado (ao vivo) ou sólido.
    out property <color> glass-bg-1: glass-live ? glass-shade-1 : glass-solid;
    out property <color> glass-bg-2: glass-live ? glass-shade-2 : glass-solid-strong;
    out property <color> glass-bg-3: glass-live ? glass-shade-3 : glass-solid-3;
    /// opacidade da camada de tint (some no fallback sólido).
    out property <float> glass-tint-on: glass-live ? 1.0 : 0.0;
    out property <length> glass-shadow-blur-1: 24px;
    out property <length> glass-shadow-y-1: 8px;
    out property <length> glass-shadow-blur-2: 32px;
    out property <length> glass-shadow-y-2: 12px;
    out property <length> glass-shadow-blur-3: 56px;
    out property <length> glass-shadow-y-3: 24px;

    // ---- imersivo (player em tela cheia): independe do tema --------------------------------------
    out property <color> im-ink: #ffffff;
    out property <color> im-ink-2: #ffffffcc;
    out property <color> im-ink-3: #ffffffb3;
    out property <color> im-track: #ffffff3d;
    out property <color> im-control-fill: #ffffff29;
    out property <color> im-control-fill-active: #ffffff40;
    out property <color> im-control-edge: #ffffff2e;
    out property <color> im-veil: #00000099;
    out property <color> im-scrim-top: #0000000f;
    out property <color> im-scrim-mid: #00000000;
    out property <color> im-scrim-bottom: #000000b8;
    out property <float> im-base-darken: 0.5;

    // ---- tipografia (Inter; `ff-*` = família do estilo: Inter Display nos títulos) -----------------
    out property <string> font-sans: "Inter";
    out property <string> font-display: "Inter Display";
    out property <string> font-mono: "Geist Mono";
    out property <string> ff-large-title: font-display;
    out property <length> fs-large-title: 34px;
    out property <length> lh-large-title: 41px;
    out property <int> fw-large-title: 700;
    out property <length> ls-large-title: -0.8px;
    out property <string> ff-title-1: font-display;
    out property <length> fs-title-1: 28px;
    out property <length> lh-title-1: 34px;
    out property <int> fw-title-1: 700;
    out property <length> ls-title-1: -0.6px;
    out property <string> ff-title-2: font-display;
    out property <length> fs-title-2: 22px;
    out property <length> lh-title-2: 28px;
    out property <int> fw-title-2: 700;
    out property <length> ls-title-2: -0.45px;
    out property <string> ff-title-3: font-display;
    out property <length> fs-title-3: 20px;
    out property <length> lh-title-3: 25px;
    out property <int> fw-title-3: 600;
    out property <length> ls-title-3: -0.4px;
    out property <string> ff-headline: font-sans;
    out property <length> fs-headline: 17px;
    out property <length> lh-headline: 22px;
    out property <int> fw-headline: 600;
    out property <length> ls-headline: -0.34px;
    out property <string> ff-body: font-sans;
    out property <length> fs-body: 17px;
    out property <length> lh-body: 22px;
    out property <int> fw-body: 400;
    out property <length> ls-body: -0.34px;
    out property <string> ff-callout: font-sans;
    out property <length> fs-callout: 16px;
    out property <length> lh-callout: 21px;
    out property <int> fw-callout: 400;
    out property <length> ls-callout: -0.25px;
    out property <string> ff-subhead: font-sans;
    out property <length> fs-subhead: 15px;
    out property <length> lh-subhead: 20px;
    out property <int> fw-subhead: 400;
    out property <length> ls-subhead: -0.2px;
    out property <string> ff-footnote: font-sans;
    out property <length> fs-footnote: 13px;
    out property <length> lh-footnote: 18px;
    out property <int> fw-footnote: 400;
    out property <length> ls-footnote: -0.08px;
    out property <string> ff-caption: font-sans;
    out property <length> fs-caption: 12px;
    out property <length> lh-caption: 16px;
    out property <int> fw-caption: 500;
    out property <length> ls-caption: 0px;
    out property <string> ff-player-title: font-display;
    out property <length> fs-player-title: 24px;
    out property <length> lh-player-title: 30px;
    out property <int> fw-player-title: 700;
    out property <length> ls-player-title: -0.5px;
    out property <string> ff-player-title-desktop: font-display;
    out property <length> fs-player-title-desktop: 34px;
    out property <length> lh-player-title-desktop: 41px;
    out property <int> fw-player-title-desktop: 700;
    out property <length> ls-player-title-desktop: -0.8px;
    out property <string> ff-timecode: font-mono;
    out property <length> fs-timecode: 13px;
    out property <length> lh-timecode: 16px;
    out property <int> fw-timecode: 500;
    out property <length> ls-timecode: 0px;
    out property <string> ff-badge: font-mono;
    out property <length> fs-badge: 12px;
    out property <length> lh-badge: 14px;
    out property <int> fw-badge: 500;
    out property <length> ls-badge: 0px;

    // ---- espaçamento / raios / tamanhos --------------------------------------------------------
    out property <length> sp-1: 4px;
    out property <length> sp-2: 8px;
    out property <length> sp-3: 12px;
    out property <length> sp-4: 16px;
    out property <length> sp-5: 20px;
    out property <length> sp-6: 24px;
    out property <length> sp-7: 32px;
    out property <length> sp-8: 40px;
    out property <length> sp-9: 56px;
    out property <length> sp-10: 80px;
    out property <length> r-xs: 6px;
    out property <length> r-sm: 10px;
    out property <length> r-md: 14px;
    out property <length> r-lg: 20px;
    out property <length> r-xl: 26px;
    out property <length> r-full: 999px;
    out property <length> hit: 48px;
    out property <length> hit-comfortable: 56px;
    out property <length> icon: 24px;
    out property <length> icon-sm: 20px;
    out property <length> icon-lg: 28px;
    out property <length> row-h: 64px;
    out property <length> row-cover: 52px;
    out property <length> thumb-radius: 10px;
    out property <length> card-radius: 20px;
    out property <length> hero-card-w-mobile: 300px;
    out property <length> hero-card-h-mobile: 380px;
    out property <length> hero-card-w-desktop: 380px;
    out property <length> hero-card-h-desktop: 460px;
    out property <length> dock-h: 64px;
    out property <length> dock-radius: 32px;
    out property <length> dock-search: 56px;
    out property <length> mini-h: 64px;
    out property <length> mini-radius: 24px;
    out property <length> sidebar-w: 248px;
    out property <length> sidebar-w-compact: 80px;
    out property <length> gutter-mobile: 16px;
    out property <length> gutter-desktop: 32px;
    out property <length> content-max: 1180px;
    out property <length> player-cover-mobile: 358px;
    out property <length> player-cover-desktop: 440px;
    out property <length> player-cover-radius: 22px;
    out property <length> play-main: 72px;
    out property <length> play-main-desktop: 68px;
    out property <length> progress-h: 6px;
    out property <length> progress-h-active: 10px;
    out property <length> slider-thumb: 18px;
    out property <length> focus-ring-w: 2px;
    out property <length> focus-offset: 2px;
    out property <length> hit-min: 44px;
    out property <length> dock-margin: 12px;
    out property <length> topbar-h: 56px;
    out property <length> sheet-radius: 28px;
    out property <length> grabber-w: 36px;
    out property <length> grabber-h: 4px;
    out property <length> rail-w: 88px;
    out property <length> rail-w-wide: 248px;
    out property <length> nowbar-h: 76px;
    out property <length> chip-h: 40px;
    out property <length> field-h: 56px;
    out property <length> badge-h: 24px;
    out property <length> collection-gap: 12px;
    out property <length> group-radius: 20px;
    out property <length> tile-radius: 14px;
    out property <length> hero-radius: 26px;
    out property <length> header-h: 56px;
    out property <length> scroll-edge-h: 112px;
    out property <length> row-inset: 80px;
    out property <length> hero-plate-radius: 18px;

    // ---- elevação (drop-shadow-blur / -offset-y; a cor é `shadow` × strength) ------------------
    out property <length> e1-blur: 8px;
    out property <length> e1-y: 2px;
    out property <color> e1-color: shadow.with-alpha(dark ? 0.25 : 0.40);
    out property <length> e2-blur: 24px;
    out property <length> e2-y: 8px;
    out property <color> e2-color: shadow.with-alpha(dark ? 0.35 : 0.56);
    out property <length> e3-blur: 48px;
    out property <length> e3-y: 20px;
    out property <color> e3-color: shadow.with-alpha(dark ? 0.45 : 0.72);

    // ---- movimento (reduzir movimento zera as durações) ----------------------------------------
    out property <duration> dur-micro: reduce-motion ? 0ms : 120ms;
    out property <duration> dur-short: reduce-motion ? 0ms : 200ms;
    out property <duration> dur-medium: reduce-motion ? 0ms : 320ms;
    out property <duration> dur-long: reduce-motion ? 0ms : 480ms;
    // ease-out: cubic-bezier(0.22, 0.9, 0.28, 1.0)  (Slint exige literal em `easing:`; copie daqui)
    // ease-in: cubic-bezier(0.5, 0.0, 0.9, 0.4)  (Slint exige literal em `easing:`; copie daqui)
    // ease-in-out: cubic-bezier(0.45, 0.0, 0.2, 1.0)  (Slint exige literal em `easing:`; copie daqui)
}
