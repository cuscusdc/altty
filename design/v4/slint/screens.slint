            HorizontalLayout { padding-left: Theme.s-lg; padding-right: Theme.s-lg; SearchField { plain: true; text: "Estrada"; placeholder: "Nome da playlist"; fill: Theme.ink.with-alpha(0.10); } }
            Text { x: Theme.s-lg; width: parent.width - 2 * Theme.s-lg; height: 34px; text: "Fica guardada neste aparelho."; color: Theme.ink; font-size: Theme.text-sm; vertical-alignment: center; }
