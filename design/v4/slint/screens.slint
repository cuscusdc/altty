    height: 28px;
    Text { x: Theme.gutter + Theme.s-md; text: root.text; color: Theme.ink-2; font-size: Theme.text-md; font-weight: 600; }
}

component SegItem inherits Rectangle {
    in property <string> title;
    in property <[string]> options;
    in property <int> current;
    in property <bool> separator: true;
    height: 104px;
    if root.separator : Rectangle { y: 0; height: 1px; background: Theme.rule; }
    Text { x: Theme.s-md; y: Theme.s-sm; text: root.title; color: Theme.ink; font-size: Theme.text-lg; }
    Segmented { x: Theme.s-md; y: 44px; width: parent.width - 2 * Theme.s-md; options: root.options; current: root.current; }
}

export component SettingsScreen inherits Rectangle {
    in property <length> scroll: 0px;
    in property <length> safe-top: 0px;
    in property <length> reserve: 160px;
    callback back();
    Flickable {
        content-y: -root.scroll;
        VerticalLayout {
            padding-top: root.safe-top + Theme.s-xs;
            padding-bottom: root.reserve;
            spacing: Theme.s-xl;
            alignment: start;
            VerticalLayout { RootHeader { logo: false; back: true; gear: false; back-clicked => { root.back(); } } LargeTitle { text: "Ajustes"; } }
            VerticalLayout {
                GroupHead { text: "Reprodução"; }
                HorizontalLayout {
                    padding-left: Theme.gutter;
                    padding-right: Theme.gutter;
                    Group {
                        SegItem { separator: false; title: "Qualidade do streaming"; options: ["Original", "Alta", "Econômica"]; current: 0; }
                        GroupItem { title: "Continuar com músicas parecidas"; note: "Quando a fila acabar."; VerticalLayout { alignment: center; Switch { checked: true; label: "Continuar com músicas parecidas"; } } }
                    }
                }
            }
            VerticalLayout {
                GroupHead { text: "Aparência"; }
                HorizontalLayout {
                    padding-left: Theme.gutter;
                    padding-right: Theme.gutter;
                    Group {
                        SegItem { separator: false; title: "Tema"; options: ["Automático", "Claro", "Escuro"]; current: Theme.dark ? 2 : 1; }
                        GroupItem { title: "Reduzir transparência"; note: "Troca o vidro por superfícies sólidas."; VerticalLayout { alignment: center; Switch { checked <=> Theme.reduce-transparency; label: "Reduzir transparência"; } } }
                        GroupItem { title: "Reduzir movimento"; note: "Tira os deslocamentos das transições."; VerticalLayout { alignment: center; Switch { checked <=> Theme.reduce-motion; label: "Reduzir movimento"; } } }
                    }
                }
            }
            VerticalLayout {
                GroupHead { text: "Fontes de música"; }
                HorizontalLayout {
                    padding-left: Theme.gutter;
                    padding-right: Theme.gutter;
                    Group {
                        GroupItem { separator: false; has-icon: true; icon: Icons.badge-check; title: "YouTube Music"; note: "Sem conta."; value: "Ligado"; }
                        GroupItem { title: "Spotify"; value: "Em breve"; }
                        GroupItem { title: "Tidal"; value: "Em breve"; }
                        GroupItem { title: "Qobuz"; value: "Em breve"; }
                    }
                }
            }
            VerticalLayout {
                GroupHead { text: "Privacidade"; }
                HorizontalLayout {
                    padding-left: Theme.gutter;
                    padding-right: Theme.gutter;
                    Group {
                        GroupItem { separator: false; has-icon: true; icon: Icons.shield; title: "Sem telemetria"; note: "O Kazzu não coleta nada. Não há conta."; }
                        GroupItem { has-icon: true; icon: Icons.trash; title: "Apagar histórico"; note: "Buscas e reprodução deste aparelho."; chevron: true; }
                        GroupItem { has-icon: true; icon: Icons.info; title: "Relatar um problema"; note: "Gera um arquivo aqui. Você decide se envia."; chevron: true; }
                    }
                }
            }
        }
    }
}
