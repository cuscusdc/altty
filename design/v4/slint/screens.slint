                Rectangle { height: 17px; Rectangle { x: Theme.s-sm; width: parent.width - 2 * Theme.s-sm; height: 1px; background: Theme.ink.with-alpha(0.14); } }
                SheetAction { icon: Icons.disc; text: "Ir para o álbum"; }
                SheetAction { icon: Icons.user; text: "Ir para o artista"; }
                Rectangle { height: 17px; Rectangle { x: Theme.s-sm; width: parent.width - 2 * Theme.s-sm; height: 1px; background: Theme.ink.with-alpha(0.14); } }
                SheetAction { icon: Icons.lyrics; text: "Ver a letra"; soon: true; }
                SheetAction { icon: Icons.timer; text: "Timer para dormir"; soon: true; }
                SheetAction { icon: Icons.download; text: "Baixar"; soon: true; }
            }
        }
    }
}

