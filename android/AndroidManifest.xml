<?xml version="1.0" encoding="utf-8"?>
<!--
  Kazzu para Android. Sem código Java próprio: a Activity é a NativeActivity do sistema, que carrega
  libkazzu_app.so (ponto de entrada `android_main`, ver crates/kazzu-app/src/android.rs).
  Permissões: só o necessário (ver docs/ANDROID.md). Nenhum serviço do Google, nenhuma telemetria.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.kazzu.player">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Rede: YouTube Music (provedor padrão, sem conta) e as capas dos itens vistos; só na abertura do Início e por ação do usuário. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ler as músicas da pasta Music: Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- ... e Android 8 a 12 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Kazzu"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:label="Kazzu"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation|locale|layoutDirection|fontScale|colorMode">
            <meta-data android:name="android.app.lib_name" android:value="kazzu_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
