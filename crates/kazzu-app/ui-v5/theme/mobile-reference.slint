export global MobilePalette {
    out property <color> paper: #0d0c0b;
    out property <color> ink: #f5f3ee;
    out property <color> cream: #fbf8e6;
    out property <color> pink: #ff7fa8;
    out property <color> border: #ffffff24;
    out property <color> glass: #ffffff14;
    out property <color> island: #24211f;
    out property <color> queue: #28291d;
    out property <color> player-island: #23241a;
    out property <color> player-scrim: #14140ebf;
    out property <brush> player-cover: @radial-gradient(circle, #fff7ce 0%, #ecd98a 50%, #b8a95e 100%);
    out property <color> dark: #282619;
    out property <brush> player: @linear-gradient(180deg, #d8d387 0%, #b8b375 25%, #76744f 60%, #444330 100%);
    out property <brush> cover: @linear-gradient(145deg, #fff7cf, #ead98a, #b8a95e);
    out property <[color]> art-light: [#ffe066, #6b6b6b, #3a3a3a, #d62828, #f5d6a0, #9ecbff];
    out property <[color]> art-dark: [#ff9f1c, #1d1d1d, #000000, #6a040f, #c77d3b, #2b5d8f];
}
