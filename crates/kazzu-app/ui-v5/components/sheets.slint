// Folhas (v4): Fila, menu da faixa, "Adicionar à playlist" e "Nova playlist". Vidro de folha (`Glass sheet`), presas à base,
// com véu atrás. Dentro do vidro todo texto é `Theme.ink` (o que passa atrás muda); o item ativo é uma bolha opaca.
import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState, Tab, LyricsState } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Glass, Pressable, Icon, IconButton, TextButton, Button, Cover, Mosaic, Tag, Scrubber, TrackRow, SearchField } from "atoms.slint";

// Véu + moldura: sobe da base (`appear`), com alça de 36 × 5. Com Reduzir movimento só esmaece.
component SheetBase inherits Rectangle {
    in property <bool> side-panel: false;
    in property <string> title;
    in property <length> body-h;            // altura total da folha (sem o ajuste da área segura)
    callback close();
    property <float> appear: 0;
    init => { root.appear = 1; }
    animate appear { duration: Theme.dur-long; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
    Rectangle { background: Theme.media-scrim; opacity: root.appear; accessible-role: none; TouchArea { clicked => { root.close(); } } }
    panel := Glass {
        x: Theme.wide && root.side-panel ? parent.width - self.width - Theme.s-md : (parent.width - self.width) / 2;
        width: min(parent.width, Theme.wide && root.side-panel ? 460px : 552px);
        height: min(root.body-h, parent.height - AppState.safe-top - Theme.s-md);
        y: max(AppState.safe-top, (Theme.wide ? (parent.height - self.height) / 2 : parent.height - self.height)) + (Theme.reduce-motion ? 0px : (1 - root.appear) * 64px);
        opacity: root.appear;
        sheet: true;
        flat-bottom: !Theme.wide;
        accessible-role: groupbox;
        accessible-label: root.title;

        TouchArea {}
        Flickable {
            width: parent.width; height: parent.height;
            content-width: self.width;
            content-height: max(self.height, root.body-h);
            interactive: self.content-height > self.height;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.content-height; @children }
        }
    }
}

component SheetHeader inherits Rectangle {
    in property <string> title;
    in property <string> action;
    callback action-clicked();
    callback close();
    height: 76px;
    Text { x: Theme.s-lg; y: 22px; height: 48px; width: parent.width - 2 * Theme.s-lg - 56px - (root.action != "" ? 96px : 0px); text: root.title; color: Theme.ink; font-family: Theme.font-display; font-size: Theme.text-xl; font-weight: 700; letter-spacing: -0.44px; vertical-alignment: center; overflow: elide; accessible-role: AccessibleRole.text; }
    if root.action != "" : TextButton { x: parent.width - 56px - 96px; y: 22px; width: 96px; text: root.action; ink: Theme.ink; clicked => { root.action-clicked(); } }
    IconButton { x: parent.width - 56px; y: 22px; icon: Icons.close; label: "Fechar"; clicked => { root.close(); } }
}

component SheetAction inherits Pressable {
    in property <image> icon;
    in property <string> text;
    in property <bool> soon: false;
    height: 52px;
    enabled: !soon;
    ring-radius: Theme.r-group;
    label: soon ? text + ", em breve" : text;
    Rectangle { border-radius: Theme.r-group; background: root.pressed || root.hovered ? Theme.ink.with-alpha(0.10) : transparent; }
    HorizontalLayout {
        padding-left: Theme.s-sm;
        padding-right: Theme.s-sm;
        spacing: Theme.s-md;
        Icon { source: root.icon; opacity: root.soon ? 0.6 : 1; }
        Text { text: root.text; color: Theme.ink; font-size: Theme.text-lg; vertical-alignment: center; horizontal-stretch: 1; opacity: root.soon ? 0.6 : 1; overflow: elide; accessible-role: none; }
        if root.soon : VerticalLayout { alignment: center; Tag { text: "Em breve"; } }
    }
}

component SheetRule inherits Rectangle {
    height: 17px;
    Rectangle { x: Theme.s-sm; width: parent.width - 2 * Theme.s-sm; height: 1px; background: Theme.ink.with-alpha(0.14); }
}

// ------------------------------------------------------------------------------------------------ Fila
export component QueueSheet inherits SheetBase {
    side-panel: true;
    title: "Fila";
    body-h: self.height - AppState.safe-top - Theme.s-xxxl;
    property <bool> confirm-clear: false;
    property <bool> empty: AppState.queue.length == 0;
    close => { AppState.queue-open = false; }
    VerticalLayout {
        padding-bottom: AppState.safe-bottom + Theme.s-lg;
        alignment: start;
        SheetHeader { title: "Fila"; action: root.empty ? "" : "Limpar"; action-clicked => { root.confirm-clear = true; } close => { AppState.queue-open = false; } }
        if root.confirm-clear && !root.empty : VerticalLayout {
            padding-left: Theme.s-md; padding-right: Theme.s-md;
            Text { text: "Parar a reprodução e limpar a fila?"; color: Theme.ink; wrap: word-wrap; }
            HorizontalLayout {
                Button { text: "Cancelar"; clicked => { root.confirm-clear = false; } }
                Button { text: "Parar e limpar"; clicked => { root.confirm-clear = false; AppState.queue-clear(); } }
            }
        }
        if AppState.has-now : VerticalLayout {
            padding-left: Theme.s-md; padding-right: Theme.s-md;
            Text { text: "Tocando agora"; color: Theme.ink-2; font-size: Theme.text-sm; }
            TrackRow { t: AppState.now; more: false; on-glass: true; clicked => { root.close(); Nav.open-player(); } }
        }
        HorizontalLayout {
            padding-left: Theme.s-md; height: 48px;
            Text { text: root.empty ? "Nenhuma faixa a seguir" : "A seguir"; color: Theme.ink; vertical-alignment: center; font-weight: 600; }
        }
        if !root.empty : ListView {
            vertical-stretch: 1;
            for t[i] in AppState.queue : HorizontalLayout {
                height: Theme.row-h;
                padding-left: Theme.s-lg;
                TrackRow {
                    t: t;
                    separator: i > 0;
                    more: false;
                    on-glass: true;
                    line: Theme.ink.with-alpha(0.14);
                    clicked => { AppState.queue-jump(t.id); }
                    VerticalLayout { alignment: center; if i > 0 : IconButton { icon: Icons.arrow-up; label: "Mover " + t.title + " para cima"; clicked => { AppState.queue-move-up(t.id); } } if i == 0 : Rectangle { width: 48px; } }
                    VerticalLayout { alignment: center; IconButton { icon: Icons.close; label: "Tirar " + t.title + " da fila"; clicked => { AppState.queue-remove(t.id); } } }
                }
                Rectangle { width: Theme.s-xs; }
            }
        }
        if !root.empty && (AppState.queue-more-label != "" || AppState.queue-note != "") : VerticalLayout {
            padding-left: Theme.s-lg;
            padding-right: Theme.s-lg;
            padding-top: Theme.s-sm;
            spacing: Theme.s-xxs;
            if AppState.queue-more-label != "" : Text { text: AppState.queue-more-label; color: Theme.ink; font-size: Theme.text-sm; wrap: word-wrap; accessible-role: AccessibleRole.text; }
            if AppState.queue-note != "" : Text { text: AppState.queue-note; color: Theme.ink; font-size: Theme.text-sm; wrap: word-wrap; accessible-role: AccessibleRole.text; }
        }
    }
}

// ------------------------------------------------------------------------------------------------ Menu da faixa
export component MenuSheet inherits SheetBase {
    title: "Ações da música";
    body-h: 96px + 6 * 52px + 17px + Theme.s-lg + AppState.safe-bottom;
    close => { AppState.menu-open = false; }
    VerticalLayout {
        padding-bottom: AppState.safe-bottom + Theme.s-lg;
        alignment: start;
        Rectangle {
            height: 96px;
            HorizontalLayout {
                y: 24px;
                height: 64px;
                padding-left: Theme.s-lg;
                padding-right: Theme.s-xs;
                spacing: Theme.s-sm;
                VerticalLayout { alignment: center; Cover { source: AppState.menu-track.cover; } }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: AppState.menu-track.title; color: Theme.ink; font-size: Theme.text-lg; font-weight: 600; overflow: elide; accessible-role: AccessibleRole.text; }
                    Text { text: AppState.menu-track.artist; color: Theme.ink; font-size: Theme.text-md; overflow: elide; accessible-role: AccessibleRole.text; }
                }
                VerticalLayout { alignment: center; IconButton { icon: Icons.close; label: "Fechar"; clicked => { AppState.menu-open = false; } } }
            }
        }
        VerticalLayout {
            padding-left: Theme.s-sm;
            padding-right: Theme.s-sm;
            SheetAction { icon: Icons.next; text: "Tocar em seguida"; clicked => { AppState.play-next(AppState.menu-track.id); AppState.menu-open = false; } }
            SheetAction { icon: Icons.queue; text: "Adicionar à fila"; clicked => { AppState.enqueue(AppState.menu-track.id); AppState.menu-open = false; } }
            SheetAction { icon: Icons.playlist-add; text: "Adicionar à playlist"; clicked => { AppState.playlist-sheet-track = AppState.menu-track.id; AppState.menu-open = false; AppState.playlist-sheet-open = true; } }
            SheetAction { icon: AppState.menu-track.liked ? Icons.heart-fill : Icons.heart; text: AppState.menu-track.liked ? "Descurtir" : "Curtir"; clicked => { AppState.toggle-like(AppState.menu-track.id); AppState.menu-open = false; } }
            SheetRule { }
            SheetAction { icon: Icons.disc; text: "Ir para o álbum"; clicked => { AppState.goto-album(AppState.menu-track.id); AppState.menu-open = false; if (AppState.player-open) { Nav.close-player(); } } }
            SheetAction { icon: Icons.user; text: "Ir para o artista"; clicked => { AppState.goto-artist(AppState.menu-track.id); AppState.menu-open = false; if (AppState.player-open) { Nav.close-player(); } } }

        }
    }
}

// ------------------------------------------------------------------------------------------------ Adicionar à playlist
export component PlaylistSheet inherits SheetBase {
    title: "Adicionar à playlist";
    property <length> list-h: min(AppState.playlists.length * 64px, 280px);
    body-h: 76px + 52px + Theme.s-xs + list-h + Theme.s-lg + AppState.safe-bottom;
    close => { AppState.playlist-sheet-open = false; }
    VerticalLayout {
        padding-bottom: AppState.safe-bottom + Theme.s-lg;
        alignment: start;
        SheetHeader { title: "Adicionar à playlist"; close => { AppState.playlist-sheet-open = false; } }
        VerticalLayout {
            padding-left: Theme.s-sm;
            padding-right: Theme.s-sm;
            SheetAction { icon: Icons.plus; text: "Nova playlist"; clicked => { AppState.new-playlist-track = AppState.playlist-sheet-track; AppState.playlist-sheet-open = false; AppState.new-playlist-open = true; } }
            Rectangle { height: Theme.s-xs; }
            ListView {
                height: root.list-h;
                for p in AppState.playlists : Pressable {
                    height: 64px;
                    ring-radius: Theme.r-group;
                    label: p.name + ", " + p.count-label;
                    clicked => { AppState.add-to-playlist(AppState.playlist-sheet-track, p.id); AppState.playlist-sheet-open = false; }
                    Rectangle { border-radius: Theme.r-group; background: parent.pressed || parent.hovered ? Theme.ink.with-alpha(0.10) : transparent; }
                    HorizontalLayout {
                        padding-left: Theme.s-sm;
                        spacing: Theme.s-sm;
                        VerticalLayout { alignment: center; Mosaic { width: 48px; height: 48px; radius: Theme.r-thumb; sources: p.covers; } }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: p.name; color: Theme.ink; font-size: Theme.text-lg; overflow: elide; accessible-role: none; }
                            Text { text: p.count-label; color: Theme.ink; font-size: Theme.text-sm; overflow: elide; accessible-role: none; }
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------------------------------------ Nova playlist
export component NewPlaylistSheet inherits SheetBase {
    title: "Nova playlist";
    // celular: com o campo em foco o teclado ocupa a base; a folha sobe ~40% da janela (>= 600 não muda nada)
    body-h: 76px + 28px + 48px + 34px + 48px + Theme.s-xl + AppState.safe-bottom;
    property <string> suggestion: "Minha playlist";
    close => { AppState.new-playlist-open = false; }
    function create() {
        AppState.create-playlist-named(field.text != "" ? field.text : root.suggestion, AppState.new-playlist-track);
        AppState.new-playlist-open = false;
    }
    VerticalLayout {
        padding-bottom: AppState.safe-bottom + Theme.s-lg;
        alignment: start;
        SheetHeader { title: "Nova playlist"; close => { AppState.new-playlist-open = false; } }
        Text { x: Theme.s-lg; width: parent.width - 2 * Theme.s-lg; height: 28px; text: "Nome da playlist"; color: Theme.ink; font-size: Theme.text-md; font-weight: 600; accessible-role: AccessibleRole.text; }
        HorizontalLayout {
            padding-left: Theme.s-lg;
            padding-right: Theme.s-lg;
            field := SearchField {
                plain: true;
                text: root.suggestion;
                placeholder: "Nome da playlist";
                fill: Theme.ink.with-alpha(0.10);
                accepted(t) => { root.create(); }
                init => { self.focus-input(); self.select-input(); }
            }
        }
        Text { x: Theme.s-lg; width: parent.width - 2 * Theme.s-lg; height: 34px; text: "Fica guardada neste aparelho."; color: Theme.ink; font-size: Theme.text-sm; vertical-alignment: center; accessible-role: AccessibleRole.text; }
        HorizontalLayout {
            padding-left: Theme.s-lg;
            padding-right: Theme.s-lg;
            spacing: Theme.s-sm;
            Button { text: "Cancelar"; horizontal-stretch: 1; clicked => { AppState.new-playlist-open = false; } }
            Button { text: "Criar playlist"; primary: true; horizontal-stretch: 1; clicked => { root.create(); } }
        }
    }
}

export component AccountSheet inherits SheetBase {
    title: "Importar coleções";
    body-h: 432px;
    property <bool> spotify: true;
    close => { AppState.account-open = false; }

    VerticalLayout {
        padding: 16px; spacing: 8px;
        alignment: start;
        SheetHeader { title: root.title; close => { root.close(); } }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Spotify"; primary: root.spotify; clicked => { token.text = ""; root.spotify = true; } }
            Button { text: "YouTube"; primary: !root.spotify; clicked => { token.text = ""; root.spotify = false; } }
        }
        Text {
            text: root.spotify ? "Importe playlists e músicas salvas com um token OAuth de leitura. As faixas abrem no Spotify." : "Importe suas playlists pela API do YouTube com um token OAuth youtube.readonly. A reprodução no YouTube Music continua como visitante.";
            color: Theme.ink-2; font-size: Theme.text-md; wrap: word-wrap;
        }
        if AppState.import-status != "" : Text { text: AppState.import-status; wrap: word-wrap; font-size: Theme.text-sm; color: Theme.ink; accessible-live-region: polite; }
        if AppState.services.youtube-login && !AppState.services.manage-session : Button { text: "Entrar no YouTube Music"; clicked => { AppState.begin-youtube-login(); } }
        if AppState.services.manage-session : TextButton { text: "Sair de " + AppState.session-label; clicked => { AppState.end-session(); } }
        token := SearchField { plain: true; secret: true; placeholder: "Token de acesso OAuth"; }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Importar"; primary: true; enabled: !AppState.import-pending && token.text != "";
                clicked => {
                    AppState.import-account(root.spotify ? "spotify" : "youtube", token.text);
                    token.text = "";
                }
            }
            TextButton { text: "Usar sem conta"; clicked => { token.text = ""; root.close(); } }
        }
    }
}

export component FolderSheet inherits SheetBase {
    title: "Adicionar pasta";
    body-h: AppState.mobile ? 492px : 310px;
    close => { AppState.folder-open = false; }
    function browse(directory: string) {
        AppState.folder-current = "";
        AppState.folder-list-error = "";
        AppState.folder-listing-pending = true;
        AppState.browse-folders(directory);
    }
    init => {
        if (AppState.mobile) {
            AppState.folder-current = "";
            AppState.folder-parent = "";
            root.browse("");
        }
    }

    VerticalLayout {
        padding: 16px; spacing: 8px;
        alignment: start;
        SheetHeader { title: root.title; close => { root.close(); } }
        Text { text: "Selecione uma pasta ou informe seu caminho completo. A indexação inclui subpastas."; color: Theme.ink-2; font-size: Theme.text-md; wrap: word-wrap; }
        path := SearchField { plain: true; placeholder: "Caminho completo da pasta"; }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Adicionar"; primary: true;
                enabled: path.text != "" || (AppState.mobile && AppState.folder-current != "" && !AppState.folder-listing-pending);
                clicked => { AppState.add-named-folder(path.text != "" ? path.text : AppState.folder-current); root.close(); }
            }
            TextButton { text: AppState.mobile ? "Pasta Música" : "Procurar…"; clicked => { root.close(); AppState.add-folder(); } }
        }
        if AppState.mobile : VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                IconButton { icon: Icons.arrow-up; label: "Pasta acima"; enabled: AppState.folder-parent != "" && !AppState.folder-listing-pending; clicked => { root.browse(AppState.folder-parent); } }
                Text { text: AppState.folder-listing-pending ? "Carregando…" : AppState.folder-current; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            }
            if AppState.folder-list-error != "" : VerticalLayout {
                Text { text: AppState.folder-list-error; color: Theme.ink-2; wrap: word-wrap; }
                TextButton { text: "Voltar ao armazenamento"; clicked => { root.browse(""); } }
            }
            if !AppState.folder-listing-pending && AppState.folder-list-error == "" : ListView {
                vertical-stretch: 1;
                for dir in AppState.folder-children : SheetAction {
                    icon: Icons.folder;
                    text: dir.name;
                    clicked => { path.text = ""; root.browse(dir.path); }
                }
            }
        }
    }
}


export component AudioInfoSheet inherits SheetBase {
    title: "Informações de reprodução";
    body-h: 344px + AppState.safe-bottom;
    close => { AppState.audio-info-open = false; }
    VerticalLayout {
        alignment: start; spacing: Theme.s-sm;
        SheetHeader { title: root.title; close => { root.close(); } }
        VerticalLayout {
            padding-left: Theme.s-lg; padding-right: Theme.s-lg; spacing: Theme.s-xs;
            Text { text: AppState.now.title; color: Theme.ink; font-weight: 700; overflow: elide; }
            Text { text: AppState.now-source-line != "" ? AppState.now-source-line : AppState.now-source; color: Theme.ink-2; wrap: word-wrap; }
            Text { text: AppState.output-name; color: Theme.ink; wrap: word-wrap; }
            if AppState.now.detail-long != "" : Text { text: AppState.now.detail-long; color: Theme.ink; wrap: word-wrap; }
            Scrubber { value: AppState.volume; media: false; label: "Volume"; value-text: Math.round(AppState.volume * 100) + "%"; seek(v) => { AppState.set-volume(v); } }
            Text { text: AppState.output-note; color: Theme.ink-2; wrap: word-wrap; }
        }
    }
}

export component EditPlaylistSheet inherits SheetBase {
    title: "Editar playlist";
    body-h: min(640px, root.height - AppState.safe-top);
    close => { AppState.edit-playlist-open = false; }
    property <bool> confirm-delete;
    VerticalLayout {
        padding: Theme.s-md; padding-bottom: Theme.s-md + AppState.safe-bottom; spacing: Theme.s-xs;
        SheetHeader { title: root.title; close => { root.close(); } }
        name := SearchField { plain: true; placeholder: "Nome da playlist"; init => { self.text = AppState.detail-title; } }
        HorizontalLayout {
            spacing: Theme.s-xs;
            Button { text: "Renomear"; enabled: name.text != "" && name.text != AppState.detail-title; clicked => { AppState.rename-playlist(name.text); } }
            TextButton { text: root.confirm-delete ? "Confirmar exclusão" : "Excluir playlist"; clicked => {
                if (root.confirm-delete) { root.close(); AppState.delete-playlist(); } else { root.confirm-delete = true; }
            } }
        }
        if root.confirm-delete : TextButton { text: "Cancelar exclusão"; clicked => { root.confirm-delete = false; } }
        ListView {
            for t[i] in AppState.detail-tracks : HorizontalLayout {
                height: Theme.row-h;
                Text { text: t.title; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                IconButton { icon: Icons.arrow-up; enabled: i > 0; label: "Subir " + t.title; clicked => { AppState.move-playlist-entry-up(i, t.id); } }
                IconButton { icon: Icons.close; label: "Remover " + t.title; clicked => { AppState.remove-playlist-entry(i, t.id); } }
            }
        }
    }
}

export component LyricsSheet inherits SheetBase {
    title: "Letra";
    body-h: min(root.height - AppState.safe-top, 660px);
    close => { AppState.mobile-lyrics-open = false; }
    property <string> track-id: AppState.now.id;
    init => { AppState.request-lyrics(root.track-id); }
    changed track-id => { AppState.request-lyrics(root.track-id); }
    VerticalLayout {
        padding: Theme.s-md;
        SheetHeader { title: root.title; close => { root.close(); } }
        if AppState.lyrics-state == LyricsState.ready : ListView {
            for line[i] in AppState.lyrics-lines : HorizontalLayout {
                spacing: Theme.s-sm;
                if line.time-label != "" : Text { text: line.time-label; color: Theme.ink-2; font-size: Theme.text-sm; }
                Text { text: line.text; color: i == AppState.lyrics-active-line ? Theme.accent : Theme.ink; font-size: Theme.text-xl; font-weight: i == AppState.lyrics-active-line ? 700 : 500; wrap: word-wrap; horizontal-stretch: 1; }
            }
        }
        if AppState.lyrics-state != LyricsState.ready : Text { text: AppState.lyrics-state == LyricsState.loading ? "Buscando letra…" : AppState.lyrics-state == LyricsState.failed ? AppState.lyrics-error : "Letra indisponível para esta faixa."; color: Theme.ink; wrap: word-wrap; }
        if AppState.lyrics-state == LyricsState.failed : Button { text: "Tentar novamente"; clicked => { AppState.request-lyrics(root.track-id); } }
    }
}
