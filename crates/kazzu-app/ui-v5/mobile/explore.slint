import { ExploreFeed } from "../components/explore-feed.slint";
import { Theme } from "../theme/tokens.slint";
import { Tab } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Icons } from "../theme/icons.slint";
import { IconButton } from "../components/atoms.slint";
export component MobileExplore inherits ExploreFeed {
    HorizontalLayout { padding-left: Theme.gutter; padding-right: Theme.gutter;
        Text { text: "Explorar"; color: Theme.ink; font-family: Theme.font-display; font-size: 32px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
        IconButton { icon: Icons.gear; label: "Ajustes"; clicked => { Nav.go(Tab.settings); } }
    }
}
