// Medidas de layout que não existem em tokens.slint (gerado) e a rolagem de cada tela. Nada aqui chama o Rust.
import { Theme } from "tokens.slint";
import { AppState, Tab } from "app-contract.slint";

export global Metrics {
    /// largura da barra lateral do desktop (>= 1100): sólida, `paper-2`
    out property <length> sidebar-w: 264px;
    /// barra de reprodução do desktop (vidro)
    out property <length> nowbar-h: 72px;
    /// largura máxima da doca (celular e tablet)
    out property <length> dock-max-w: 520px;
    /// altura que a doca ocupa (mini-player + cápsula + folga + área segura); as telas somam mais 16 de respiro
    out property <length> dock-reserve: (AppState.has-now ? Theme.mini-h + Theme.s-xs : 0px) + Theme.bar-h + Theme.s-sm + AppState.safe-bottom + Theme.s-md;
    /// recuo inferior do conteúdo: a doca (celular, tablet) ou a barra de reprodução (desktop)
    out property <length> reserve: (Theme.wide ? (AppState.has-now ? nowbar-h + Theme.s-md + Theme.s-xl : Theme.s-xl) + AppState.safe-bottom : dock-reserve + Theme.s-md);
    /// onde o aviso (toast) apoia: o topo da doca ou da barra de reprodução
    out property <length> chrome-top: Theme.wide ? (AppState.has-now ? nowbar-h + Theme.s-md : Theme.s-md) + AppState.safe-bottom : dock-reserve - Theme.s-md;

    // Rolagem por tela (cada aba guarda a sua; tocar na aba ativa volta ao topo). Telas gravam em `changed content-y`.
    in-out property <length> scroll-home: 0px;
    in-out property <length> scroll-explore: 0px;
    in-out property <length> scroll-library: 0px;
    in-out property <length> scroll-search: 0px;
    in-out property <length> scroll-settings: 0px;
    in-out property <length> scroll-detail: 0px;
    /// incrementa quando o usuário toca na aba ativa: a tela volta ao topo
    in-out property <int> scroll-top-seq: 0;
    public pure function saved-scroll(tab: Tab) -> length {
        return tab == Tab.home ? scroll-home : tab == Tab.explore ? scroll-explore : tab == Tab.library ? scroll-library : tab == Tab.search ? scroll-search : scroll-settings;
    }
    public function save-scroll(tab: Tab, y: length) {
        if (tab == Tab.home) { scroll-home = y; }
        else if (tab == Tab.explore) { scroll-explore = y; }
        else if (tab == Tab.library) { scroll-library = y; }
        else if (tab == Tab.search) { scroll-search = y; }
        else { scroll-settings = y; }
    }
    public function reset-scroll(tab: Tab) { save-scroll(tab, 0px); scroll-top-seq += 1; }
}
