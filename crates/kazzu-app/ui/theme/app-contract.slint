// Contrato entre a UI (Slint) e o kazzu-app (Rust), v5 (0.6.0).
// A UI só LÊ estas propriedades e CHAMA estes callbacks.
// Nomes em inglês (código); textos visíveis em pt-BR vêm prontos do Rust.

export enum Tab { home, explore, library, search, settings }
export enum RepeatMode { off, all, one }
export enum SearchState { idle, results, empty, loading, error, offline }
export enum ThemeMode { auto, light, dark, oled }
export enum DetailKind { tracks, albums, artist }
export enum LoadState { loading, ready, empty, error, offline }

export struct Track {
    id: string,
    title: string,
    artist: string,
    album: string,
    cover: image,
    duration-label: string,
    codec: string,
    detail: string,
    detail-long: string,
    hires: bool,
    source: string,
    liked: bool,
    playing: bool,
    why: string,
}

export struct Album { id: string, title: string, artist: string, cover: image }
export struct Highlight { id: string, kind: string, caption: string, title: string, subtitle: string, cover: image, tint: color }
export struct Artist { id: string, name: string, subtitle: string, cover: image }
export struct Playlist { id: string, name: string, count-label: string, covers: [image] }
export struct Collection { id: string, title: string, count-label: string, covers: [image], soon: bool }
export struct OutputDevice { id: string, name: string, active: bool }
export struct FolderChoice { name: string, path: string }
export struct ProviderRow { id: string, name: string, status-label: string, connected: bool, available: bool }

export enum LyricsState { unavailable, loading, ready, empty, failed }
export struct LyricsLine { text: string, time-label: string }
export struct OptionalServices {
    youtube-login: bool,
    manage-session: bool,
    lyrics: bool,
    audio-devices: bool,
    equalizer: bool,
    sleep-timer: bool,
    downloads: bool,
}

export global AppState {
    in property <bool> mobile: false;
    in-out property <Tab> tab: Tab.home;
    in-out property <bool> player-open: false;
    in-out property <bool> queue-open: false;
    in-out property <bool> account-open: false;
    in-out property <bool> folder-open: false;
    in-out property <bool> mobile-lyrics-open: false;
    in-out property <bool> menu-open: false;
    in-out property <Track> menu-track;
    in-out property <bool> playlist-sheet-open: false;
    in-out property <string> playlist-sheet-track: "";
    in-out property <bool> new-playlist-open: false;
    in-out property <string> new-playlist-track: "";
    callback navigate(Tab);
    callback open-player();
    callback close-player();

    in-out property <length> safe-top: 0px;
    in-out property <length> safe-bottom: 0px;
    in-out property <length> safe-left: 0px;
    in-out property <length> safe-right: 0px;
    in property <OptionalServices> services;
    in property <LyricsState> lyrics-state;
    in property <[LyricsLine]> lyrics-lines;
    in property <int> lyrics-active-line: -1;
    in property <string> lyrics-error;
    in property <string> session-label;
    callback request-lyrics(string);
    callback begin-youtube-login();
    callback end-session();
    in property <bool> catalog-available;
    in property <bool> online: true;

    in property <Track> now;
    in property <bool> has-now: false;
    in property <bool> playing: false;
    in property <float> progress: 0.0;
    in property <string> position-label: "0:00";
    in property <string> remaining-label: "−0:00";
    in property <float> volume: 1.0;
    in property <bool> shuffle: false;
    in property <RepeatMode> repeat: RepeatMode.off;
    in property <string> output-name: "Padrão do sistema";
    in property <string> output-note: "";
    in property <bool> bit-perfect: true;
    in property <string> now-origin: "";
    in property <string> now-source: "";
    in property <string> quality-label: "";
    in property  now-art;
    in property  backdrop;
    in property  backdrop-wide;
    in property <float> player-dim: 0.64;
    in property <float> mini-dim: 0.7;
    in property <string> now-source-line: "";
    in property <bool> player-loading: false;
    in property <string> player-error: "";
    in property <string> player-error-action: "Tentar de novo";
    in property <string> sleep-timer-label: "Timer";
    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback seek-relative(int);
    callback set-volume(float);
    callback volume-step(int);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-like(string);
    callback play-track(string);
    callback retry-track();
    in property <bool> can-seek: false;
    in-out property <bool> audio-info-open: false;
    callback open-lyrics();
    callback open-output-picker();
    callback set-sleep-timer(int);

    in property <LoadState> home-state: LoadState.loading;
    in property <bool> home-stale: false;
    in property <string> home-error-title: "";
    in property <string> home-error-text: "";
    in property <string> source-label: "";
    in property <bool> first-run-banner: false;
    in property <[Highlight]> highlights;
    in property <[Track]> quick-picks;
    in property <[Highlight]> mixes;
    in property <[Album]> albums;
    in property <[Track]> recents;
    callback dismiss-first-run-banner();
    callback retry-home();
    callback play-random-shortcut();
    callback mobile-feature(string);
    callback open-item(string, string);
    callback play-item(string, string);

    in property <LoadState> explore-state: LoadState.loading;
    in property <string> explore-error-text: "";
    in property <[Album]> new-releases;
    in property <[Highlight]> moods;
    in property <[Track]> trending;
    callback retry-explore();

    in-out property <int> library-view: 0;
    in-out property <int> library-density: 1;
    in-out property <bool> library-descending;
    callback library-order-changed(bool);
    in-out property <int> library-category: 0;
    callback library-layout-changed(int, int);

    in property <[Collection]> collections;
    in property <[Album]> library-albums;
    in property <[Artist]> library-artists;
    in property <[Playlist]> playlists;
    in property <bool> has-library: false;
    in property <bool> scanning: false;
    in property <float> scan-progress: 0.0;
    in property <string> scan-label: "";
    in property <[string]> folders;
    in property <string> listening-summary: "";
    in property <string> library-summary: "";
    in property <bool> loading: true;
    callback open-collection(string);
    callback open-album(string);
    callback open-playlist(string);
    callback create-playlist-named(string, string);
    callback add-to-playlist(string, string);
    callback add-folder();
    callback add-named-folder(string);
    callback browse-folders(string);
    in-out property <bool> folder-listing-pending: false;
    in-out property <string> folder-current: "";
    in-out property <string> folder-parent: "";
    in-out property <string> folder-list-error: "";
    in property <[FolderChoice]> folder-children;
    callback import-account(string, string);
    callback remove-folder(string);
    callback rescan();

    in-out property <bool> detail-open: false;
    in property <DetailKind> detail-kind: DetailKind.tracks;
    in property <LoadState> detail-state: LoadState.ready;
    in property <string> detail-description;
    in property <[Highlight]> detail-related;
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property  detail-cover;
    in property <string> detail-source: "";
    in property <string> detail-empty-text: "";
    in property <string> detail-error-text: "";
    in property <bool> detail-saved: false;
    in property <bool> detail-can-save: false;
    in property <bool> detail-can-play: true;
    in property <[Track]> detail-tracks;
    in property <[Album]> detail-albums;
    callback close-detail();
    callback retry-detail();
    callback play-all();
    callback shuffle-all();
    callback toggle-detail-saved();

    in-out property <string> search-text: "";
    in-out property <int> search-kind: 0;
    in property <SearchState> search-state: SearchState.idle;
    in property <string> search-empty-text: "";
    in property <string> search-error-text: "";
    in property <[string]> recent-searches;
    in property <[string]> search-suggestions;
    in property <bool> search-has-best: false;
    in property <Highlight> search-best;
    in property <[Track]> search-songs;
    in property <[Album]> search-albums;
    in property <[Artist]> search-artists;
    in property <[Highlight]> search-playlists;
    callback search(string);
    callback search-kind-changed(int);
    in-out property <int> search-source: 0;
    callback search-source-changed(int);
    callback remove-recent-search(string);
    callback clear-recent-searches();
    callback recognize-ambient();

    in property <[Track]> queue;
    in property <string> queue-summary: "";
    in property <string> queue-more-label: "";
    in property <string> queue-note: "";
    callback queue-remove(string);
    callback queue-jump(string);
    callback queue-move-up(string);
    in-out property <string> focus-return;
    callback remember-focus(string);
    callback queue-clear();
    in property <string> editable-playlist;
    in-out property <bool> edit-playlist-open;
    in property <bool> import-pending;
    in property <string> import-status;
    callback rename-playlist(string);
    callback delete-playlist();
    callback remove-playlist-entry(int, string);
    callback move-playlist-entry-up(int, string);

    callback play-next(string);
    callback enqueue(string);
    callback download-track(string);
    callback goto-album(string);
    callback goto-artist(string);

    in property <string> toast-text: "";
    in property <bool> toast-error: false;
    in property <string> toast-action-label: "";
    in property <int> toast-seq: 0;
    callback toast-action();
    callback dismiss-toast();

    in-out property <int> settings-section: 0;
    in-out property <string> settings-query;
    in-out property <int> glass-style: 1;
    in-out property <bool> artwork-background: true;
    in-out property <int> color-palette: 0;
    callback palette-changed(int);
    callback visual-style-changed(int, bool);
    pure callback settings-match(string, string) -> bool;

    in-out property <ThemeMode> theme-mode: ThemeMode.dark;
    in-out property <int> stream-quality: 0;
    in-out property <bool> autoplay-radio: true;
    in property <bool> perf-offer: false;
    in property <[ProviderRow]> providers;
    in property <[OutputDevice]> outputs;
    in property <string> version-label: "Kazzu 0.6.0";
    in property <string> licenses-text: "";
    callback theme-mode-changed(ThemeMode);
    callback stream-quality-changed(int);
    callback autoplay-radio-changed(bool);
    callback reduce-transparency-changed(bool);
    callback reduce-motion-changed(bool);
    callback perf-offer-accept();
    callback perf-offer-dismiss();
    callback clear-history();
    callback report-problem();
    callback connect-provider(string);
}
