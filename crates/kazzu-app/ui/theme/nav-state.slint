// Navegação: as telas, o AppWindow e o Esc/Voltar do Android passam todos por aqui. O estado de tela vive no Slint;
// o Rust só escuta os callbacks (`navigate`, `close-player`, `close-detail`...).
import { Tab, AppState, Track } from "app-contract.slint";
import { Metrics } from "metrics.slint";

export global Nav {
    property <Tab> mobile-settings-origin: Tab.home;
    /// Vai a uma aba. Na aba ativa: volta ao topo (e fecha um detalhe aberto).
    public function go(t: Tab) {
        if (AppState.mobile && t == Tab.settings && AppState.tab != Tab.settings) {
            mobile-settings-origin = AppState.tab;
        }
        if (AppState.detail-open) { AppState.detail-open = false; AppState.close-detail(); }
        if (AppState.tab == t) { Metrics.reset-scroll(t); }
        else { AppState.tab = t; AppState.navigate(t); }
    }
    public function collection(id: string) {
        if (id == "playlists") { AppState.library-category = 1; go(Tab.library); }
        else { AppState.open-collection(id); }
    }
    public function open-player() { AppState.player-open = true; AppState.open-player(); }
    public function close-player() { AppState.mobile-lyrics-open = false; AppState.player-open = false; AppState.close-player(); }
    /// Abre o menu de ações de uma faixa (linha de lista, player, barra de reprodução).
    public function open-menu(t: Track) { AppState.menu-track = t; AppState.menu-open = true; }
    public function close-detail() { AppState.detail-open = false; AppState.close-detail(); }
    public function close-menus() {
        AppState.menu-open = false; AppState.playlist-sheet-open = false; AppState.new-playlist-open = false;
    }
    /// Voltar (Esc, botão Voltar do Android). Devolve false quando já está no Início sem nada aberto.
    public function back() -> bool {
        if (AppState.folder-open) { AppState.folder-open = false; return true; }
        if (AppState.account-open) { AppState.account-open = false; return true; }
        if (AppState.new-playlist-open) { AppState.new-playlist-open = false; return true; }
        if (AppState.playlist-sheet-open) { AppState.playlist-sheet-open = false; return true; }
        if (AppState.menu-open) { AppState.menu-open = false; return true; }
        if (AppState.mobile-lyrics-open) { AppState.mobile-lyrics-open = false; return true; }
        if (AppState.queue-open) { AppState.queue-open = false; return true; }
        if (AppState.player-open) { close-player(); return true; }
        if (AppState.detail-open) { close-detail(); return true; }
        if (AppState.mobile && AppState.tab == Tab.settings) { go(mobile-settings-origin); return true; }
        if (AppState.tab == Tab.search && AppState.search-text != "") { AppState.search-text = ""; AppState.search(""); return true; }
        if (AppState.tab != Tab.home) { AppState.tab = Tab.home; AppState.navigate(Tab.home); return true; }
        return false;
    }
}
