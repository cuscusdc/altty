// Barra lateral do desktop: marca, destinos, playlists e Ajustes no rodapé (um único botão).
// Colapsa para 72 px, no espírito do BitChord Desktop, sem esconder nenhum destino.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Playlist, Tab } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Pressable, Icon, IconButton, Cover } from "../components/atoms.slint";

component SideItem inherits Pressable {
    in property <string> text;
    in property <image> icon;
    in property <image> icon-on;
    in property <bool> on;
    in property <bool> collapsed: false;
    accessible-role: tab;
    accessible-item-selected: on;
    label: text;
    height: 48px;
    ring-radius: Theme.r-group;
    Rectangle {
        border-radius: Theme.r-group;
        background: root.on ? Theme.accent.with-alpha(0.14) : root.hovered ? Theme.paper-3 : transparent;
        animate background { duration: Theme.dur-micro; }
    }
    HorizontalLayout {
        padding-left: root.collapsed ? 0px : Theme.s-sm;
        spacing: Theme.s-sm;
        alignment: root.collapsed ? center : start;
        VerticalLayout { alignment: center; Icon { source: root.on ? root.icon-on : root.icon; tint: root.on ? Theme.accent : Theme.ink-2; } }
        if !root.collapsed : Text { text: root.text; color: root.on ? Theme.accent : Theme.ink; font-size: Theme.text-lg; font-weight: root.on ? 600 : 400; vertical-alignment: center; overflow: elide; }
    }
}

export component DesktopSidebar inherits Rectangle {
    in property <bool> collapsed: false;
    in property <bool> can-expand: true;
    in property <int> tab: 0;
    in property <[Playlist]> playlists;
    in property <length> safe-top: 0px;
    callback go(int);
    callback open-playlist(string);
    callback toggle-collapsed();
    background: Theme.paper-2;
    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.rule; }
    if !root.collapsed : Image {
        x: 20px;
        y: root.safe-top + 22px;
        width: 104px;
        height: 28px;
        source: Theme.dark ? @image-url("../assets/kazzu-wordmark-dark.svg") : @image-url("../assets/kazzu-wordmark-light.svg");
        accessible-role: AccessibleRole.text;
        accessible-label: "Kazzu";
    }
    if root.collapsed : Image {
        x: (parent.width - 28px) / 2;
        y: root.safe-top + 22px;
        width: 28px;
        height: 28px;
        source: Theme.dark ? @image-url("../assets/kazzu-mark-dark.svg") : @image-url("../assets/kazzu-mark-light.svg");
        accessible-role: AccessibleRole.text;
        accessible-label: "Kazzu";
    }
    if root.can-expand : IconButton {
        x: root.collapsed ? (parent.width - 48px) / 2 : parent.width - 44px;
        y: root.collapsed ? root.safe-top + 58px : root.safe-top + 12px;
        icon: root.collapsed ? Icons.chevron-right : Icons.chevron-left;
        tint: Theme.muted;
        label: root.collapsed ? "Expandir a barra lateral" : "Recolher a barra lateral";
        clicked => { root.toggle-collapsed(); }
    }
    VerticalLayout {
        x: 12px;
        y: root.safe-top + (root.collapsed && root.can-expand ? 114px : 74px);
        width: parent.width - 24px;
        spacing: 4px;
        SideItem { text: "Início"; icon: Icons.home; icon-on: Icons.home-fill; on: root.tab == 0; collapsed: root.collapsed; clicked => { root.go(0); } }
        SideItem { text: "Biblioteca"; icon: Icons.library; icon-on: Icons.library-fill; on: root.tab == 1; collapsed: root.collapsed; clicked => { root.go(1); } }
        SideItem { text: "Buscar"; icon: Icons.search; icon-on: Icons.search; on: root.tab == 2; collapsed: root.collapsed; clicked => { root.go(2); } }
    }
    if !root.collapsed : Text {
        x: 24px;
        y: root.safe-top + 238px;
        text: "SUAS PLAYLISTS";
        color: Theme.muted;
        font-size: Theme.text-xs;
        letter-spacing: 1.2px;
        font-weight: 600;
    }
    if !root.collapsed : Flickable {
        x: 12px;
        y: root.safe-top + 266px;
        width: parent.width - 24px;
        height: max(0px, parent.height - self.y - 76px);
        interactive: true;
        VerticalLayout {
            alignment: start;
            spacing: 2px;
            if root.playlists.length == 0 : Text {
                height: 48px;
                text: "Nenhuma playlist ainda";
                color: Theme.ink-2;
                font-size: Theme.text-sm;
                vertical-alignment: center;
            }
            for p in root.playlists : Pressable {
                height: 52px;
                ring-radius: Theme.r-group;
                label: "Playlist " + p.name;
                clicked => { root.open-playlist(p.id); }
                Rectangle { border-radius: Theme.r-group; background: parent.hovered ? Theme.paper-3 : transparent; }
                HorizontalLayout {
                    padding-left: Theme.s-xs;
                    spacing: Theme.s-sm;
                    VerticalLayout { alignment: center; Cover { source: p.covers[0]; size: 36px; radius: Theme.r-thumb; } }
                    Text { text: p.name; color: Theme.ink-2; font-size: Theme.text-md; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
    }
    settings := Pressable {
        x: 12px;
        y: parent.height - 60px;
        width: parent.width - 24px;
        height: 48px;
        ring-radius: Theme.r-group;
        label: "Ajustes";
        clicked => { Nav.go(Tab.settings); }
        Rectangle { border-radius: Theme.r-group; background: parent.hovered ? Theme.paper-3 : transparent; }
        HorizontalLayout {
            padding-left: root.collapsed ? 0px : Theme.s-sm;
            spacing: Theme.s-sm;
            alignment: root.collapsed ? center : start;
            VerticalLayout { alignment: center; Icon { source: Icons.gear; tint: Theme.ink-2; } }
            if !root.collapsed : Text { text: "Ajustes"; color: Theme.ink; font-size: Theme.text-md; vertical-alignment: center; }
        }
    }
}
