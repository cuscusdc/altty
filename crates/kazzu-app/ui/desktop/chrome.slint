// Barra de reprodução para janelas desktop estreitas.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Track } from "../theme/app-contract.slint";
import { Glass, Pressable, IconButton, Cover } from "../components/atoms.slint";

export component DesktopCompactBar inherits Rectangle {
    in property <Track> now;
    in property <image> now-tint;
    in property <float> now-dim: 0.7;
    in property <bool> playing: false;
    in property <float> progress: 0;
    in property <length> safe-bottom: 0px;
    callback open-player();
    callback toggle-play();
    callback next();
    property <color> now-ink: Theme.glass-on ? Theme.media-ink : Theme.ink;
    property <length> inner-w: min(root.width - 2 * Theme.s-md, 520px);
    property <length> capsule-h: 64px;
    height: root.capsule-h + root.safe-bottom + Theme.s-sm + Theme.s-xl;
    bar := Glass {
        x: (root.width - root.inner-w) / 2;
        y: root.height - root.safe-bottom - Theme.s-sm - root.capsule-h;
        width: root.inner-w;
        height: root.capsule-h;
        radius: 28px;
        if Theme.glass-on : Image { source: root.now-tint; width: 100%; height: 61px; image-fit: ImageFit.cover; opacity: 0.55; }
        if Theme.glass-on : Rectangle { y: 0; height: 61px; background: Theme.media-console.with-alpha(root.now-dim); }
        Rectangle {
            y: 4px;
            height: 60px;
            opener := Pressable {
                x: 4px;
                width: parent.width - 108px;
                height: 60px;
                ring-radius: 28px;
                ring-color: root.now-ink;
                label: "Tocando: " + root.now.title + ", de " + root.now.artist + ". Abrir o player";
                clicked => { root.open-player(); }
            }
            Cover { x: 12px; y: 8px; source: root.now.cover; size: 44px; }
            Text { x: 68px; y: 11px; width: parent.width - 68px - 108px; text: root.now.title; color: root.now-ink; font-size: Theme.text-md; font-weight: 600; overflow: elide; }
            Text { x: 68px; y: 31px; width: parent.width - 68px - 108px; text: root.now.artist; color: root.now-ink; font-size: Theme.text-sm; overflow: elide; }
            IconButton { x: parent.width - 100px; y: 6px; icon: root.playing ? Icons.pause : Icons.play; tint: root.now-ink; media: Theme.glass-on; ring-color: root.now-ink; label: root.playing ? "Pausar" : "Tocar"; clicked => { root.toggle-play(); } }
            IconButton { x: parent.width - 52px; y: 6px; icon: Icons.next; tint: root.now-ink; media: Theme.glass-on; ring-color: root.now-ink; label: "Próxima"; clicked => { root.next(); } }
            Rectangle { x: 12px; y: parent.height - 2px; width: (parent.width - 24px) * root.progress; height: 2px; border-radius: 1px; background: root.now-ink; }
        }
    }
}
