// Ajustes (v4): grupos sólidos com linhas de 56+. "Sem telemetria" é uma constante (nenhum controle). Recursos que ainda não
// existem aparecem como "Em breve", sem interruptor falso.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab, ThemeMode } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Pressable, Button, TextButton, IconButton, Switch, Segmented, Tag, Group, GroupItem, SearchField, Scrubber } from "../components/atoms.slint";
import { SettingsGroupHead, SettingsChoice } from "../components/settings-controls.slint";
import { PageHeading } from "../components/editorial.slint";
import { Screen, Gutters, Narrow } from "../components/shared.slint";

export component DesktopSettings inherits Rectangle {
    in-out property <int> section <=> AppState.settings-section;
    in-out property <string> query <=> AppState.settings-query;
    property <[string]> categories: ["Geral", "Reprodução", "Aparência", "Fontes e biblioteca", "Privacidade", "Atalhos", "Sobre"];
    property <[string]> keywords: [
        "geral biblioteca visualização grade lista tamanho capas organização densidade pequenas médias grandes",
        "reprodução audio som qualidade streaming original alta econômica volume fila automático radio aleatorio repetir saída equalizador crossfade normalização continuar músicas parecidas processamento",
        "aparência tema claro escuro automático acabamento vidro glass suave equilibrado cristal transparência reduzir movimento animação capa fundo atmosfera",
        "fontes biblioteca local pasta musica youtube spotify provedor serviços downloads offline adicionar remover procurar músicas novo",
        "privacidade histórico buscas dados sem telemetria diagnóstico relatar problema apagar reprodução aparelho",
        "atalhos teclado espaço tocar reproduzir pausar anterior próxima volume voltar escape esc setas avançar segundos ajustar",
        "sobre versão licença licenças software livre gpl créditos"
    ];
    function choose(i: int) {
        if (i >= 0) { root.query = ""; }
        root.section = i;
        Metrics.scroll-settings = 0px;
        Metrics.scroll-top-seq += 1;
    }
    function matches(i: int, words: string) -> bool {
        return (root.section == -1 || root.section == i || root.query != "") && AppState.settings-match(root.query, words);
    }
    property <bool> confirm-clear: false;
    property <bool> show-licenses: false;
    clear-timer := Timer { interval: 4s; running: root.confirm-clear; triggered => { root.confirm-clear = false; } }
    if root.width >= 900px : Flickable {
        x: 20px; y: AppState.safe-top + 24px; width: 172px; height: parent.height - self.y - Metrics.reserve;
        content-height: max(self.height, categories.preferred-height);
        categories := VerticalLayout { height: self.preferred-height; alignment: start; spacing: 6px;
            Text { text: "PREFERÊNCIAS"; color: Theme.muted; font-size: Theme.text-xs; font-weight: 600; height: 32px; }
            for name[i] in root.categories : Pressable {
                height: 48px; label: name; ring-radius: 16px;
                clicked => { root.choose(i); }
                Rectangle { border-radius: 16px; background: root.section == i ? Theme.accent.with-alpha(0.15) : parent.hovered ? Theme.paper-3 : transparent; }
                Text { x: 12px; text: name; color: root.section == i ? Theme.accent : Theme.ink; font-size: Theme.text-md; vertical-alignment: center; }
            }
            TextButton { text: "Ver tudo"; clicked => { root.choose(-1); } }
        }
    }
    Screen {
        x: root.width >= 900px ? 204px : 0px;
        width: root.width - self.x;
        tab: Tab.settings;
        VerticalLayout {
            padding-top: AppState.safe-top + Theme.s-xl;
            padding-bottom: Metrics.reserve;
            spacing: Theme.s-xl;
            alignment: start;
            VerticalLayout { PageHeading { eyebrow: "FEITO PARA VOCÊ"; title: "Ajustes"; subtitle: "Seu som, sua biblioteca, suas preferências."; } }
            Gutters { SearchField { text <=> root.query; placeholder: "Encontrar uma configuração"; edited(t) => { root.choose(-1); } } }
            if root.width < 900px : Flickable {
                height: 48px; content-width: tabs.preferred-width; content-height: 48px;
                tabs := HorizontalLayout { width: self.preferred-width; spacing: 8px; padding-left: Theme.gutter; padding-right: Theme.gutter;
                    TextButton { min-width: 48px; text: "Tudo"; ink: root.section == -1 ? Theme.accent : Theme.ink; clicked => { root.choose(-1); } }
                    for name[i] in root.categories : TextButton { min-width: 48px; text: name; ink: root.section == i ? Theme.accent : Theme.ink; clicked => { root.choose(i); } }
                }
            }
            Narrow {
                VerticalLayout {
                    spacing: Theme.s-xl;
                    if root.matches(0, root.keywords[0]) : VerticalLayout {
                        SettingsGroupHead { text: "Geral"; }
                        Gutters { Group {
                            SettingsChoice { separator: false; title: "Visualização da biblioteca"; options: ["Grade", "Lista"]; current: AppState.library-view; changed(i) => { AppState.library-view = i; AppState.library-layout-changed(i, AppState.library-density); } }
                            SettingsChoice { title: "Tamanho das capas"; options: ["Pequenas", "Médias", "Grandes"]; current: AppState.library-density; changed(i) => { AppState.library-density = i; AppState.library-layout-changed(AppState.library-view, i); } }
                        } }
                    }
                    if root.matches(1, root.keywords[1]) : VerticalLayout {
                        SettingsGroupHead { text: "Reprodução"; }
                        Gutters {
                            Group {
                                SettingsChoice { separator: false; title: "Qualidade do streaming"; options: ["Original", "Alta", "Econômica"]; current: AppState.stream-quality; changed(i) => { AppState.stream-quality = i; AppState.stream-quality-changed(i); } }
                                GroupItem { title: "Volume"; note: Math.round(AppState.volume * 100) + "%";
                                    VerticalLayout { alignment: center; Scrubber { width: 100px; media: false; value: AppState.volume; label: "Volume"; seek(v) => { AppState.set-volume(v); } } }
                                }
                                GroupItem { title: "Processamento de áudio"; note: "Equalizador, crossfade e normalização ainda não estão disponíveis no motor do Kazzu."; }
                                GroupItem {
                                    title: "Continuar com músicas parecidas";
                                    note: "Quando a fila acabar.";
                                    VerticalLayout { alignment: center; Switch { checked <=> AppState.autoplay-radio; label: "Continuar com músicas parecidas"; toggled(v) => { AppState.autoplay-radio-changed(v); } } }
                                }
                            }
                        }
                    }
                    if root.matches(2, root.keywords[2]) : VerticalLayout {
                        SettingsGroupHead { text: "Aparência"; }
                        Gutters {
                            Group {
                                SettingsChoice {
                                    separator: false;
                                    title: "Tema";
                                    options: ["Automático", "Claro", "Escuro"];
                                    current: AppState.theme-mode == ThemeMode.auto ? 0 : AppState.theme-mode == ThemeMode.light ? 1 : 2;
                                    changed(i) => { AppState.theme-mode = i == 0 ? ThemeMode.auto : i == 1 ? ThemeMode.light : ThemeMode.dark; AppState.theme-mode-changed(AppState.theme-mode); }
                                }
                                SettingsChoice { title: "Acabamento do vidro"; options: ["Suave", "Equilibrado", "Cristal"]; current: AppState.glass-style; changed(i) => { AppState.glass-style = i; AppState.visual-style-changed(i, AppState.artwork-background); } }
                                GroupItem { title: "Atmosfera da capa"; note: "Usa a arte da música como fundo das telas.";
                                    VerticalLayout { alignment: center; Switch { checked <=> AppState.artwork-background; label: "Atmosfera da capa"; toggled(v) => { AppState.visual-style-changed(AppState.glass-style, v); } } }
                                }
                                GroupItem {
                                    title: "Reduzir transparência";
                                    note: "Troca o vidro por superfícies sólidas.";
                                    VerticalLayout { alignment: center; Switch { checked <=> Theme.reduce-transparency; label: "Reduzir transparência"; toggled(v) => { AppState.reduce-transparency-changed(v); } } }
                                }
                                GroupItem {
                                    title: "Reduzir movimento";
                                    note: "Tira os deslocamentos das transições.";
                                    VerticalLayout { alignment: center; Switch { checked <=> Theme.reduce-motion; label: "Reduzir movimento"; toggled(v) => { AppState.reduce-motion-changed(v); } } }
                                }
                            }
                        }
                    }
                    if root.matches(3, root.keywords[3]) : VerticalLayout {
                        SettingsGroupHead { text: "Fontes de música"; }
                        Gutters {
                            Group {
                                for p in AppState.providers : GroupItem { separator: false; has-icon: true; icon: Icons.cloud; title: p.name; note: p.status-label; value: p.connected ? "Conectado" : p.available ? "Disponível" : "Em breve"; }
                                for f in AppState.folders : GroupItem {
                                    title: f;
                                    VerticalLayout { alignment: center; IconButton { icon: Icons.trash; label: "Remover a pasta " + f; clicked => { AppState.remove-folder(f); } } }
                                }
                                Pressable {
                                    height: 56px;
                                    ring-radius: Theme.r-group;
                                    label: "Adicionar pasta";
                                    clicked => { AppState.add-folder(); }
                                    GroupItem { has-icon: true; icon: Icons.plus; title: "Adicionar pasta"; chevron: true; }
                                }
                                if AppState.folders.length > 0 : Pressable {
                                    height: 56px;
                                    enabled: !AppState.scanning;
                                    ring-radius: Theme.r-group;
                                    label: "Procurar músicas de novo";
                                    clicked => { AppState.rescan(); }
                                    GroupItem { has-icon: true; icon: Icons.refresh; title: "Procurar músicas de novo"; note: AppState.scanning ? AppState.scan-label : ""; dimmed: AppState.scanning; chevron: true; }
                                }
                            }
                        }
                    }
                    if root.matches(4, root.keywords[4]) : VerticalLayout {
                        SettingsGroupHead { text: "Privacidade"; }
                        Gutters {
                            Group {
                                GroupItem { separator: false; has-icon: true; icon: Icons.shield; title: "Sem telemetria"; note: "O Kazzu não coleta nada. Não há conta."; }
                                Pressable {
                                    height: 72px;
                                    ring-radius: Theme.r-group;
                                    label: root.confirm-clear ? "Confirmar: apagar o histórico" : "Apagar histórico";
                                    clicked => { if (root.confirm-clear) { root.confirm-clear = false; AppState.clear-history(); } else { root.confirm-clear = true; } }
                                    GroupItem { has-icon: true; icon: Icons.trash; title: root.confirm-clear ? "Toque de novo para apagar" : "Apagar histórico"; note: root.confirm-clear ? "Não dá para desfazer." : "Buscas e reprodução deste aparelho."; chevron: !root.confirm-clear; }
                                }
                                Pressable {
                                    height: 72px;
                                    ring-radius: Theme.r-group;
                                    label: "Relatar um problema";
                                    clicked => { AppState.report-problem(); }
                                    GroupItem { has-icon: true; icon: Icons.info; title: "Relatar um problema"; note: "Gera um arquivo aqui. Você decide se envia."; chevron: true; }
                                }
                            }
                        }
                    }
                    if root.matches(5, root.keywords[5]) : VerticalLayout {
                        SettingsGroupHead { text: "Atalhos de teclado"; }
                        Gutters { Group {
                            GroupItem { separator: false; title: "Reproduzir / pausar"; value: "Espaço"; }
                            GroupItem { title: "Avançar / voltar 5 segundos"; value: "← / →"; }
                            GroupItem { title: "Ajustar volume"; value: "↑ / ↓"; }
                            GroupItem { title: "Abrir ou fechar o player"; value: "F"; }
                            GroupItem { title: "Ir para a busca"; value: "Ctrl+F / Ctrl+K"; }
                            GroupItem { title: "Ir para Início / Biblioteca / Busca"; value: "Ctrl+1 / 2 / 3"; }
                            GroupItem { title: "Abrir Ajustes"; value: "Ctrl+,"; }
                            GroupItem { title: "Fechar ou voltar"; value: "Esc"; }
                        } }
                    }
                    if root.matches(6, root.keywords[6]) : VerticalLayout {
                        SettingsGroupHead { text: "Sobre"; }
                        Gutters {
                            Group {
                                GroupItem { separator: false; has-icon: true; icon: Icons.info; title: AppState.version-label; note: "Licença GPL-3.0. Software livre."; VerticalLayout { alignment: center; TextButton { text: root.show-licenses ? "Ocultar" : "Licenças"; ink: Theme.ink; width: 96px; clicked => { root.show-licenses = !root.show-licenses; } } } }
                                if root.show-licenses : Rectangle {
                                    height: lic.preferred-height + 2 * Theme.s-md;
                                    lic := Text { x: Theme.s-md; y: Theme.s-md; width: parent.width - 2 * Theme.s-md; text: AppState.licenses-text != "" ? AppState.licenses-text : "Licenças de terceiros: veja o arquivo LICENSE do projeto."; color: Theme.ink-2; font-size: Theme.text-sm; wrap: word-wrap; accessible-role: AccessibleRole.text; }
                                }
                            }
                        }
                    }
                    if root.query != "" && !root.matches(0, root.keywords[0]) && !root.matches(1, root.keywords[1]) && !root.matches(2, root.keywords[2]) && !root.matches(3, root.keywords[3]) && !root.matches(4, root.keywords[4]) && !root.matches(5, root.keywords[5]) && !root.matches(6, root.keywords[6]) : Gutters {
                        Group { GroupItem { separator: false; title: "Nenhuma configuração encontrada"; note: "Tente tema, qualidade, biblioteca ou atalhos."; } }
                    }
                }
            }
        }
    }
}
