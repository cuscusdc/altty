// Folhas (v4): Fila, menu da faixa, "Adicionar à playlist" e "Nova playlist". Vidro de folha (`Glass sheet`), presas à base,
// com véu atrás. Dentro do vidro todo texto é `Theme.ink` (o que passa atrás muda); o item ativo é uma bolha opaca.
import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState, Tab } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Glass, Pressable, Icon, IconButton, TextButton, Button, Cover, Mosaic, Tag, TrackRow, SearchField } from "atoms.slint";

// Véu + moldura: sobe da base (`appear`), com alça de 36 × 5. Com Reduzir movimento só esmaece.
component SheetBase inherits Rectangle {
    in property <string> title;
    in property <length> body-h;            // altura total da folha (sem o ajuste da área segura)
    in property <length> lift: 0px;         // sobe a folha (teclado sobre o campo de nome)
    callback close();
    property <float> appear: 0;
    init => { root.appear = 1; }
    animate appear { duration: Theme.dur-long; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
    property <length> shown-lift: root.lift;
    animate shown-lift { duration: Theme.dur-short; }
    Rectangle { background: Theme.media-scrim; opacity: root.appear; accessible-role: none; TouchArea { clicked => { root.close(); } } }
    panel := Glass {
        x: (parent.width - self.width) / 2;
        width: min(parent.width, 552px);
        height: min(root.body-h, parent.height - AppState.safe-top - Theme.s-md);
        y: parent.height - self.height - root.shown-lift + (Theme.reduce-motion ? 0px : (1 - root.appear) * 96px);
        opacity: root.appear;
        sheet: true;
        flat-bottom: true;
        accessible-role: groupbox;
        accessible-label: root.title;
        Rectangle { y: 8px; width: 36px; height: 5px; border-radius: 2.5px; background: Theme.muted; x: (parent.width - self.width) / 2; accessible-role: none; }
        @children
    }
}

component SheetHeader inherits Rectangle {
    in property <string> title;
    in property <string> action;
    callback action-clicked();
    callback close();
    height: 76px;
    Text { x: Theme.s-lg; y: 22px; height: 48px; width: parent.width - 2 * Theme.s-lg - 56px - (root.action != "" ? 96px : 0px); text: root.title; color: Theme.ink; font-family: Theme.font-display; font-size: Theme.text-xl; font-weight: 700; letter-spacing: -0.44px; vertical-alignment: center; overflow: elide; accessible-role: AccessibleRole.text; }
    if root.action != "" : TextButton { x: parent.width - 56px - 96px; y: 22px; width: 96px; text: root.action; ink: Theme.ink; clicked => { root.action-clicked(); } }
    IconButton { x: parent.width - 56px; y: 22px; icon: Icons.close; label: "Fechar"; clicked => { root.close(); } }
}

component SheetAction inherits Pressable {
    in property <image> icon;
    in property <string> text;
    in property <bool> soon: false;
    height: 52px;
    enabled: !soon;
    ring-radius: Theme.r-group;
    label: soon ? text + ", em breve" : text;
    Rectangle { border-radius: Theme.r-group; background: root.pressed || root.hovered ? Theme.ink.with-alpha(0.10) : transparent; }
    HorizontalLayout {
        padding-left: Theme.s-sm;
        padding-right: Theme.s-sm;
        spacing: Theme.s-md;
        Icon { source: root.icon; opacity: root.soon ? 0.6 : 1; }
        Text { text: root.text; color: Theme.ink; font-size: Theme.text-lg; vertical-alignment: center; horizontal-stretch: 1; opacity: root.soon ? 0.6 : 1; overflow: elide; accessible-role: none; }
        if root.soon : VerticalLayout { alignment: center; Tag { text: "Em breve"; } }
    }
}

component SheetRule inherits Rectangle {
    height: 17px;
    Rectangle { x: Theme.s-sm; width: parent.width - 2 * Theme.s-sm; height: 1px; background: Theme.ink.with-alpha(0.14); }
}

// ------------------------------------------------------------------------------------------------ Fila
export component QueueSheet inherits SheetBase {
    title: "Fila";
    body-h: self.height - AppState.safe-top - Theme.s-xxxl;
    property <bool> empty: AppState.queue.length == 0;
    close => { AppState.queue-open = false; }
    VerticalLayout {
        padding-bottom: AppState.safe-bottom + Theme.s-lg;
        alignment: start;
        SheetHeader { title: "Fila"; action: root.empty ? "" : "Limpar"; action-clicked => { AppState.queue-clear(); } close => { AppState.queue-open = false; } }
        if root.empty : VerticalLayout {
            padding-left: Theme.s-lg;
            padding-right: Theme.s-lg;
            spacing: Theme.s-sm;
            Text { text: "A fila está vazia"; color: Theme.ink; font-size: Theme.text-lg; font-weight: 600; accessible-role: AccessibleRole.text; }
            Text { text: "Escolha uma música para começar a ouvir."; color: Theme.ink; font-size: Theme.text-md; wrap: word-wrap; accessible-role: AccessibleRole.text; }
            HorizontalLayout { alignment: start; Button { text: "Ir para o Início"; primary: true; clicked => { AppState.queue-open = false; Nav.close-player(); Nav.go(Tab.home); } } }
        }
        if !root.empty : VerticalLayout {
            HorizontalLayout { padding-left: Theme.s-lg; height: 32px; Text { text: "Tocando agora"; color: Theme.ink; font-size: Theme.text-md; font-weight: 600; vertical-alignment: center; accessible-role: AccessibleRole.text; } }
            VerticalLayout { padding-left: Theme.s-lg; padding-right: Theme.s-lg; TrackRow { t: AppState.now; separator: false; more: false; on-glass: true; clicked => { AppState.queue-open = false; Nav.close-player(); } } }
            Rectangle { height: Theme.s-sm; }
            HorizontalLayout { padding-left: Theme.s-lg; padding-right: Theme.s-lg; height: 32px; Text { text: AppState.now-origin != "" ? "A seguir, de " + AppState.now-origin : "A seguir"; color: Theme.ink; font-size: Theme.text-md; font-weight: 600; vertical-alignment: center; overflow: elide; accessible-role: AccessibleRole.text; } }
        }
        if !root.empty : ListView {
            vertical-stretch: 1;
            for t[i] in AppState.queue : HorizontalLayout {
                height: Theme.row-h;
                padding-left: Theme.s-lg;
                TrackRow {
                    t: t;
                    separator: i > 0;
                    more: false;
                    on-glass: true;
                    line: Theme.ink.with-alpha(0.14);
                    clicked => { AppState.queue-jump(t.id); }
                    VerticalLayout { alignment: center; if i > 0 : IconButton { icon: Icons.arrow-up; label: "Mover " + t.title + " para cima"; clicked => { AppState.queue-move-up(t.id); } } if i == 0 : Rectangle { width: 48px; } }
                    VerticalLayout { alignment: center; IconButton { icon: Icons.close; label: "Tirar " + t.title + " da fila"; clicked => { AppState.queue-remove(t.id); } } }
                }
                Rectangle { width: Theme.s-xs; }
            }
        }
        if !root.empty && (AppState.queue-more-label != "" || AppState.queue-note != "") : VerticalLayout {
            padding-left: Theme.s-lg;
            padding-right: Theme.s-lg;
            padding-top: Theme.s-sm;
            spacing: Theme.s-xxs;
            if AppState.queue-more-label != "" : Text { text: AppState.queue-more-label; color: Theme.ink; font-size: Theme.text-sm; wrap: word-wrap; accessible-role: AccessibleRole.text; }
            if AppState.queue-note != "" : Text { text: AppState.queue-note; color: Theme.ink; font-size: Theme.text-sm; wrap: word-wrap; accessible-role: AccessibleRole.text; }
        }
    }
}

// ------------------------------------------------------------------------------------------------ Menu da faixa
export component MenuSheet inherits SheetBase {
    title: "Ações da música";
    body-h: 96px + 9 * 52px + 2 * 17px + Theme.s-lg + AppState.safe-bottom;
    close => { AppState.menu-open = false; }
    VerticalLayout {
        padding-bottom: AppState.safe-bottom + Theme.s-lg;
        alignment: start;
        Rectangle {
            height: 96px;
            HorizontalLayout {
                y: 24px;
                height: 64px;
                padding-left: Theme.s-lg;
                padding-right: Theme.s-xs;
                spacing: Theme.s-sm;
                VerticalLayout { alignment: center; Cover { source: AppState.menu-track.cover; } }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: AppState.menu-track.title; color: Theme.ink; font-size: Theme.text-lg; font-weight: 600; overflow: elide; accessible-role: AccessibleRole.text; }
                    Text { text: AppState.menu-track.artist; color: Theme.ink; font-size: Theme.text-md; overflow: elide; accessible-role: AccessibleRole.text; }
                }
                VerticalLayout { alignment: center; IconButton { icon: Icons.close; label: "Fechar"; clicked => { AppState.menu-open = false; } } }
            }
        }
        VerticalLayout {
            padding-left: Theme.s-sm;
            padding-right: Theme.s-sm;
            SheetAction { icon: Icons.next; text: "Tocar em seguida"; clicked => { AppState.play-next(AppState.menu-track.id); AppState.menu-open = false; } }
            SheetAction { icon: Icons.queue; text: "Adicionar à fila"; clicked => { AppState.enqueue(AppState.menu-track.id); AppState.menu-open = false; } }
            SheetAction { icon: Icons.playlist-add; text: "Adicionar à playlist"; clicked => { AppState.playlist-sheet-track = AppState.menu-track.id; AppState.menu-open = false; AppState.playlist-sheet-open = true; } }
            SheetAction { icon: AppState.menu-track.liked ? Icons.heart-fill : Icons.heart; text: AppState.menu-track.liked ? "Descurtir" : "Curtir"; clicked => { AppState.toggle-like(AppState.menu-track.id); AppState.menu-open = false; } }
            SheetRule { }
            SheetAction { icon: Icons.disc; text: "Ir para o álbum"; clicked => { AppState.goto-album(AppState.menu-track.id); AppState.menu-open = false; if (AppState.player-open) { Nav.close-player(); } } }
            SheetAction { icon: Icons.user; text: "Ir para o artista"; clicked => { AppState.goto-artist(AppState.menu-track.id); AppState.menu-open = false; if (AppState.player-open) { Nav.close-player(); } } }
            SheetRule { }
            SheetAction { icon: Icons.lyrics; text: "Ver a letra"; soon: true; }
            SheetAction { icon: Icons.timer; text: "Timer para dormir"; soon: true; }
            SheetAction { icon: Icons.download; text: "Baixar"; soon: true; }
        }
    }
}

// ------------------------------------------------------------------------------------------------ Adicionar à playlist
export component PlaylistSheet inherits SheetBase {
    title: "Adicionar à playlist";
    property <length> list-h: min(AppState.playlists.length * 64px, 280px);
    body-h: 76px + 52px + Theme.s-xs + list-h + Theme.s-lg + AppState.safe-bottom;
    close => { AppState.playlist-sheet-open = false; }
    VerticalLayout {
        padding-bottom: AppState.safe-bottom + Theme.s-lg;
        alignment: start;
        SheetHeader { title: "Adicionar à playlist"; close => { AppState.playlist-sheet-open = false; } }
        VerticalLayout {
            padding-left: Theme.s-sm;
            padding-right: Theme.s-sm;
            SheetAction { icon: Icons.plus; text: "Nova playlist"; clicked => { AppState.new-playlist-track = AppState.playlist-sheet-track; AppState.playlist-sheet-open = false; AppState.new-playlist-open = true; } }
            Rectangle { height: Theme.s-xs; }
            ListView {
                height: root.list-h;
                for p in AppState.playlists : Pressable {
                    height: 64px;
                    ring-radius: Theme.r-group;
                    label: p.name + ", " + p.count-label;
                    clicked => { AppState.add-to-playlist(AppState.playlist-sheet-track, p.id); AppState.playlist-sheet-open = false; }
                    Rectangle { border-radius: Theme.r-group; background: parent.pressed || parent.hovered ? Theme.ink.with-alpha(0.10) : transparent; }
                    HorizontalLayout {
                        padding-left: Theme.s-sm;
                        spacing: Theme.s-sm;
                        VerticalLayout { alignment: center; Mosaic { width: 48px; height: 48px; radius: Theme.r-thumb; sources: p.covers; } }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: p.name; color: Theme.ink; font-size: Theme.text-lg; overflow: elide; accessible-role: none; }
                            Text { text: p.count-label; color: Theme.ink; font-size: Theme.text-sm; overflow: elide; accessible-role: none; }
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------------------------------------ Nova playlist
export component NewPlaylistSheet inherits SheetBase {
    title: "Nova playlist";
    // celular: com o campo em foco o teclado ocupa a base; a folha sobe ~40% da janela (>= 600 não muda nada)
    lift: (Theme.compact && field.has-focus) ? root.height * 0.4 : 0px;
    body-h: 76px + 28px + 48px + 34px + 48px + Theme.s-xl + AppState.safe-bottom;
    property <string> suggestion: "Minha playlist";
    close => { AppState.new-playlist-open = false; }
    function create() {
        AppState.create-playlist-named(field.text != "" ? field.text : root.suggestion, AppState.new-playlist-track);
        AppState.new-playlist-open = false;
    }
    VerticalLayout {
        padding-bottom: AppState.safe-bottom + Theme.s-lg;
        alignment: start;
        SheetHeader { title: "Nova playlist"; close => { AppState.new-playlist-open = false; } }
        Text { x: Theme.s-lg; width: parent.width - 2 * Theme.s-lg; height: 28px; text: "Nome da playlist"; color: Theme.ink; font-size: Theme.text-md; font-weight: 600; accessible-role: AccessibleRole.text; }
        HorizontalLayout {
            padding-left: Theme.s-lg;
            padding-right: Theme.s-lg;
            field := SearchField {
                plain: true;
                text: root.suggestion;
                placeholder: "Nome da playlist";
                fill: Theme.ink.with-alpha(0.10);
                accepted(t) => { root.create(); }
                init => { self.focus-input(); self.select-input(); }
            }
        }
        Text { x: Theme.s-lg; width: parent.width - 2 * Theme.s-lg; height: 34px; text: "Fica guardada neste aparelho."; color: Theme.ink; font-size: Theme.text-sm; vertical-alignment: center; accessible-role: AccessibleRole.text; }
        HorizontalLayout {
            padding-left: Theme.s-lg;
            padding-right: Theme.s-lg;
            spacing: Theme.s-sm;
            Button { text: "Cancelar"; horizontal-stretch: 1; clicked => { AppState.new-playlist-open = false; } }
            Button { text: "Criar playlist"; primary: true; horizontal-stretch: 1; clicked => { root.create(); } }
        }
    }
}
