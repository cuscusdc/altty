// Esqueleto das telas: rolagem com gutter, trilho horizontal, grade e cabeçalho de página.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { Tab, AppState, Album } from "../theme/app-contract.slint";
import { RoundButton } from "basics.slint";
import { MediaTile } from "media.slint";

// Rolagem vertical de uma aba. Respeita a área segura do topo e a reserva do cromo (foco nunca coberto).
// Cada aba guarda a posição (Metrics.scroll-*); tocar na aba ativa volta ao topo.
// O conteúdo ocupa a largura toda; cada bloco aplica a margem com `Gutter`.
export component ScreenScroll inherits Flickable {
    in property <Tab> tab: Tab.home;
    in property <length> extra-bottom: 0px;
    property <float> appear: 0.0;
    property <int> top-seq: Metrics.scroll-top-seq;
    init => { root.content-y = Metrics.saved-scroll(root.tab); root.appear = 1.0; }
    changed content-y => { Metrics.save-scroll(root.tab, self.content-y); }
    changed top-seq => { root.content-y = 0px; }
    opacity: appear;
    animate appear { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    interactive: true;
    content-width: root.width;
    content-height: max(root.height, col.preferred-height);
    col := VerticalLayout {
        x: 0px; y: 0px; width: root.width;
        alignment: start;
        padding-top: AppState.safe-top + 8px;
        @children
        Rectangle { height: Metrics.chrome-reserve + root.extra-bottom; }
    }
}

// Margem lateral do conteúdo (gutter 16/24/32, largura máxima, áreas seguras).
export component Gutter inherits HorizontalLayout {
    padding-left: Metrics.side-l; padding-right: Metrics.side-r;
}

// Título da página (≥ 600; no compact o rótulo da aba já diz onde está, mas o título existe para leitor de tela).
export component PageTitle inherits Rectangle {
    in property <string> text;
    height: Theme.compact ? 0px : 56px;
    Text {
        visible: !Theme.compact; width: 100%; height: 100%; text: root.text; vertical-alignment: center;
        font-size: Theme.fs-large-title; font-weight: Theme.fw-large-title; letter-spacing: Theme.ls-large-title; color: Theme.ink;
        accessible-role: AccessibleRole.text;
    }
    // compact: nome da tela só para o leitor de tela
    accessible-role: AccessibleRole.text; accessible-label: Theme.compact ? text : "";
}

// Trilho horizontal (chips, carrosséis). Sem barra de rolagem; ≥ 840 mostra setas (alternativa ao arrastar).
export component HRail inherits Flickable {
    in property <length> spacing: 12px;
    in property <length> rail-h: 48px;
    in property <string> label;
    height: rail-h;
    content-width: row.preferred-width + Metrics.side-l + Metrics.side-r;
    content-height: root.height;
    interactive: true;
    accessible-role: list; accessible-label: label;
    function scroll-by(dx: length) {
        root.content-x = clamp(root.content-x + dx, min(0px, root.width - root.content-width), 0px);
    }
    animate content-x { duration: Theme.dur-medium; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    row := HorizontalLayout {
        x: Metrics.side-l; y: 0px; width: self.preferred-width; height: root.height;
        spacing: root.spacing; alignment: start;
        @children
    }
    if !Theme.compact && root.content-width > root.width + 1px : RoundButton {
        x: root.width - 48px - 8px; y: (root.height - 48px) / 2; icon: Icons.chevron-right; label: "Ver mais itens";
        clicked => { root.scroll-by(-root.width * 0.8); }
    }
    if !Theme.compact && root.content-width > root.width + 1px && root.content-x < -1px : RoundButton {
        x: 8px; y: (root.height - 48px) / 2; icon: Icons.chevron-left; label: "Ver itens anteriores";
        clicked => { root.scroll-by(root.width * 0.8); }
    }
}

// Grade de álbuns: 2 colunas no celular (gap 12/16), 3 ou 4 acima.
export component AlbumGrid inherits Rectangle {
    in property <[Album]> albums;
    in property <int> cols: Metrics.grid-cols;
    property <length> gap: 12px;
    property <length> side: (root.width - (root.cols - 1) * root.gap) / root.cols;
    height: ceil(root.albums.length / root.cols) * (root.side + 72px) + 8px;
    for a[i] in root.albums : MediaTile {
        x: mod(i, root.cols) * (root.side + root.gap); y: floor(i / root.cols) * (root.side + 72px);
        side: root.side; cover: a.cover; title: a.title; subtitle: a.artist;
        clicked => { AppState.open-album(a.id); }
    }
}
