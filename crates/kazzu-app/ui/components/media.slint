// Linhas de faixa, cartões e menus (SLINT_SPEC §3.7 e §3.8).
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Track, Album, Highlight, AppState } from "../theme/app-contract.slint";
import { IconButton, FormatBadge, CoverImage } from "../theme/atoms.slint";
import { FocusRing, NowBars } from "basics.slint";

// Menu "mais" (Tocar em seguida, Adicionar à fila, Curtir). Sólido: nunca vidro dentro de linhas.
export component RowMenu inherits Rectangle {
    in property <string> track-id;
    in property <bool> liked: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    public function open() { pop.show(); }
    width: 0px; height: 0px;
    pop := PopupWindow {
        x: root.menu-x; y: root.menu-y; width: 244px; height: 3 * 48px + 16px;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 16px; background: Theme.glass-solid-strong; border-width: 1px; border-color: Theme.line-strong;
            drop-shadow-blur: Theme.e2-blur; drop-shadow-offset-y: Theme.e2-y; drop-shadow-color: Theme.e2-color;
            VerticalLayout {
                padding: 8px;
                for item[i] in [
                    { icon: Icons.queue, label: "Tocar em seguida" },
                    { icon: Icons.playlist-add, label: "Adicionar à fila" },
                    { icon: root.liked ? Icons.heart-fill : Icons.heart, label: root.liked ? "Remover dos curtidos" : "Curtir" },
                ] : Rectangle {
                    height: 48px; border-radius: 10px;
                    background: mta.has-hover ? Theme.surface-2 : transparent;
                    accessible-role: button; accessible-label: item.label;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Image { source: item.icon; width: 20px; height: 20px; y: (parent.height - 20px) / 2; colorize: Theme.ink-2; }
                        Text { text: item.label; font-size: Theme.fs-callout; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
                    }
                    mta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (i == 0) { AppState.play-next(root.track-id); }
                            else if (i == 1) { AppState.enqueue(root.track-id); }
                            else { AppState.toggle-like(root.track-id); }
                            pop.close();
                        }
                    }
                }
            }
        }
    }
}

// Linha de faixa. `queue-mode`: grip à esquerda, tempo mono e botão remover (fila).
export component TrackRow inherits Rectangle {
    in property <Track> track;
    in property <bool> show-album: false;
    in property <bool> queue-mode: false;
    in property <int> index: 0;
    callback clicked();
    callback remove();
    height: Theme.row-h;
    border-radius: 16px;
    background: ta.pressed ? Theme.surface-2 : (ta.has-hover || fs.has-focus) ? Theme.surface : transparent;
    animate background { duration: Theme.dur-micro; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    accessible-role: button;
    accessible-label: root.track.title + ", " + root.track.artist + (root.track.playing ? ", tocando agora" : "");
    accessible-action-default => { root.clicked(); }

    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return) { root.clicked(); return accept; }
            if (queue-mode && e.text == Key.Delete) { root.remove(); return accept; }
            return reject;
        }
    }

    HorizontalLayout {
        padding: 8px; spacing: 12px; alignment: stretch;
        CoverImage { width: Theme.row-cover; height: Theme.row-cover; source: root.track.cover; radius: Theme.thumb-radius; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center;
            Text {
                text: root.track.title; font-size: Theme.fs-body; font-weight: 600; letter-spacing: Theme.ls-body;
                color: root.track.playing ? Theme.accent : Theme.ink; overflow: elide; wrap: no-wrap;
            }
            Text {
                text: root.track.source == "" ? root.track.artist : root.track.artist + ", " + root.track.source;
                font-size: Theme.fs-subhead; color: Theme.ink-3; overflow: elide; wrap: no-wrap;
            }
        }
        if root.show-album && Theme.wide : Text {
            text: root.track.album; font-size: Theme.fs-subhead; color: Theme.ink-3; overflow: elide; wrap: no-wrap;
            width: (root.width - 16px) * 0.26; vertical-alignment: center;
        }
        if root.track.playing : NowBars { y: (parent.height - self.height) / 2; }
        if root.track.codec != "" && (!Theme.compact || !root.queue-mode) : FormatBadge {
            codec: root.track.codec; detail: root.track.detail; hires: root.track.hires; y: (parent.height - self.height) / 2;
        }
        if root.queue-mode : Text {
            text: root.track.duration-label; font-family: Theme.font-mono; font-size: Theme.fs-timecode; color: Theme.ink-3;
            width: 40px; horizontal-alignment: right; vertical-alignment: center;
        }
        if root.queue-mode : IconButton {
            icon: Icons.close; glyph: Theme.icon-sm; label: "Remover " + root.track.title + " da fila"; tint: Theme.ink-2; y: (parent.height - self.height) / 2;
            clicked => { root.remove(); }
        }
        if !root.queue-mode : more := IconButton {
            icon: Icons.more; label: "Mais ações para " + root.track.title; tint: Theme.ink-2; y: (parent.height - self.height) / 2;
            clicked => { menu.open(); }
        }
    }
    FocusRing { active: fs.has-focus; radius: 16px; }
    menu := RowMenu { track-id: root.track.id; liked: root.track.liked; menu-x: root.width - 252px; menu-y: root.height - 4px; }
}

// Cartão de álbum (rail da Início, resultados de busca, grade do detalhe).
export component AlbumTile inherits Rectangle {
    in property <Album> item;
    callback clicked();
    property <length> side: Theme.compact ? 148px : 176px;
    width: side; height: side + 8px + 20px + 18px;
    accessible-role: button; accessible-label: item.title + ", " + item.artist;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        y: ta.has-hover ? -2px : 0px;
        animate y { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
        CoverImage { x: 0px; y: 0px; width: root.side; height: root.side; source: root.item.cover; radius: 16px; }
        Text { x: 0px; y: root.side + 8px; width: root.side; height: 20px; text: root.item.title; font-size: Theme.fs-callout; font-weight: 600; color: Theme.ink; overflow: elide; wrap: no-wrap; }
        Text { x: 0px; y: root.side + 28px; width: root.side; height: 18px; text: root.item.artist; font-size: Theme.fs-subhead; color: Theme.ink-3; overflow: elide; wrap: no-wrap; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } return reject; } }
    FocusRing { active: fs.has-focus; radius: 16px; width: root.side; height: root.side; }
}

// Cartão de destaque: capa full-bleed + placa escura (fill fixo, SLINT_SPEC §2).
export component HeroCard inherits Rectangle {
    in property <Highlight> item;
    callback clicked();
    width: Theme.compact ? Theme.hero-card-w-mobile : Theme.hero-card-w-desktop;
    height: Theme.compact ? Theme.hero-card-h-mobile : Theme.hero-card-h-desktop;
    accessible-role: button; accessible-label: item.caption + ", " + item.title + ", " + item.subtitle;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        y: ta.has-hover ? -2px : 0px;
        animate y { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
        CoverImage { width: 100%; height: 100%; source: root.item.cover; radius: 24px; }
        // placa: fill fixo (preto-quente 64%); sólido sem blur
        Rectangle {
            x: 10px; y: parent.height - self.height - 10px; width: parent.width - 20px; height: 100px;
            border-radius: 18px;
            background: Theme.glass-live ? #0c0907a3 : #1a1511;
            backdrop-blur: Theme.glass-blur-radius;
            border-width: 1px; border-color: #ffffff1f;
            Text { x: 16px; y: 16px; width: parent.width - 32px - 60px; height: 18px; text: root.item.caption; font-size: 13px; color: Theme.im-ink-2; overflow: elide; wrap: no-wrap; }
            Text { x: 16px; y: 36px; width: parent.width - 32px - 60px; height: 28px; text: root.item.title; font-size: Theme.fs-title-2; font-weight: Theme.fw-title-2; letter-spacing: Theme.ls-title-2; color: Theme.im-ink; overflow: elide; wrap: no-wrap; }
            Text { x: 16px; y: 66px; width: parent.width - 32px - 60px; height: 18px; text: root.item.subtitle; font-size: Theme.fs-subhead; color: Theme.im-ink-2; overflow: elide; wrap: no-wrap; }
        }
        Rectangle {
            x: parent.width - 48px - 24px; y: parent.height - 48px - 24px; width: 48px; height: 48px; border-radius: 24px; background: Theme.accent;
            Image { source: Icons.play; width: 28px; height: 28px; x: 11px; y: 10px; colorize: Theme.accent-ink; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } return reject; } }
    FocusRing { active: fs.has-focus; radius: 24px; }
}

// Gênero (Explorar): capa full-bleed com véu e título.
export component MoodTile inherits Rectangle {
    in property <Highlight> item;
    callback clicked();
    height: self.width / 1.6;
    border-radius: 20px;
    clip: true;
    accessible-role: button; accessible-label: item.title;
    accessible-action-default => { root.clicked(); }
    CoverImage { width: 100%; height: 100%; source: root.item.cover; radius: 20px; }
    Rectangle { background: @linear-gradient(180deg, transparent 35%, #000000b3 100%); }
    Text { x: 14px; y: parent.height - self.height - 12px; width: parent.width - 28px; text: root.item.title; font-size: Theme.fs-title-2; font-weight: Theme.fw-title-2; letter-spacing: Theme.ls-title-2; color: Theme.im-ink; overflow: elide; wrap: no-wrap; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } return reject; } }
    FocusRing { active: fs.has-focus; radius: 20px; }
}
