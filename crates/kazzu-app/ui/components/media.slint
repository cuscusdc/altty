// Capas, linhas de faixa, cartões e placas (SLINT_SPEC §3.5 e §3.6). Sem vidro dentro de linhas.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Track, Album, Highlight, Collection, Artist, AppState } from "../theme/app-contract.slint";
import { IconButton, FormatBadge, CoverImage, GlassPanel } from "../theme/atoms.slint";
import { FocusRing, NowBars } from "basics.slint";

// Capa com placeholder: sem imagem (`source.width == 0`: sem capa embutida na tag, sem cover.jpg lido) mostra `Theme.surface-2`
// com o ícone `disc` centralizado (SLINT_SPEC §1.10). `tint` (humores) substitui o fundo e dispensa o ícone.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.thumb-radius;
    in property <color> tint: transparent;       // cor da placa quando não há capa (humores)
    in property <color> placeholder: Theme.surface-2;
    in property <color> icon-tint: Theme.ink-3;
    accessible-role: none;
    CoverImage { source: root.source; radius: root.radius; placeholder: root.tint.alpha > 0 ? root.tint : root.placeholder; }
    if root.source.width == 0 && root.tint.alpha == 0 : Image {
        source: Icons.disc; width: min(root.width, root.height) * 0.4; height: self.width;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; colorize: root.icon-tint;
    }
}

// Mosaico 2×2 (Álbuns, Playlists). Sem nenhuma capa: um único placeholder com o disco; capas faltando: células com o disco.
export component Mosaic inherits Rectangle {
    in property <[image]> covers;
    border-radius: 16px; clip: true; background: Theme.surface-2;
    accessible-role: none;
    if root.covers.length == 0 : Image {
        source: Icons.disc; width: min(root.width, root.height) * 0.4; height: self.width;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; colorize: Theme.ink-3;
    }
    if root.covers.length > 0 : Rectangle {
        for i in 4 : Rectangle {
            x: mod(i, 2) * root.width / 2; y: floor(i / 2) * root.height / 2; width: root.width / 2; height: root.height / 2;
            background: Theme.surface-2;
            if i >= root.covers.length || root.covers[i].width == 0 : Image {
                source: Icons.disc; width: parent.width * 0.4; height: self.width;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Theme.ink-3;
            }
            if i < root.covers.length && root.covers[i].width > 0 : Image { source: root.covers[i]; width: 100%; height: 100%; image-fit: cover; }
        }
    }
}

// Linha de faixa: capa 52, título 16 semibold, artista 14 ink-2, motivo (`why`) opcional, barras "tocando", selo de formato
// (some em < 380 px) e botão `more` (48) que abre o MenuSheet. Altura mínima 64. Sem vidro.
export component TrackRow inherits Rectangle {
    in property <Track> track;
    in property <bool> show-format: false;
    in property <int> number: 0;                // > 0: linha numerada ("Em alta")
    in property <bool> show-more: true;
    in property <bool> emphasize: false;        // fundo ink 12% ("Tocando agora" na fila)
    in property <string> more-label: "Mais opções para " + track.title;
    callback clicked();
    callback more();
    height: track.why != "" ? 84px : Theme.row-h;
    border-radius: 18px;
    background: root.emphasize ? Theme.ink.with-alpha(0.12) : ta.pressed ? Theme.ink.with-alpha(0.14) : (ta.has-hover || fs.has-focus) ? Theme.ink.with-alpha(0.08) : transparent;
    animate background { duration: Theme.dur-micro; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    accessible-role: button;
    accessible-label: root.track.title + ", " + root.track.artist + (root.track.playing ? ", tocando agora" : "") + (root.track.why != "" ? ", " + root.track.why : "");
    accessible-action-default => { root.clicked(); }

    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false;
        key-pressed(e) => { if (e.text == Key.Return) { root.clicked(); return accept; } return reject; }
    }

    HorizontalLayout {
        padding-left: 8px; padding-right: 4px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
        if root.number > 0 : Text {
            text: root.number; width: 24px; font-family: Theme.font-mono; font-size: Theme.fs-subhead; font-weight: 500;
            color: Theme.ink-2; vertical-alignment: center; horizontal-alignment: center; accessible-role: none;
        }
        Cover { width: 52px; height: 52px; source: root.track.cover; radius: 12px; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center; spacing: 1px; horizontal-stretch: 1;
            Text { text: root.track.title; font-size: Theme.fs-body; font-weight: 600; color: root.track.playing ? Theme.accent : Theme.ink; overflow: elide; wrap: no-wrap; accessible-role: none; }
            Text { text: root.track.artist; font-size: Theme.fs-subhead; color: Theme.ink-2; overflow: elide; wrap: no-wrap; accessible-role: none; }
            if root.track.why != "" : Text { text: root.track.why; font-size: Theme.fs-caption; font-weight: 600; color: Theme.ink-2; overflow: elide; wrap: no-wrap; accessible-role: none; }
        }
        if root.track.playing : VerticalLayout { alignment: center; NowBars { } }
        if root.show-format && Theme.window-w >= 380px && root.track.codec != "" : VerticalLayout {
            alignment: center;
            FormatBadge { codec: root.track.codec; detail: root.track.detail; hires: root.track.hires; }
        }
        if root.show-more : VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.more; label: root.more-label; tint: Theme.ink;
                clicked => { AppState.menu-track = root.track; AppState.menu-open = true; root.more(); }
            }
        }
    }
    FocusRing { active: fs.has-focus; radius: 18px; }
}

// Linha genérica (artista, playlist, resultado de busca): capa 52 (redonda para artistas) + título + subtítulo.
export component MediaRow inherits Rectangle {
    in property <image> cover;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> round: false;
    callback clicked();
    height: Theme.row-h; border-radius: 18px;
    background: ta.pressed ? Theme.ink.with-alpha(0.14) : (ta.has-hover || fs.has-focus) ? Theme.ink.with-alpha(0.08) : transparent;
    accessible-role: button; accessible-label: root.title + (root.subtitle != "" ? ", " + root.subtitle : "");
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return) { root.clicked(); return accept; } return reject; } }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
        Cover { width: 52px; height: 52px; source: root.cover; radius: root.round ? 26px : 12px; y: (parent.height - self.height) / 2; }
        VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
            Text { text: root.title; font-size: Theme.fs-body; font-weight: 600; color: Theme.ink; overflow: elide; wrap: no-wrap; accessible-role: none; }
            Text { text: root.subtitle; font-size: Theme.fs-subhead; color: Theme.ink-2; overflow: elide; wrap: no-wrap; accessible-role: none; }
        }
        VerticalLayout { alignment: center; Image { source: Icons.chevron-right; width: 20px; height: 20px; colorize: Theme.ink-2; } }
    }
    FocusRing { active: fs.has-focus; radius: 18px; }
}

// Peça de trilho/grade: capa quadrada (raio 24), título 16 semibold, subtítulo 14 ink-2. `side` = lado da capa.
export component MediaTile inherits Rectangle {
    in property <image> cover;
    in property <string> title;
    in property <string> subtitle;
    in property <length> side: 148px;
    in property <color> tint: transparent;
    in property <bool> round: false;
    callback clicked();
    width: side; height: side + 8px + title-t.preferred-height + (root.subtitle != "" ? 20px : 0px) + 4px;
    accessible-role: button; accessible-label: root.title + (root.subtitle != "" ? ", " + root.subtitle : "");
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return) { root.clicked(); return accept; } return reject; } }
    Cover { x: 0px; y: 0px; width: root.side; height: root.side; source: root.cover; tint: root.tint; radius: root.round ? root.side / 2 : 24px; }
    Rectangle { width: root.side; height: root.side; border-radius: root.round ? root.side / 2 : 24px; background: ta.pressed ? Theme.ink.with-alpha(0.14) : transparent; }
    title-t := Text { x: 0px; y: root.side + 8px; width: root.side; text: root.title; font-size: Theme.fs-body; font-weight: 600; color: Theme.ink; overflow: elide; wrap: no-wrap; accessible-role: none; horizontal-alignment: root.round ? center : left; }
    if root.subtitle != "" : Text { x: 0px; y: root.side + 8px + title-t.preferred-height; width: root.side; text: root.subtitle; font-size: Theme.fs-subhead; color: Theme.ink-2; overflow: elide; wrap: no-wrap; accessible-role: none; horizontal-alignment: root.round ? center : left; }
    FocusRing { y: 0px; height: root.side; radius: root.round ? root.side / 2 : 24px; active: fs.has-focus; }
}

// Cartão de destaque (carrossel "Continue por aqui"): capa full-bleed + placa de vidro nível 1 + botão play de 52.
export component HeroCard inherits Rectangle {
    in property <Highlight> item;
    in property <length> card-w: Theme.hero-card-w-mobile;
    callback clicked();
    callback play();
    width: card-w; height: card-w * 380 / 300;
    border-radius: 28px; clip: true;
    background: item.tint.alpha > 0 ? item.tint : Theme.surface-2;
    accessible-role: button;
    accessible-label: root.item.caption + ", " + root.item.title + ", " + root.item.subtitle;
    accessible-action-default => { root.clicked(); }
    if root.item.cover.width > 0 : Image { source: root.item.cover; width: 100%; height: 100%; image-fit: cover; }
    if root.item.cover.width == 0 && root.item.tint.alpha == 0 : Image { source: Icons.disc; width: parent.width * 0.3; height: self.width; x: (parent.width - self.width) / 2; y: parent.height * 0.3; colorize: Theme.ink-3; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return) { root.clicked(); return accept; } return reject; } }
    Rectangle { border-radius: 28px; border-width: 1px; border-color: Theme.ink.with-alpha(0.12); }
    plate := GlassPanel {
        level: 1; radius: 20px; x: 10px; width: parent.width - 20px; height: 88px; y: parent.height - 10px - self.height;
        accessible-role: none;
        HorizontalLayout {
            padding-left: 14px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px; spacing: 8px;
            VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
                Text { text: root.item.caption; font-size: Theme.fs-caption; font-weight: Theme.fw-caption; color: Theme.ink-2; overflow: elide; wrap: no-wrap; accessible-role: none; }
                Text { text: root.item.title; font-size: Theme.fs-headline; font-weight: Theme.fw-headline; color: Theme.ink; overflow: elide; wrap: no-wrap; accessible-role: none; }
                Text { text: root.item.subtitle; font-size: Theme.fs-subhead; color: Theme.ink-2; overflow: elide; wrap: no-wrap; accessible-role: none; }
            }
            VerticalLayout { alignment: center;
                Rectangle {
                    width: 52px; height: 52px; border-radius: 26px; background: pta.pressed ? Theme.accent.mix(Theme.bg, 0.78) : Theme.accent;
                    accessible-role: button; accessible-label: "Tocar " + root.item.title;
                    accessible-action-default => { root.play(); }
                    Image { source: Icons.play; width: 26px; height: 26px; x: 14px; y: 13px; colorize: Theme.accent-ink; }
                    pta := TouchArea { mouse-cursor: pointer; clicked => { root.play(); } }
                }
            }
        }
    }
    FocusRing { active: fs.has-focus; radius: 28px; }
}

// Humor/gênero (Explorar): proporção 1,55, raio 22, capa (ou cor `tint`) full-bleed + placa de vidro nível 1 no pé.
export component MoodTile inherits Rectangle {
    in property <Highlight> item;
    callback clicked();
    height: self.width / 1.55;
    border-radius: 22px; clip: true;
    background: item.tint.alpha > 0 ? item.tint : Theme.surface-2;
    accessible-role: button; accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }
    if root.item.cover.width > 0 : Image { source: root.item.cover; width: 100%; height: 100%; image-fit: cover; }
    if root.item.cover.width == 0 && root.item.tint.alpha == 0 : Image { source: Icons.disc; width: parent.height * 0.4; height: self.width; x: (parent.width - self.width) / 2; y: parent.height * 0.12; colorize: Theme.ink-3; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return) { root.clicked(); return accept; } return reject; } }
    Rectangle { border-radius: 22px; border-width: 1px; border-color: Theme.ink.with-alpha(0.12); }
    GlassPanel {
        level: 1; radius: 16px; x: 10px; width: parent.width - 20px; height: 44px; y: parent.height - 10px - self.height;
        accessible-role: none;
        Text { x: 14px; width: parent.width - 28px; height: parent.height; text: root.item.title; font-size: Theme.fs-headline; font-weight: Theme.fw-headline; color: Theme.ink; vertical-alignment: center; overflow: elide; accessible-role: none; }
    }
    FocusRing { active: fs.has-focus; radius: 22px; }
}

// Cartão de coleção da Biblioteca. `kind`: 0 Baixados, 1 Curtidas, 2+ mosaico (Álbuns, Playlists).
export component CollectionCard inherits GlassPanel {
    in property <Collection> item;
    in property <int> kind: 2;
    callback clicked();
    level: 1; radius: 24px;
    height: self.width + 56px;
    opacity: item.soon ? 0.7 : 1.0;
    accessible-role: button;
    accessible-label: root.item.title + ", " + (root.item.soon ? "em breve" : root.item.count-label);
    accessible-enabled: !root.item.soon;
    accessible-action-default => { if (!root.item.soon) { root.clicked(); } }
    property <length> art: root.width - 24px;
    ta := TouchArea { enabled: !root.item.soon; mouse-cursor: root.item.soon ? default : pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; enabled: !root.item.soon; key-pressed(e) => { if (e.text == Key.Return) { root.clicked(); return accept; } return reject; } }
    if root.kind == 0 : Rectangle {
        x: 12px; y: 12px; width: root.art; height: root.art; border-radius: 16px; background: Theme.ink.with-alpha(0.10);
        Image { source: Icons.download; width: 56px; height: 56px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Theme.ink; }
    }
    if root.kind == 1 : Rectangle {
        x: 12px; y: 12px; width: root.art; height: root.art; border-radius: 16px;
        background: @linear-gradient(150deg, Theme.accent.mix(Theme.ink, 0.25) 0%, Theme.accent.mix(Theme.stage-b, 0.55) 100%);
        Image { source: Icons.heart-fill; width: 56px; height: 56px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Theme.accent-ink; }
    }
    if root.kind >= 2 : Mosaic { x: 12px; y: 12px; width: root.art; height: root.art; covers: root.item.covers; }
    Text { x: 14px; y: 12px + root.art + 10px; width: root.width - 28px; text: root.item.title; font-size: Theme.fs-headline; font-weight: Theme.fw-headline; color: Theme.ink; overflow: elide; accessible-role: none; }
    Text { x: 14px; y: 12px + root.art + 34px; width: root.width - 28px; text: root.item.soon ? "Em breve" : root.item.count-label; font-size: Theme.fs-subhead; color: Theme.ink-2; overflow: elide; accessible-role: none; }
    FocusRing { active: fs.has-focus; radius: 24px; }
}

// "Melhor resultado" da busca: vidro nível 1, capa 96.
export component BestResult inherits GlassPanel {
    in property <Highlight> item;
    callback clicked();
    callback play();
    level: 1; radius: 24px; height: 128px;
    accessible-role: button; accessible-label: "Melhor resultado: " + root.item.title + ", " + root.item.subtitle;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return) { root.clicked(); return accept; } return reject; } }
    HorizontalLayout {
        padding: 16px; spacing: 16px;
        Cover { width: 96px; height: 96px; source: root.item.cover; tint: root.item.tint; radius: root.item.kind == "artist" ? 48px : 20px; }
        VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text { text: "Melhor resultado"; font-size: Theme.fs-caption; font-weight: Theme.fw-caption; color: Theme.ink-2; accessible-role: none; }
            Text { text: root.item.title; font-size: Theme.fs-title-2; font-weight: Theme.fw-title-2; letter-spacing: Theme.ls-title-2; color: Theme.ink; overflow: elide; wrap: no-wrap; accessible-role: none; }
            Text { text: root.item.subtitle; font-size: Theme.fs-subhead; color: Theme.ink-2; overflow: elide; wrap: no-wrap; accessible-role: none; }
        }
        VerticalLayout { alignment: center;
            Rectangle {
                width: 48px; height: 48px; border-radius: 24px; background: Theme.accent;
                accessible-role: button; accessible-label: "Tocar " + root.item.title;
                accessible-action-default => { root.play(); }
                Image { source: Icons.play; width: 24px; height: 24px; x: 12px; y: 12px; colorize: Theme.accent-ink; }
                TouchArea { mouse-cursor: pointer; clicked => { root.play(); } }
            }
        }
    }
    FocusRing { active: fs.has-focus; radius: 24px; }
}

// Linha de playlist com mosaico 2×2 (Biblioteca).
export component PlaylistRow inherits Rectangle {
    in property <[image]> covers;
    in property <string> title;
    in property <string> subtitle;
    callback clicked();
    height: Theme.row-h; border-radius: 18px;
    background: ta.pressed ? Theme.ink.with-alpha(0.14) : (ta.has-hover || fs.has-focus) ? Theme.ink.with-alpha(0.08) : transparent;
    accessible-role: button; accessible-label: root.title + ", " + root.subtitle;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return) { root.clicked(); return accept; } return reject; } }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
        Mosaic { width: 52px; height: 52px; covers: root.covers; border-radius: 12px; y: (parent.height - self.height) / 2; }
        VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
            Text { text: root.title; font-size: Theme.fs-body; font-weight: 600; color: Theme.ink; overflow: elide; wrap: no-wrap; accessible-role: none; }
            Text { text: root.subtitle; font-size: Theme.fs-subhead; color: Theme.ink-2; overflow: elide; wrap: no-wrap; accessible-role: none; }
        }
        VerticalLayout { alignment: center; Image { source: Icons.chevron-right; width: 20px; height: 20px; colorize: Theme.ink-2; } }
    }
    FocusRing { active: fs.has-focus; radius: 18px; }
}
