// Componentes pequenos e compartilhados (SLINT_SPEC §3). Nada de literais de cor: sempre Theme.* / Metrics.*.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState } from "../theme/app-contract.slint";
import { IconButton, GlassPanel } from "../theme/atoms.slint";

// Anel de foco: 2 px na cor de destaque, SEM animação. Desenhado por dentro da borda do elemento (preenche o pai),
// para não ser cortado por `clip` de cartões nem por layouts.
export component FocusRing inherits Rectangle {
    in property <bool> active: false;
    in property <length> radius: 12px;
    visible: active;
    border-radius: radius;
    border-width: Theme.focus-ring-w; border-color: Theme.focus-ring;
}

// Barras "tocando" (3 barras estáticas).
export component NowBars inherits Rectangle {
    width: 20px; height: 18px;
    accessible-role: text;
    accessible-label: "Tocando agora";
    Rectangle { x: 0px;  y: 18px - 10px; width: 4px; height: 10px; border-radius: 2px; background: Theme.accent; }
    Rectangle { x: 7px;  y: 0px;         width: 4px; height: 18px; border-radius: 2px; background: Theme.accent; }
    Rectangle { x: 14px; y: 18px - 13px; width: 4px; height: 13px; border-radius: 2px; background: Theme.accent; }
}

// Botão de texto (ação secundária: "Limpar", "Ver mais"). Alvo 48.
export component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> ink: Theme.ink;
    callback clicked();
    height: Theme.hit;
    width: max(Theme.hit, lbl.preferred-width + 24px);
    border-radius: 16px;
    background: !enabled ? transparent : ta.pressed ? Theme.ink.with-alpha(0.20) : ta.has-hover ? Theme.ink.with-alpha(0.08) : transparent;
    opacity: enabled ? 1.0 : 0.5;
    accessible-role: button; accessible-label: label; accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    animate background { duration: Theme.dur-micro; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    lbl := Text {
        text: root.label; color: root.ink; font-size: Theme.fs-callout; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height;
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } return reject; }
    }
    FocusRing { active: fs.has-focus; radius: 16px; }
}

export enum PillKind { primary, quiet }

// Botão em pílula: primary = cor de destaque; quiet = fill simples do vidro (sem blur).
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <PillKind> kind: PillKind.primary;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.hit; border-radius: Theme.hit / 2;
    width: row.preferred-width;
    property <color> base: kind == PillKind.primary ? Theme.accent : Theme.ink.with-alpha(0.12);
    background: ta.pressed ? (kind == PillKind.primary ? base.mix(Theme.bg, 0.78) : Theme.ink.with-alpha(0.20)) : ta.has-hover ? (kind == PillKind.primary ? base.mix(Theme.ink, 0.9) : Theme.ink.with-alpha(0.20)) : base;
    border-width: kind == PillKind.quiet ? 1px : 0px; border-color: Theme.ink.with-alpha(0.16);
    opacity: enabled ? 1.0 : 0.5;
    accessible-role: button; accessible-label: label; accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    animate background { duration: Theme.dur-micro; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    row := HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 8px; alignment: center;
        if root.icon.width > 0 : Image {
            source: root.icon; width: Theme.icon-sm; height: Theme.icon-sm; y: (root.height - Theme.icon-sm) / 2;
            colorize: root.kind == PillKind.primary ? Theme.accent-ink : Theme.ink;
        }
        Text {
            text: root.label; font-size: Theme.fs-callout; font-weight: 600; vertical-alignment: center;
            color: root.kind == PillKind.primary ? Theme.accent-ink : Theme.ink;
        }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } return reject; }
    }
    FocusRing { active: fs.has-focus; radius: Theme.hit / 2; }
}

// Botão redondo de 48 sobre o palco (Ajustes, Voltar, Mais): fill simples de vidro (sem blur: nunca há conteúdo rolando atrás).
export component RoundButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    width: Theme.hit; height: Theme.hit; border-radius: Theme.hit / 2;
    background: Theme.ink.with-alpha(0.14);
    border-width: 1px; border-color: Theme.ink.with-alpha(0.16);
    drop-shadow-blur: Theme.e1-blur; drop-shadow-offset-y: Theme.e1-y; drop-shadow-color: Theme.e1-color;
    IconButton { icon: root.icon; label: root.label; tint: Theme.ink; active: root.active; clicked => { root.clicked(); } }
}

// Selo de origem: "Do YouTube Music" (ícone cloud + texto). Nada do logotipo do YouTube.
export component SourceTag inherits Rectangle {
    in property <string> text;
    // telas estreitas (< 380): só o ícone, para o título da seção caber (o rótulo completo continua no leitor de tela)
    property <bool> icon-only: Theme.window-w < 380px;
    height: 28px; border-radius: 14px;
    background: Theme.ink.with-alpha(0.12); border-width: 1px; border-color: Theme.ink.with-alpha(0.16);
    width: icon-only ? 36px : row.preferred-width;
    accessible-role: AccessibleRole.text; accessible-label: text;
    row := HorizontalLayout {
        padding-left: root.icon-only ? 10px : 10px; padding-right: 10px; spacing: 6px; alignment: center;
        Image { source: Icons.cloud; width: 16px; height: 16px; y: (root.height - 16px) / 2; colorize: Theme.ink; }
        if !root.icon-only : Text { text: root.text; font-size: Theme.fs-caption; font-weight: Theme.fw-caption; color: Theme.ink; vertical-alignment: center; }
    }
}

// Selo textual ("Ativo", "Em breve").
export component Tag inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    height: 26px; border-radius: 13px;
    background: accent ? Theme.accent : Theme.ink.with-alpha(0.12);
    width: t.preferred-width + 20px;
    accessible-role: text; accessible-label: label;
    t := Text { text: root.label; font-size: Theme.fs-caption; font-weight: Theme.fw-caption; color: root.accent ? Theme.accent-ink : Theme.ink; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
}

// Wordmark do canto superior esquerdo (SLINT_SPEC §3.4). Clicável: leva ao Início.
export component Logo inherits Rectangle {
    in property <bool> mark-only: false;
    in property <length> logo-height: 28px;
    callback clicked();
    height: Theme.hit;
    width: max(Theme.hit, mark-only ? logo-height + 8px : logo-height * 152 / 40 + 8px);   // alvo 48 mesmo com a marca de 36
    accessible-role: button; accessible-label: "Kazzu, ir para o Início";
    accessible-action-default => { root.clicked(); }
    property <length> lw: mark-only ? logo-height : logo-height * 152 / 40;
    Image { visible: !root.mark-only && Theme.dark;  source: @image-url("../assets/logo/kazzu-wordmark-dark.svg");  x: 4px; y: (parent.height - self.height) / 2; width: root.lw; height: root.logo-height; }
    Image { visible: !root.mark-only && !Theme.dark; source: @image-url("../assets/logo/kazzu-wordmark-light.svg"); x: 4px; y: (parent.height - self.height) / 2; width: root.lw; height: root.logo-height; }
    Image { visible: root.mark-only && Theme.dark;  source: @image-url("../assets/logo/kazzu-mark-dark.svg");  x: (root.width - root.lw) / 2; y: (parent.height - self.height) / 2; width: root.lw; height: root.logo-height; }
    Image { visible: root.mark-only && !Theme.dark; source: @image-url("../assets/logo/kazzu-mark-light.svg"); x: (root.width - root.lw) / 2; y: (parent.height - self.height) / 2; width: root.lw; height: root.logo-height; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } return reject; } }
    FocusRing { active: fs.has-focus; radius: 12px; }
}

// Pílula com opções (Tema, Qualidade, Cor de destaque). Altura 48, itens de 40, selecionado = ink / bg.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected: 0;          // o dono atualiza `selected` em `changed` (mantém a ligação com AppState)
    in property <string> label;
    callback changed(int);
    height: Theme.hit; border-radius: Theme.hit / 2;
    background: Theme.ink.with-alpha(0.12); border-width: 1px; border-color: Theme.ink.with-alpha(0.16);
    accessible-role: tab-list; accessible-label: label;
    fs := FocusScope { focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.RightArrow && root.selected < root.options.length - 1) { root.changed(root.selected + 1); return accept; }
            if (e.text == Key.LeftArrow && root.selected > 0) { root.changed(root.selected - 1); return accept; }
            return reject;
        }
    }
    HorizontalLayout {
        padding: 4px; spacing: 0px;
        for opt[i] in root.options : Rectangle {
            border-radius: 20px;
            background: i == root.selected ? Theme.ink : (ta.has-hover ? Theme.ink.with-alpha(0.10) : transparent);
            accessible-role: tab; accessible-label: opt; accessible-checked: i == root.selected;
            accessible-action-default => { root.changed(i); }
            animate background { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
            Text {
                text: opt; font-size: Theme.fs-subhead; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                color: i == root.selected ? Theme.bg : Theme.ink;
            }
            // alvo de toque de 48: o item tem 40, a área invisível ocupa os 4 px de folga acima e abaixo
            ta := TouchArea { y: -4px; height: parent.height + 8px; mouse-cursor: pointer; clicked => { root.changed(i); } }
            FocusRing { active: fs.has-focus && i == root.selected; radius: 20px; }
        }
    }
}

// Cabeçalho de seção: título (title-2) + SourceTag ou ação de texto à direita. Entre seções 28.
export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> source-tag;
    in property <string> action-label;
    callback action();
    height: Theme.hit;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.title; font-size: Theme.fs-title-2; font-weight: Theme.fw-title-2; letter-spacing: Theme.ls-title-2; color: Theme.ink; vertical-alignment: center; overflow: elide; accessible-role: text; }
        Rectangle { horizontal-stretch: 1; }
        if root.source-tag != "" : VerticalLayout { alignment: center; SourceTag { text: root.source-tag; } }
        if root.action-label != "" : TextButton { label: root.action-label; clicked => { root.action(); } }
    }
}

// Aviso dispensável (primeiro uso). Vidro nível 1.
export component Banner inherits GlassPanel {
    in property <string> title;
    in property <string> text;
    in property <image> icon: Icons.badge-check;
    in property <bool> dismissible: true;
    in property <string> dismiss-label: "Dispensar aviso";
    callback dismissed();
    level: 1; radius: 24px;
    height: max(88px, col.preferred-height + 32px);
    HorizontalLayout {
        padding: 16px; padding-right: 4px; spacing: 14px;
        VerticalLayout { alignment: start;
            Rectangle { width: 44px; height: 44px; border-radius: 22px; background: Theme.accent;
                Image { source: root.icon; width: 24px; height: 24px; x: 10px; y: 10px; colorize: Theme.accent-ink; }
            }
        }
        col := VerticalLayout { spacing: 4px; alignment: center; horizontal-stretch: 1;
            Text { text: root.title; font-size: Theme.fs-headline; font-weight: Theme.fw-headline; color: Theme.ink; wrap: word-wrap; accessible-role: AccessibleRole.text; }
            Text { text: root.text; font-size: Theme.fs-subhead; color: Theme.ink-2; wrap: word-wrap; accessible-role: AccessibleRole.text; }
        }
        if root.dismissible : VerticalLayout { alignment: start;
            IconButton { icon: Icons.close; label: root.dismiss-label; tint: Theme.ink; clicked => { root.dismissed(); } }
        }
    }
}

// Estado vazio / erro: vidro nível 1, ícone num quadrado de 88, título, texto (≈34 caracteres de medida), UMA ação.
export component EmptyState inherits GlassPanel {
    in property <image> icon;
    in property <string> title;
    in property <string> message;
    in property <string> action-label;
    in property <string> code;                 // texto técnico pequeno (mono), para relatar erros
    in property <PillKind> action-kind: PillKind.primary;   // quiet: ação secundária (Início offline)
    callback action();
    level: 1; radius: 28px;
    height: col.preferred-height + 56px;
    col := VerticalLayout {
        padding-top: 28px; padding-bottom: 28px; padding-left: 20px; padding-right: 20px; spacing: 12px; alignment: center;
        HorizontalLayout { alignment: center;
            Rectangle { width: 88px; height: 88px; border-radius: 28px; background: Theme.ink.with-alpha(0.12);
                Image { source: root.icon; width: 36px; height: 36px; x: 26px; y: 26px; colorize: Theme.ink; }
            }
        }
        Text { text: root.title; font-size: Theme.fs-title-2; font-weight: Theme.fw-title-2; letter-spacing: Theme.ls-title-2; color: Theme.ink; horizontal-alignment: center; wrap: word-wrap; accessible-role: text; }
        HorizontalLayout { alignment: center;
            Text { text: root.message; font-size: Theme.fs-body; color: Theme.ink-2; horizontal-alignment: center; wrap: word-wrap; max-width: 300px; accessible-role: AccessibleRole.text; }
        }
        if root.code != "" : Text { text: root.code; font-family: Theme.font-mono; font-size: Theme.fs-caption; color: Theme.ink-3; horizontal-alignment: center; wrap: word-wrap; accessible-role: text; }
        if root.action-label != "" : HorizontalLayout { alignment: center; padding-top: 8px;
            PillButton { kind: root.action-kind; label: root.action-label; clicked => { root.action(); } }
        }
    }
}

// Linha-esqueleto ESTÁTICA, mesma geometria da TrackRow (64): capa 52 e duas barras.
export component SkeletonRow inherits Rectangle {
    height: Theme.row-h;
    accessible-role: none;
    Rectangle { x: 8px; y: 6px; width: 52px; height: 52px; border-radius: 12px; background: Theme.ink.with-alpha(0.14); }
    Rectangle { x: 72px; y: 14px; width: (parent.width - 150px) * 0.55; height: 14px; border-radius: 7px; background: Theme.ink.with-alpha(0.14); }
    Rectangle { x: 72px; y: 36px; width: (parent.width - 150px) * 0.34; height: 12px; border-radius: 6px; background: Theme.ink.with-alpha(0.10); }
}

// Peça de esqueleto para carrosséis/grades (capa quadrada + 2 linhas).
export component SkeletonTile inherits Rectangle {
    in property <length> side: 148px;
    in property <length> radius: 24px;
    width: side; height: side + 56px;
    Rectangle { width: root.side; height: root.side; border-radius: root.radius; background: Theme.ink.with-alpha(0.14); }
    Rectangle { x: 0px; y: root.side + 12px; width: root.side * 0.8; height: 14px; border-radius: 7px; background: Theme.ink.with-alpha(0.14); }
    Rectangle { x: 0px; y: root.side + 34px; width: root.side * 0.5; height: 12px; border-radius: 6px; background: Theme.ink.with-alpha(0.10); }
}

// Faixa "Sem conexão" no topo da área de conteúdo (vidro nível 2). Quebra em duas linhas em telas estreitas.
export component OfflineBar inherits GlassPanel {
    level: 2; radius: 22px; height: max(44px, msg-col.preferred-height + 20px);
    accessible-role: text; accessible-label: "Sem conexão. Tocando só o que está no aparelho.";
    msg-col := HorizontalLayout {
        padding-left: 16px; padding-right: 16px; padding-top: 10px; padding-bottom: 10px; spacing: 10px; alignment: stretch;
        Image { source: Icons.cloud-off; width: 20px; height: 20px; y: (parent.height - 20px) / 2; colorize: Theme.ink; }
        Text { text: "Sem conexão. Tocando só o que está no aparelho."; font-size: Theme.fs-subhead; font-weight: 600; color: Theme.ink; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; accessible-role: none; }
    }
}

// Faixa de aviso que mantém o conteúdo (erro com cache): "Não deu para atualizar" + ação.
export component StaleBar inherits GlassPanel {
    in property <string> text: "Não deu para atualizar";
    in property <string> action-label: "Tentar de novo";
    callback action();
    level: 2; radius: 22px; height: 52px;
    HorizontalLayout {
        padding-left: 16px; padding-right: 4px; spacing: 10px; alignment: stretch;
        Image { source: Icons.info; width: 20px; height: 20px; y: (root.height - 20px) / 2; colorize: Theme.ink; }
        Text { text: root.text; font-size: Theme.fs-subhead; font-weight: 600; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        TextButton { label: root.action-label; y: (root.height - self.height) / 2; clicked => { root.action(); } }
    }
}

// Véu clicável atrás das folhas.
export component Scrim inherits Rectangle {
    callback clicked();
    background: Metrics.scrim;
    accessible-role: none;
    TouchArea { clicked => { root.clicked(); } }
}

// Aviso temporário (vidro nível 2, altura 52, raio 26). O Rust incrementa `toast-seq` a cada aviso; o Timer o esconde após
// 6 s (12 s com ação). Quem posiciona é o AppWindow (8 acima da reserva da barra).
export component Toast inherits GlassPanel {
    in property <string> message;
    in property <bool> error: false;
    in property <string> action-label;
    in property <int> seq: 0;
    in property <length> avail: 360px;
    callback action();
    callback dismissed();
    property <bool> shown: false;
    changed seq => { root.shown = root.message != ""; if (root.shown) { hide.restart(); } }
    level: 2; radius: 26px; height: 52px;
    visible: (shown && message != "") || self.opacity > 0.01;
    opacity: (shown && message != "") ? 1.0 : 0.0;
    animate opacity { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    width: min(avail - 32px, msg.preferred-width + (root.action-label != "" ? 120px : 0px) + 56px + (root.error ? 30px : 0px));
    accessible-role: text; accessible-label: message;
    hide := Timer { interval: root.action-label != "" ? 12s : 6s; running: false; triggered => { root.shown = false; self.running = false; root.dismissed(); } }
    HorizontalLayout {
        padding-left: 20px; padding-right: root.action-label != "" ? 6px : 20px; spacing: 10px; alignment: stretch;
        if root.error : Image { source: Icons.info; width: 20px; height: 20px; y: (root.height - 20px) / 2; colorize: Theme.danger; }
        msg := Text { text: root.message; font-size: Theme.fs-callout; font-weight: 600; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.action-label != "" : act := TextButton {
            label: root.action-label; ink: Theme.accent; y: (root.height - self.height) / 2;
            clicked => { root.shown = false; hide.running = false; root.action(); }
        }
    }
}
