import { AppState, Tab, Track } from "../theme/app-contract.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { MobilePalette } from "../theme/mobile-reference.slint";
import { Nav } from "../theme/nav-state.slint";
import { Rail } from "../components/shared.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, IconButton, Pressable, Tile } from "../components/atoms.slint";

component HomeHeading inherits Text {
    color: MobilePalette.ink;
    font-size: 19px;
    font-weight: 700;
    vertical-alignment: center;
    height: 30px;
}

component HomeArt inherits Rectangle {
    in property <int> index;
    background: @linear-gradient(160deg, MobilePalette.art-light[index], MobilePalette.art-dark[index]);
    border-radius: 14px;
}

export component MobileHome inherits Rectangle {
    background: MobilePalette.paper;
    property <bool> exploring: AppState.tab == Tab.explore;
    property <int> reset-seq: Metrics.scroll-top-seq;
    property <[Track]> shortcuts: AppState.quick-picks.length > 0 ? AppState.quick-picks : AppState.recents;
    property <length> column-w: min(root.width, 440px);
    property <length> tile-size: (root.column-w - 52px) / 3;
    property <length> scroll-target;

    function scroll-to(y: length) {
        root.scroll-target = -clamp(y, 0px, max(0px, feed.content-height - feed.height));
        if (Theme.reduce-motion) {
            feed.content-y = root.scroll-target;
        } else {
            scroll-animation.running = true;
        }
    }
    init => { if (root.exploring) { root.scroll-to(genres.y); } }
    changed exploring => { root.scroll-to(root.exploring ? genres.y : 0px); }
    changed reset-seq => { root.scroll-to(root.exploring ? genres.y : 0px); }
    scroll-animation := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            let remaining = root.scroll-target - feed.content-y;
            if (remaining >= -1px && remaining <= 1px) {
                feed.content-y = root.scroll-target;
                self.running = false;
            } else {
                feed.content-y += remaining * 0.22;
            }
        }
    }

    feed := Flickable {
        x: (root.width - root.column-w) / 2;
        y: 0;
        width: root.column-w;
        height: root.height;
        content-height: max(self.height, column.preferred-height);
        interactive: true;
        column := VerticalLayout {
            height: self.preferred-height;
            padding-top: AppState.safe-top + 14px;
            padding-bottom: max(210px, Metrics.reserve);
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            alignment: start;

            HorizontalLayout {
                height: 48px;
                Text { text: "kazzu"; color: MobilePalette.ink; font-size: 22px; font-weight: 800; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    width: 192px;
                    border-radius: 24px;
                    border-width: 1px;
                    border-color: MobilePalette.border;
                    background: MobilePalette.glass;
                    HorizontalLayout {
                        alignment: center;
                        IconButton { icon: Icons.clock; tint: MobilePalette.ink; icon-size: 20px; visual: 38px; label: "Histórico"; enabled: AppState.recents.length > 0; clicked => { root.scroll-to(history.y); } }
                        IconButton { icon: Icons.stats; tint: MobilePalette.ink; icon-size: 20px; visual: 38px; label: "Estatísticas"; clicked => { AppState.mobile-feature("As estatísticas"); } }
                        IconButton { icon: Icons.user; tint: MobilePalette.ink; icon-size: 20px; visual: 38px; label: "Conta e fontes"; clicked => { AppState.account-open = true; } }
                        Pressable {
                            width: 48px;
                            height: 48px;
                            label: "Ajustes";
                            clicked => { AppState.settings-section = -1; Nav.go(Tab.settings); }
                            Rectangle { width: 30px; height: 30px; border-radius: 15px; background: MobilePalette.pink; }
                            Text { text: "C"; color: MobilePalette.dark; font-size: 14px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                HomeHeading { text: "Sua próxima descoberta"; horizontal-stretch: 1; }
                if !AppState.online : Rectangle {
                    width: 68px; height: 28px; border-radius: 14px; background: MobilePalette.glass;
                    Text { text: "Offline"; color: MobilePalette.ink; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            HomeHeading { text: "Escolha rápida"; }
            Rectangle {
                height: 2 * root.tile-size + 10px;
                for slot in [0, 1, 2, 3, 4, 5] : Pressable {
                    x: mod(slot, 3) * (root.tile-size + 10px);
                    y: floor(slot / 3) * (root.tile-size + 10px);
                    width: root.tile-size;
                    height: root.tile-size;
                    ring-radius: 18px;
                    label: slot == 5 ? "Tocar aleatório" : slot < root.shortcuts.length ? root.shortcuts[slot].title : "";
                    enabled: slot == 5 ? root.shortcuts.length > 0 : slot < root.shortcuts.length;
                    clicked => {
                        if (slot == 5) {
                            AppState.play-random-shortcut();
                        } else if (slot < root.shortcuts.length) {
                            AppState.play-track(root.shortcuts[slot].id);
                        }
                    }
                    Rectangle {
                        border-radius: 18px;
                        background: MobilePalette.glass;
                        border-width: 1px;
                        border-color: MobilePalette.border;
                        clip: true;
                        if slot < 5 : HomeArt { index: slot; width: 100%; height: 100%; border-radius: 18px; }
                        if slot == 5 : Rectangle {
                            width: 46px;
                            height: 46px;
                            border-radius: 14px;
                            background: MobilePalette.island;
                            border-width: 1px;
                            border-color: MobilePalette.border;
                            for dot in [0, 1, 2, 3, 4] : Rectangle {
                                x: dot == 4 ? 20px : mod(dot, 2) == 0 ? 10px : 30px;
                                y: dot == 4 ? 20px : dot < 2 ? 10px : 30px;
                                width: 6px; height: 6px; border-radius: 3px;
                                background: MobilePalette.ink;
                            }
                        }
                        if slot < 5 && slot < root.shortcuts.length : Rectangle {
                            x: 6px; width: parent.width - 12px; y: parent.height - 29px; height: 23px;
                            border-radius: 10px;
                            background: MobilePalette.paper.with-alpha(0.74);
                            Text { width: parent.width - 10px; text: root.shortcuts[slot].title; color: MobilePalette.ink; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }

            if AppState.mixes.length > 0 : VerticalLayout {
                HomeHeading { text: "Mixes de músicas"; }
                Rail {
                    label: "Mixes de músicas";
                    card-h: 160px;
                    for mix in AppState.mixes : Tile {
                        size: 112px;
                        cover: mix.cover; title: mix.title; subtitle: mix.subtitle;
                        clicked => { AppState.open-item(mix.kind, mix.id); }
                    }
                }
            }

            genres := VerticalLayout {
                spacing: 10px;
                HomeHeading { text: "Explorar"; }
                Rectangle {
                    height: 188px;
                    for genre[i] in ["Rock", "Metal", "Alternativo", "Anos 90", "Trilhas", "Foco"] : Pressable {
                        property <length> card-w: (parent.width - 10px) / 2;
                        x: mod(i, 2) * (self.card-w + 10px);
                        y: floor(i / 2) * 66px;
                        width: self.card-w; height: 56px;
                        label: genre; ring-radius: 18px;
                        clicked => { AppState.search-text = genre; Nav.go(Tab.search); AppState.search(genre); }
                        Rectangle { border-radius: 18px; border-width: 1px; border-color: MobilePalette.border; background: MobilePalette.glass; }
                        Text { x: 12px; width: parent.width - 24px; text: genre; color: MobilePalette.ink; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    }
                }
            }

            history := HorizontalLayout {
                HomeHeading { text: "Continue ouvindo"; horizontal-stretch: 1; }
                Pressable {
                    width: 68px; height: 48px; label: "Ver tudo na biblioteca";
                    clicked => { Nav.go(Tab.library); }
                    Text { text: "Ver tudo"; color: MobilePalette.ink.with-alpha(0.64); font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            if AppState.recents.length == 0 : Text {
                text: "As faixas que você ouvir aparecem aqui.";
                color: MobilePalette.ink.with-alpha(0.64);
                font-size: 14px;
                wrap: word-wrap;
            }
            if AppState.recents.length > 0 : Flickable {
                height: 195px;
                content-width: cards.preferred-width;
                content-height: self.height;
                interactive: true;
                cards := HorizontalLayout {
                    width: self.preferred-width;
                    spacing: 10px;
                    for track[i] in AppState.recents : Pressable {
                        width: 150px; height: 195px; label: track.title; ring-radius: 18px;
                        clicked => { AppState.play-track(track.id); }
                        Rectangle { background: MobilePalette.glass; border-width: 1px; border-color: MobilePalette.border; border-radius: 18px; }
                        VerticalLayout {
                            padding: 10px; spacing: 5px;
                            HomeArt { height: 130px; index: mod(i, 6); }
                            Text { text: track.title; color: MobilePalette.ink; font-size: 14px; font-weight: 700; overflow: elide; }
                            Text { text: track.artist; color: MobilePalette.ink.with-alpha(0.65); font-size: 12px; overflow: elide; }
                        }
                    }
                }
            }
        }
    }
}
