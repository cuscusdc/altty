// Detalhe (Android): página empilhada com herói de capa, ações grandes e lista de faixas virtualizada.
import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, DetailKind, LoadState } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Icon, IconButton, Cover, Button, TextButton, Tile, TrackRow, SectionHeader, StateCard } from "../components/atoms.slint";
import { Rail, Rows, Gutters, AlbumGrid, SkeletonRows } from "../components/shared.slint";
import { MobileTopBar } from "chrome.slint";

export component MobileDetail inherits Rectangle {
    property <bool> expanded-description: false;
    property <length> art-size: min(240px, root.width - 80px);
    property <length> hero-h: root.art-size + 240px;
    property <bool> scrolled: -Metrics.scroll-detail > 120px;
    fl := Flickable {
        interactive: true;
        init => { Metrics.scroll-detail = 0px; }
        changed content-y => { Metrics.scroll-detail = self.content-y; }
        VerticalLayout {
            padding-bottom: Metrics.reserve;
            spacing: Theme.s-xl;
            alignment: start;
            Rectangle {
                height: root.hero-h + AppState.safe-top;
                clip: true;
                Image { source: AppState.detail-cover; width: 100%; height: 100%; image-fit: ImageFit.cover; opacity: Theme.reduce-transparency ? 0 : 0.18; }
                Rectangle { background: @linear-gradient(180deg, Theme.paper.with-alpha(0.45) 0%, Theme.paper.with-alpha(0.75) 55%, Theme.paper 100%); }
                IconButton { x: Theme.gutter; y: AppState.safe-top + Theme.s-xs; icon: Icons.chevron-left; tonal: true; label: "Voltar"; clicked => { Nav.close-detail(); } }
                Cover {
                    x: (root.width - root.art-size) / 2;
                    y: AppState.safe-top + 64px;
                    size: root.art-size;
                    radius: AppState.detail-kind == DetailKind.artist ? root.art-size / 2 : Theme.r-card;
                    source: AppState.detail-cover;
                    drop-shadow-blur: 24px;
                    drop-shadow-offset-y: 12px;
                    drop-shadow-color: Theme.glass-shadow;
                }
                VerticalLayout {
                    x: Theme.gutter;
                    y: AppState.safe-top + root.art-size + 80px;
                    width: root.width - 2 * Theme.gutter;
                    height: 136px;
                    alignment: center;
                    spacing: Theme.s-xs;
                    Text { text: AppState.detail-kind == DetailKind.artist ? "ARTISTA" : AppState.detail-kind == DetailKind.albums ? "COLEÇÃO" : "SUA TRILHA SONORA"; color: Theme.accent; font-size: Theme.text-xs; letter-spacing: 1.4px; font-weight: 600; horizontal-alignment: center; }
                    Text { text: AppState.detail-title; color: Theme.ink; font-family: Theme.font-display; font-size: 28px; font-weight: 700; overflow: elide; horizontal-alignment: center; }
                    Text { text: AppState.detail-subtitle; color: Theme.ink-2; font-size: Theme.text-md; overflow: elide; horizontal-alignment: center; }
                    if AppState.detail-source != "" : Text { text: AppState.detail-source; color: Theme.muted; font-size: Theme.text-sm; overflow: elide; horizontal-alignment: center; }
                }
            }
            if AppState.detail-state == LoadState.ready && AppState.detail-kind != DetailKind.albums && AppState.detail-tracks.length > 0 : Gutters {
                HorizontalLayout {
                    spacing: Theme.s-sm;
                    if AppState.detail-can-play : Button { text: "Tocar"; icon: Icons.play; has-icon: true; primary: true; horizontal-stretch: 1; clicked => { AppState.play-all(); } }
                    if AppState.detail-can-play : Button { text: "Aleatório"; icon: Icons.shuffle; has-icon: true; horizontal-stretch: 1; clicked => { AppState.shuffle-all(); } }
                    if AppState.detail-can-save : IconButton { icon: AppState.detail-saved ? Icons.heart-fill : Icons.heart; tint: AppState.detail-saved ? Theme.accent : Theme.ink; tonal: true; label: AppState.detail-saved ? "Remover da Biblioteca" : "Salvar na Biblioteca"; clicked => { AppState.toggle-detail-saved(); } }
                }
            }
            if AppState.detail-state == LoadState.loading : SkeletonRows { count: 6; }
            if AppState.detail-state == LoadState.error || AppState.detail-state == LoadState.offline : Gutters {
                StateCard { icon: Icons.cloud-off; title: AppState.detail-state == LoadState.offline ? "Você está offline" : "Não deu para carregar"; text: AppState.detail-error-text; primary: "Tentar de novo"; primary-clicked => { AppState.retry-detail(); } }
            }
            if AppState.detail-state == LoadState.empty : Gutters {
                StateCard { icon: Icons.disc; title: "Este espaço ainda está vazio"; text: AppState.detail-empty-text; }
            }
            if AppState.detail-state == LoadState.ready && AppState.detail-kind == DetailKind.albums : AlbumGrid { albums: AppState.detail-albums; }
            if AppState.detail-state == LoadState.ready && AppState.detail-kind != DetailKind.albums && AppState.detail-tracks.length > 0 : VerticalLayout {
                spacing: Theme.s-xs;
                SectionHeader { title: AppState.detail-kind == DetailKind.artist ? "Músicas" : "Faixas"; }
                Rectangle {
                    height: min(640px, AppState.detail-tracks.length * Theme.row-h);
                    ListView {
                        for t[i] in AppState.detail-tracks : TrackRow {
                            x: Theme.gutter;
                            width: parent.width - 2 * Theme.gutter;
                            t: t;
                            more: !t.id.starts-with("sp:");
                            number: i + 1;
                            separator: false;
                            clicked => { AppState.play-track(t.id); }
                            more-clicked => { Nav.open-menu(t); }
                        }
                    }
                }
                Gutters { Text { text: AppState.detail-tracks.length + " músicas"; color: Theme.ink-2; font-size: Theme.text-sm; } }
            }
            if AppState.detail-kind == DetailKind.artist && AppState.detail-albums.length > 0 : VerticalLayout {
                spacing: Theme.s-xs;
                SectionHeader { title: "Discografia"; }
                Rail {
                    label: "Discografia";
                    card-h: 148px + 52px;
                    for a in AppState.detail-albums : Tile { cover: a.cover; title: a.title; subtitle: a.artist; clicked => { AppState.open-album(a.id); } }
                }
            }
            if AppState.detail-state == LoadState.ready && AppState.detail-description != "" : VerticalLayout {
                SectionHeader { title: "Sobre"; }
                Gutters {
                    VerticalLayout {
                        spacing: Theme.s-xs;
                        Rectangle {
                            height: root.expanded-description ? description.preferred-height : min(100px, description.preferred-height);
                            clip: true;
                            description := Text { width: parent.width; height: self.preferred-height; text: AppState.detail-description; color: Theme.ink-2; font-size: Theme.text-md; wrap: word-wrap; }
                        }
                        TextButton { width: 120px; text: root.expanded-description ? "Recolher" : "Ler mais"; clicked => { root.expanded-description = !root.expanded-description; } }
                    }
                }
            }
            if AppState.detail-state == LoadState.ready && AppState.detail-related.length > 0 : VerticalLayout {
                SectionHeader { title: "Continue explorando"; }
                Rail {
                    label: "Conteúdo relacionado";
                    card-h: 148px + 52px;
                    for r in AppState.detail-related : Tile { round: r.kind == "artist"; cover: r.cover; title: r.title; subtitle: r.subtitle; clicked => { AppState.open-item(r.kind, r.id); } }
                }
            }
        }
    }
    MobileTopBar {
        title: AppState.detail-title;
        back: true;
        settings: false;
        scrolled: true;
        shown: root.scrolled;
        safe-top: AppState.safe-top;
        back-clicked => { Nav.close-detail(); }
    }
}
