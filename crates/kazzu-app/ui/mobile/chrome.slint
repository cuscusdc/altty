// Cromo do Android: barra de topo translúcida (ganha vidro ao rolar) e uma única cápsula flutuante com
// mini-player + três destinos. Um só botão de Ajustes, sempre no topo.
import { MobilePalette } from "../theme/mobile-reference.slint";
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState, Tab, Track } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Glass, Pressable, Icon, IconButton } from "../components/atoms.slint";

export component MobileTopBar inherits Rectangle {
    in property <string> title;          // vazio = marca
    in property <bool> back: false;
    in property <bool> settings: true;
    in property <bool> scrolled: false;  // conteúdo passou por baixo: vidro de verdade
    in property <bool> shown: true;
    in property <length> safe-top: 0px;
    callback back-clicked();
    height: Theme.header-h + safe-top;
    visible: root.shown || self.opacity > 0.01;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.dur-short; }
    if root.scrolled && root.shown : Glass { radius: 0px; shadow: false; }
    if root.back : IconButton {
        x: Theme.gutter - 12px;
        y: root.safe-top;
        icon: Icons.chevron-left;
        label: "Voltar";
        clicked => { root.back-clicked(); }
    }
    if !root.back && root.title == "" : Image {
        x: Theme.gutter;
        y: root.safe-top + 12px;
        width: 26px * 153 / 40;
        height: 26px;
        source: Theme.dark ? @image-url("../assets/kazzu-wordmark-dark.svg") : @image-url("../assets/kazzu-wordmark-light.svg");
        accessible-role: AccessibleRole.text;
        accessible-label: "Kazzu";
    }
    if !root.back && root.title != "" : Text {
        x: Theme.gutter;
        y: root.safe-top;
        width: parent.width - 2 * Theme.gutter - 56px;
        height: Theme.header-h;
        text: root.title;
        color: Theme.ink;
        font-family: Theme.font-display;
        font-size: Theme.text-xl;
        font-weight: 700;
        letter-spacing: -0.3px;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.back && root.title != "" : Text {
        x: 56px;
        y: root.safe-top;
        width: parent.width - 56px - Theme.gutter;
        height: Theme.header-h;
        text: root.title;
        color: Theme.ink;
        font-size: Theme.text-lg;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.settings && !root.back : IconButton {
        x: parent.width - Theme.gutter - 40px;
        y: root.safe-top;
        icon: Icons.gear;
        tonal: true;
        label: "Ajustes";
        clicked => { Nav.go(Tab.settings); }
    }
}

component IslandTab inherits Pressable {
    in property <string> text;
    in property <image> icon;
    in property <bool> on;
    label: text;
    accessible-role: tab;
    accessible-item-selected: on;
    horizontal-stretch: 1;
    Rectangle { border-radius: 24px; background: root.on ? MobilePalette.ink.with-alpha(0.16) : transparent; }
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout { alignment: center; Icon { source: root.icon; tint: MobilePalette.ink; size: 22px; } }
        Text { text: root.text; color: MobilePalette.ink; font-size: 11px; font-weight: root.on ? 700 : 500; horizontal-alignment: center; }
    }
}

export component MobileDock inherits Rectangle {
    property <length> island-w: min(root.width - 24px, 440px);
    height: (AppState.has-now ? 66px : 0px) + 70px + AppState.safe-bottom;
    VerticalLayout {
        x: (root.width - root.island-w) / 2;
        width: root.island-w;
        height: root.height;
        padding-bottom: 12px + AppState.safe-bottom;
        spacing: 8px;
        if AppState.has-now : Rectangle {
            height: 58px;
            border-radius: 29px;
            background: Theme.glass-on ? MobilePalette.island.with-alpha(0.82) : MobilePalette.island;
            backdrop-blur: Theme.glass-on ? 18px : 0px;
            border-width: 1px;
            border-color: MobilePalette.border;
            clip: true;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 3px;
                Pressable {
                    horizontal-stretch: 1;
                    label: "Abrir player: " + AppState.now.title;
                    clicked => { Nav.open-player(); }
                    HorizontalLayout {
                        spacing: 7px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 42px; height: 42px; border-radius: 21px;
                                background: MobilePalette.cover;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: AppState.now.title; color: MobilePalette.ink; font-size: 14px; font-weight: 700; overflow: elide; }
                            Text { text: AppState.now.artist; color: MobilePalette.ink.with-alpha(0.64); font-size: 12px; overflow: elide; }
                        }
                    }
                }
                VerticalLayout { alignment: center; IconButton { icon: Icons.prev; icon-size: 18px; label: "Anterior"; tint: MobilePalette.ink; clicked => { AppState.previous(); } } }
                VerticalLayout { alignment: center; IconButton { icon: AppState.playing ? Icons.pause : Icons.play; icon-size: 20px; label: AppState.playing ? "Pausar" : "Tocar"; tint: MobilePalette.ink; clicked => { AppState.toggle-play(); } } }
                VerticalLayout { alignment: center; IconButton { icon: Icons.next; icon-size: 18px; label: "Próxima"; tint: MobilePalette.ink; clicked => { AppState.next(); } } }
                VerticalLayout { alignment: center; IconButton { icon: AppState.now.liked ? Icons.heart-fill : Icons.heart; icon-size: 18px; label: AppState.now.liked ? "Descurtir" : "Curtir"; tint: AppState.now.liked ? MobilePalette.pink : MobilePalette.ink; clicked => { AppState.toggle-like(AppState.now.id); } } }
            }
            Rectangle {
                x: 19px; y: parent.height - 2px; width: parent.width - 38px; height: 2px;
                background: MobilePalette.border;
                Rectangle { x: 0; width: parent.width * AppState.progress; height: 100%; background: MobilePalette.pink; }
            }
        }
        HorizontalLayout {
            height: 58px;
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 29px; border-width: 1px; border-color: MobilePalette.border;
                background: Theme.glass-on ? MobilePalette.island.with-alpha(0.82) : MobilePalette.island;
                backdrop-blur: Theme.glass-on ? 18px : 0px;
                HorizontalLayout {
                    padding: 4px;
                    IslandTab { text: "Início"; icon: Icons.home; on: AppState.tab == Tab.home; clicked => { Nav.go(Tab.home); } }
                    IslandTab { text: "Explorar"; icon: Icons.explore; on: AppState.tab == Tab.explore; clicked => { Nav.go(Tab.explore); } }
                    IslandTab { text: "Biblioteca"; icon: Icons.library; on: AppState.tab == Tab.library; clicked => { Nav.go(Tab.library); } }
                }
            }
            Pressable {
                width: 58px; height: 58px; label: "Buscar";
                clicked => { Nav.go(Tab.search); }
                Rectangle { border-radius: 29px; border-width: 1px; border-color: MobilePalette.border; background: AppState.tab == Tab.search ? MobilePalette.ink.with-alpha(0.25) : MobilePalette.island; }
                Icon { source: Icons.search; tint: MobilePalette.ink; size: 24px; }
            }
        }
    }
}
