import { ListView } from "std-widgets.slint";
import { AppState, RepeatMode, Track } from "../theme/app-contract.slint";
import { Icons } from "../theme/icons.slint";
import { MobilePalette } from "../theme/mobile-reference.slint";
import { Nav } from "../theme/nav-state.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, IconButton, Pressable, Scrubber } from "../components/atoms.slint";

component PlayerAction inherits Pressable {
    in property <image> icon;
    height: 48px;
    horizontal-stretch: 1;
    Rectangle { height: 42px; border-radius: 14px; background: MobilePalette.cream.with-alpha(root.pressed || root.hovered ? 0.18 : 0.1); }
    Icon { source: root.icon; tint: MobilePalette.cream; size: 20px; }
}

component MobileQueueRow inherits Pressable {
    in property <Track> track;
    in property <bool> current;
    in property <int> tone;
    height: 58px;
    label: track.title + ", " + track.artist;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px; height: 42px; border-radius: 10px;
                background: @linear-gradient(145deg, MobilePalette.art-light[root.tone], MobilePalette.art-dark[root.tone]);
            }
        }
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            Text { text: root.track.title; color: MobilePalette.cream; font-size: 14px; font-weight: root.current ? 700 : 500; overflow: elide; }
            Text { text: root.track.artist + " · " + root.track.duration-label; color: MobilePalette.cream.with-alpha(0.68); font-size: 12px; overflow: elide; }
        }
    }
}

export component MobilePlayer inherits Rectangle {
    background: MobilePalette.player;
    clip: true;
    property <length> column-w: min(root.width, 440px);
    property <length> cover-size: min(290px, root.column-w * 0.78);
    property <length> header-height: AppState.safe-top + 54px;

    stage := Flickable {
        x: (root.width - root.column-w) / 2;
        y: root.header-height;
        width: root.column-w;
        height: root.height - root.header-height;
        content-height: max(self.height, content.preferred-height);
        interactive: true;
        content := VerticalLayout {
            height: max(stage.height, self.preferred-height);
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 6px;
            padding-bottom: 14px + AppState.safe-bottom;
            spacing: 14px;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.cover-size; height: root.cover-size;
                    border-radius: 24px;
                    background: MobilePalette.player-cover;
                    drop-shadow-color: MobilePalette.dark.with-alpha(0.3);
                    drop-shadow-offset-y: 9px;
                    drop-shadow-blur: 22px;
                    VerticalLayout {
                        y: parent.height - 84px;
                        height: 60px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 4px;
                        alignment: end;
                        Text { text: AppState.now.album.to-uppercase(); color: MobilePalette.dark.with-alpha(0.82); font-size: 12px; font-weight: 700; letter-spacing: 4px; horizontal-alignment: center; overflow: elide; }
                        Text { text: AppState.now.album; color: MobilePalette.dark; font-family: "Georgia"; font-size: 26px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1; alignment: center; spacing: 4px;
                    Text { text: AppState.now.title; color: MobilePalette.cream; font-size: 21px; font-weight: 700; overflow: elide; }
                    Text { text: AppState.now.artist; color: MobilePalette.cream.with-alpha(0.7); font-size: 14px; overflow: elide; }
                }
                IconButton {
                    icon: @image-url("../assets/icons/share.svg");
                    icon-size: 18px; visual: 38px; media: true; on: true; tint: MobilePalette.cream;
                    label: "Compartilhar";
                    clicked => { AppState.mobile-feature("O compartilhamento de faixas"); }
                }
                Pressable {
                    width: 48px; height: 48px;
                    ring-color: MobilePalette.cream;
                    label: AppState.now.liked ? "Descurtir" : "Curtir";
                    clicked => { AppState.toggle-like(AppState.now.id); }
                    Rectangle { width: 38px; height: 38px; border-radius: 12px; background: MobilePalette.cream; }
                    Icon { source: AppState.now.liked ? Icons.heart-fill : Icons.heart; tint: AppState.now.liked ? MobilePalette.pink : MobilePalette.dark; size: 20px; }
                }
            }
            Rectangle {
                height: controls.preferred-height;
                border-radius: 28px;
                border-width: 1px;
                border-color: MobilePalette.border;
                background: Theme.glass-on ? MobilePalette.player-island.with-alpha(0.85) : MobilePalette.player-island;
                backdrop-blur: Theme.glass-on ? 24px : 0px;
                drop-shadow-color: MobilePalette.dark.with-alpha(0.4);
                drop-shadow-offset-y: 10px;
                drop-shadow-blur: 23px;
                controls := VerticalLayout {
                    padding-left: 14px; padding-right: 14px; padding-top: 4px; padding-bottom: 10px;
                    spacing: 6px;
                    VerticalLayout {
                        Rectangle {
                            height: 48px;
                            Scrubber { value: AppState.progress; label: "Posição da faixa"; value-text: AppState.position-label; seek(v) => { AppState.seek(v); } }
                            Rectangle {
                                x: clamp(parent.width * AppState.progress - 7px, 0px, parent.width - 14px);
                                width: 14px; height: 14px; border-radius: 7px;
                                background: MobilePalette.cream;
                                drop-shadow-color: MobilePalette.cream.with-alpha(0.45);
                                drop-shadow-blur: 6px;
                            }
                        }
                        HorizontalLayout {
                            Text { text: AppState.position-label; color: MobilePalette.cream; font-size: 13px; horizontal-stretch: 1; }
                            Text { text: AppState.now.duration-label != "" ? AppState.now.duration-label : AppState.remaining-label; color: MobilePalette.cream; font-size: 13px; horizontal-alignment: right; }
                        }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout { alignment: center; IconButton { icon: Icons.shuffle; tint: AppState.shuffle ? MobilePalette.pink : MobilePalette.cream; on: AppState.shuffle; media: true; label: AppState.shuffle ? "Desativar aleatório" : "Ativar aleatório"; clicked => { AppState.toggle-shuffle(); } } }
                        VerticalLayout { alignment: center; IconButton { icon: Icons.prev; icon-size: 26px; tint: MobilePalette.cream; label: "Anterior"; clicked => { AppState.previous(); } } }
                        Pressable {
                            width: 64px; height: 64px;
                            label: AppState.playing ? "Pausar" : "Tocar";
                            clicked => { AppState.toggle-play(); }
                            Rectangle { border-radius: 32px; background: MobilePalette.cream; drop-shadow-color: MobilePalette.dark.with-alpha(0.34); drop-shadow-offset-y: 5px; drop-shadow-blur: 12px; }
                            Icon { source: AppState.playing ? Icons.pause : Icons.play; tint: MobilePalette.dark; size: 34px; }
                        }
                        VerticalLayout { alignment: center; IconButton { icon: Icons.next; icon-size: 26px; tint: MobilePalette.cream; label: "Próxima"; clicked => { AppState.next(); } } }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.repeat;
                                tint: AppState.repeat == RepeatMode.off ? MobilePalette.cream : MobilePalette.pink;
                                on: AppState.repeat != RepeatMode.off;
                                badge: AppState.repeat == RepeatMode.one ? "1" : "";
                                media: true;
                                label: AppState.repeat == RepeatMode.off ? "Repetição desligada" : AppState.repeat == RepeatMode.one ? "Repetir faixa" : "Repetir fila";
                                clicked => { AppState.cycle-repeat(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        VerticalLayout { alignment: center; Icon { source: Icons.vol-low; tint: MobilePalette.cream; size: 16px; } }
                        Scrubber {
                            value: AppState.volume;
                            label: "Volume";
                            value-text: Math.round(AppState.volume * 100) + "%";
                            seek(v) => { AppState.set-volume(v); }
                        }
                        VerticalLayout { alignment: center; Icon { source: Icons.vol-high; tint: MobilePalette.cream; size: 16px; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        PlayerAction { icon: Icons.queue; label: "Fila"; clicked => { AppState.queue-open = true; } }
                        PlayerAction { icon: Icons.lyrics; label: "Letras"; clicked => { AppState.mobile-lyrics-open = true; } }
                        PlayerAction { icon: Icons.timer; label: "Temporizador de sono"; clicked => { AppState.set-sleep-timer(30); } }
                        PlayerAction { icon: Icons.more; label: "Mais ações"; clicked => { Nav.open-menu(AppState.now); } }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Pressable {
                            width: 164px; height: 48px; label: "Saída de áudio";
                            clicked => { AppState.open-output-picker(); }
                            Rectangle { height: 32px; border-radius: 16px; background: MobilePalette.cream.with-alpha(0.1); }
                            HorizontalLayout {
                                alignment: center; spacing: 8px;
                                Icon { source: Icons.device; tint: MobilePalette.cream; size: 15px; }
                                Text { text: "Este celular"; color: MobilePalette.cream; font-size: 13px; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: (root.width - root.column-w) / 2;
        y: AppState.safe-top + 6px;
        width: root.column-w;
        height: 48px;
        IconButton {
            x: 16px;
            icon: Icons.chevron-down; icon-size: 22px; tint: MobilePalette.cream; visual: 40px;
            label: AppState.queue-open ? "Recolher fila" : "Recolher player";
            clicked => { if (AppState.queue-open) { AppState.queue-open = false; } else { Nav.close-player(); } }
        }
        IconButton {
            x: parent.width - 64px;
            icon: Icons.more; icon-size: 22px; tint: MobilePalette.cream; visual: 40px;
            label: "Opções";
            clicked => { Nav.open-menu(AppState.now); }
        }
        Rectangle {
            width: 170px; height: 38px; border-radius: 19px;
            background: MobilePalette.dark.with-alpha(0.45);
            HorizontalLayout {
                padding: 3px;
                Pressable {
                    horizontal-stretch: 1; label: "Áudio"; accessible-role: tab; accessible-item-selected: true;
                    Rectangle { border-radius: 16px; background: MobilePalette.cream; }
                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Icon { source: Icons.lyrics; tint: MobilePalette.dark; size: 15px; }
                        Text { text: "Áudio"; color: MobilePalette.dark; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                    }
                }
                Pressable {
                    horizontal-stretch: 1; label: "Vídeo"; accessible-role: tab;
                    clicked => { AppState.mobile-feature("A reprodução de vídeo"); }
                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Icon { source: @image-url("../assets/icons/video.svg"); tint: MobilePalette.cream; size: 15px; }
                        Text { text: "Vídeo"; color: MobilePalette.cream; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    if AppState.queue-open : TouchArea {
        y: root.header-height;
        height: parent.height - self.y;
        clicked => { AppState.queue-open = false; }
    }
    Rectangle {
        x: (root.width - root.column-w) / 2;
        y: AppState.queue-open ? root.height - self.height : root.height;
        width: root.column-w;
        height: root.height * 0.6;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        background: MobilePalette.queue;
        clip: true;
        animate y { duration: Theme.reduce-motion ? 0ms : 300ms; }
        VerticalLayout {
            padding: 16px; padding-bottom: 12px + AppState.safe-bottom;
            spacing: 6px;
            HorizontalLayout {
                Text { text: "Próximas na fila"; color: MobilePalette.cream.with-alpha(0.7); font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { icon: Icons.close; tint: MobilePalette.cream; label: "Fechar fila"; clicked => { AppState.queue-open = false; } }
            }
            if AppState.queue-open && AppState.has-now : MobileQueueRow { track: AppState.now; current: true; tone: 0; clicked => { AppState.queue-open = false; } }
            if AppState.queue-open : ListView {
                for song[i] in AppState.queue : MobileQueueRow {
                    track: song; tone: mod(i + 1, 6);
                    clicked => { AppState.queue-jump(song.id); AppState.queue-open = false; }
                }
            }
        }
    }
    if AppState.mobile-lyrics-open : Rectangle {
        width: 100%;
        height: 100%;
        background: MobilePalette.player-scrim;
        TouchArea { clicked => { AppState.mobile-lyrics-open = false; } }
        Rectangle {
            width: min(380px, parent.width - 48px);
            height: lyrics.preferred-height;
            border-radius: 24px;
            background: MobilePalette.player-island;
            TouchArea {}
            lyrics := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: "Letra da música"; color: MobilePalette.cream; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: Icons.close; tint: MobilePalette.cream; label: "Fechar letra"; clicked => { AppState.mobile-lyrics-open = false; } }
                }
                Text { text: "Ainda sem letra disponível"; color: MobilePalette.cream.with-alpha(0.72); font-size: 16px; wrap: word-wrap; }
            }
        }
    }
}
