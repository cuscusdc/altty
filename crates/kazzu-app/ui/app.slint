// Janela raiz do Kazzu (v2, mobile-first). UMA árvore: o celular (compact < 600) é a base; `if !Theme.compact` só acrescenta.
import "assets/fonts/HankenGrotesk-Regular.ttf";
import "assets/fonts/HankenGrotesk-SemiBold.ttf";
import "assets/fonts/HankenGrotesk-Bold.ttf";
import "assets/fonts/GeistMono-Regular.ttf";
import "assets/fonts/GeistMono-Medium.ttf";

import { Palette } from "std-widgets.slint";
import { Theme } from "theme/tokens.slint";
import { Icons } from "theme/icons.slint";
import { Metrics } from "theme/metrics.slint";
import { Nav } from "theme/nav-state.slint";
import { AppState, Tab, RepeatMode, SearchState, ThemeMode, AccentMode, DetailKind, LoadState, HomeSection, Track, Album, Highlight, Artist, Playlist, Collection, OutputDevice, ProviderRow } from "theme/app-contract.slint";
import { Stage, GlassPanel } from "theme/atoms.slint";
import { NavDock, SearchButton, MiniPlayer, NavRail, NowBar } from "components/nav.slint";
import { Toast, Scrim, TextButton, PillButton, PillKind } from "components/basics.slint";
import { MenuSheet, PlaylistSheet, NewPlaylistSheet, QueueSheet } from "components/sheets.slint";
import { HomeScreen } from "screens/home.slint";
import { ExploreScreen } from "screens/explore.slint";
import { LibraryScreen } from "screens/library.slint";
import { SearchScreen } from "screens/search.slint";
import { SettingsScreen } from "screens/settings.slint";
import { DetailScreen } from "screens/detail.slint";
import { PlayerScreen } from "screens/player.slint";

export { Metrics, Nav, Theme, AppState, Tab, RepeatMode, SearchState, ThemeMode, AccentMode, DetailKind, LoadState, HomeSection, Track, Album, Highlight, Artist, Playlist, Collection, OutputDevice, ProviderRow }

export component AppWindow inherits Window {
    title: "Kazzu";
    icon: @image-url("assets/icon-256.png");
    default-font-family: Theme.font-sans;
    background: Theme.bg;
    min-width: 320px; min-height: 480px;
    preferred-width: 390px; preferred-height: 844px;

    init => { Theme.window-w = self.width; copy-insets(); apply-theme(); apply-accent(); keys.focus(); }
    // Áreas seguras: o backend (Android) alimenta Window.safe-area-inset-*; a UI só lê AppState.safe-* (a gallery pode forçar).
    function copy-insets() {
        AppState.safe-top = self.safe-area-insets.top; AppState.safe-bottom = self.safe-area-insets.bottom;
        AppState.safe-left = self.safe-area-insets.left; AppState.safe-right = self.safe-area-insets.right;
    }
    property <length> inset-t: self.safe-area-insets.top;
    property <length> inset-b: self.safe-area-insets.bottom;
    property <length> inset-l: self.safe-area-insets.left;
    property <length> inset-r: self.safe-area-insets.right;
    changed inset-t => { AppState.safe-top = self.inset-t; }
    changed inset-b => { AppState.safe-bottom = self.inset-b; }
    changed inset-l => { AppState.safe-left = self.inset-l; }
    changed inset-r => { AppState.safe-right = self.inset-r; }
    changed width => { Theme.window-w = self.width; }

    // Tema: "Auto" segue o sistema (Palette do Slint); Claro/Escuro são fixos. O Rust chama apply-theme ao mudar a preferência.
    property <bool> sys-dark: Palette.color-scheme != ColorScheme.light;
    changed sys-dark => { root.apply-theme(); }
    property <ThemeMode> cur-mode: AppState.theme-mode;
    changed cur-mode => { root.apply-theme(); }
    public function apply-theme() {
        Theme.dark = AppState.theme-mode == ThemeMode.dark || (AppState.theme-mode == ThemeMode.auto && root.sys-dark);
        root.apply-accent();
    }
    // Acento da capa: o AppWindow escolhe a variante do tema vigente (globais não têm bindings cruzados).
    property <bool> dark-now: Theme.dark;
    changed dark-now => { root.apply-accent(); }
    public function apply-accent() {
        Theme.dynamic-accent = Theme.dark ? AppState.accent-dark : AppState.accent-light;
        Theme.dynamic-accent-ink = Theme.dark ? AppState.accent-dark-ink : AppState.accent-light-ink;
    }
    /// Voltar (Esc; o Rust chama no botão Voltar do Android). false = já está no Início sem nada aberto (o sistema sai do app).
    public function go-back() -> bool { return Nav.back(); }

    // O foco volta ao atalho global quando algo abre/fecha (sem isso Espaço/setas ficariam mudos). A Busca pede o foco ao campo.
    property <Tab> cur-tab: AppState.tab;
    property <bool> cur-player: AppState.player-open;
    property <bool> cur-queue: AppState.queue-open;
    property <bool> cur-detail: AppState.detail-open;
    changed cur-tab => { if (AppState.tab != Tab.search) { keys.focus(); } }
    changed cur-player => { keys.focus(); }
    changed cur-queue => { keys.focus(); }
    changed cur-detail => { keys.focus(); }

    // posições das paradas dos esvaecimentos (fração da altura de cada um)
    property <float> top-stop: AppState.safe-top / (AppState.safe-top + 24px);
    property <float> fade-s1: 178px / Metrics.fade-h;
    property <float> fade-s2: 190px / Metrics.fade-h;
    property <bool> sheet-up: AppState.queue-open || AppState.menu-open || AppState.playlist-sheet-open || AppState.new-playlist-open;

    keys := FocusScope {
        width: 100%; height: 100%;
        key-pressed(e) => {
            // Esc (desktop) e Voltar do Android (Key.Back): só "accept" se algo foi fechado; senão o sistema fecha o app
            if (e.text == Key.Escape || e.text == Key.Back) { return root.go-back() ? accept : reject; }
            if (e.text == " ") { AppState.toggle-play(); return accept; }
            if (e.text == Key.LeftArrow) { AppState.seek-relative(-5); return accept; }
            if (e.text == Key.RightArrow) { AppState.seek-relative(5); return accept; }
            if (e.text == Key.UpArrow) { AppState.volume-step(1); return accept; }
            if (e.text == Key.DownArrow) { AppState.volume-step(-1); return accept; }
            return reject;
        }

        // palco vivo: atrás de tudo, decorativo
        Stage { width: 100%; height: 100%; backdrop: AppState.backdrop; has-cover: AppState.has-now; }

        // ---- conteúdo: a aba atual (ou o detalhe por cima dela)
        Rectangle {
            x: Metrics.content-x; y: 0px; width: Metrics.content-w; height: root.height;
            if AppState.detail-open : DetailScreen { width: 100%; height: 100%; }
            if !AppState.detail-open && AppState.tab == Tab.home : HomeScreen { width: 100%; height: 100%; }
            if !AppState.detail-open && AppState.tab == Tab.explore : ExploreScreen { width: 100%; height: 100%; }
            if !AppState.detail-open && AppState.tab == Tab.library : LibraryScreen { width: 100%; height: 100%; }
            if !AppState.detail-open && AppState.tab == Tab.search : SearchScreen { width: 100%; height: 100%; }
            if !AppState.detail-open && AppState.tab == Tab.settings : SettingsScreen { width: 100%; height: 100%; }
        }

        // ---- áreas seguras: o conteúdo não pode ficar legível sob a barra de status nem sob os botões do sistema.
        // Esvaecimento superior (só com safe-top > 0; sem TouchArea): 70% do stage-base na barra de status, some em ~24 px.
        if AppState.safe-top > 0px : Rectangle {
            y: 0px; width: 100%; height: AppState.safe-top + 24px;
            background: @linear-gradient(180deg, Theme.stage-base.with-alpha(0.7) 0%, Theme.stage-base.with-alpha(0.7) top-stop, Theme.stage-base.with-alpha(0.0) 100%);
            accessible-role: none;
        }
        // ---- compact (base): esvaecimento inferior. Vai até a borda da janela (190 + safe-bottom): 55% atrás da barra (o vidro
        // ainda enxerga o conteúdo) e ~95% de opacidade na faixa dos botões do sistema. Sem TouchArea (não rouba toques).
        if Theme.compact : Rectangle {
            y: root.height - Metrics.fade-h; height: Metrics.fade-h; width: 100%;
            background: @linear-gradient(180deg, Theme.stage-base.with-alpha(0.0) 0%, Theme.stage-base.with-alpha(0.55) fade-s1, Theme.stage-base.with-alpha(0.95) fade-s2, Theme.stage-base.with-alpha(0.95) 100%);
            accessible-role: none;
        }
        if Theme.compact && AppState.has-now : MiniPlayer {
            x: 12px + AppState.safe-left; y: root.height - Metrics.mini-y-off; width: root.width - 24px - AppState.safe-left - AppState.safe-right;
        }
        if Theme.compact : NavDock {
            x: 12px + AppState.safe-left; y: root.height - Metrics.dock-y-off; width: root.width - 24px - 64px - AppState.safe-left - AppState.safe-right;
        }
        if Theme.compact : SearchButton {
            x: root.width - 12px - AppState.safe-right - self.width; y: root.height - Metrics.dock-y-off + (Theme.dock-h - self.height) / 2;
        }

        // ---- ≥ 600: trilho (88) ou barra lateral (248, ≥ 1200) + mini flutuante / NowBar
        if !Theme.compact : NavRail {
            x: 12px + AppState.safe-left; y: 12px + AppState.safe-top; height: root.height - 24px - AppState.safe-top - AppState.safe-bottom;
        }
        if !Theme.compact && !Theme.wide && AppState.has-now : MiniPlayer {
            width: min(640px, Metrics.content-w - 48px); x: Metrics.content-x + (Metrics.content-w - self.width) / 2; y: root.height - 16px - AppState.safe-bottom - Theme.mini-h;
        }
        if Theme.wide && AppState.has-now : NowBar {
            width: min(960px, Metrics.content-w - 48px); x: Metrics.content-x + (Metrics.content-w - self.width) / 2; y: root.height - 16px - AppState.safe-bottom - self.height;
        }

        // ---- oferta de desempenho (banner nível 2): aceitar liga Reduzir transparência
        if AppState.perf-offer && !Theme.reduce-transparency : GlassPanel {
            level: 2; radius: 24px;
            width: min(560px, root.width - 24px); x: (root.width - self.width) / 2; y: AppState.safe-top + 8px; height: offer-col.preferred-height + 24px;
            accessible-role: groupbox; accessible-label: "Deixar mais leve?";
            offer-col := VerticalLayout {
                padding: 12px; padding-left: 18px; spacing: 4px;
                HorizontalLayout { spacing: 8px;
                    VerticalLayout { horizontal-stretch: 1; alignment: center;
                        Text { text: "Deixar mais leve?"; font-size: Theme.fs-headline; font-weight: Theme.fw-headline; color: Theme.ink; accessible-role: text; }
                        Text { text: "O app está lento neste aparelho. Reduzir a transparência ajuda."; font-size: Theme.fs-subhead; color: Theme.ink-2; wrap: word-wrap; accessible-role: text; }
                    }
                }
                HorizontalLayout { spacing: 8px; alignment: end;
                    TextButton { label: "Agora não"; clicked => { AppState.perf-offer-dismiss(); } }
                    PillButton { label: "Reduzir transparência"; clicked => { Theme.reduce-transparency = true; AppState.reduce-transparency-changed(true); AppState.perf-offer-accept(); } }
                }
            }
        }

        // ---- player (folha cheia, sempre escura) e folhas
        if AppState.player-open : PlayerScreen { width: 100%; height: 100%; }
        if AppState.queue-open : Scrim { width: 100%; height: 100%; clicked => { AppState.queue-open = false; } }
        if AppState.queue-open : QueueSheet { win-w: root.width; win-h: root.height; }
        if AppState.menu-open : Scrim { width: 100%; height: 100%; clicked => { AppState.menu-open = false; } }
        if AppState.menu-open : MenuSheet { win-w: root.width; win-h: root.height; }
        if AppState.playlist-sheet-open : Scrim { width: 100%; height: 100%; clicked => { AppState.playlist-sheet-open = false; } }
        if AppState.playlist-sheet-open : PlaylistSheet { win-w: root.width; win-h: root.height; }
        if AppState.new-playlist-open : Scrim { width: 100%; height: 100%; clicked => { AppState.new-playlist-open = false; } }
        if AppState.new-playlist-open : NewPlaylistSheet { win-w: root.width; win-h: root.height; }

        // ---- aviso: 8 acima da reserva da barra (em cima de tudo)
        Toast {
            message: AppState.toast-text; error: AppState.toast-error; action-label: AppState.toast-action-label; seq: AppState.toast-seq;
            avail: root.width; x: (root.width - self.width) / 2;
            y: root.height - ((AppState.player-open || root.sheet-up) ? 24px + AppState.safe-bottom : Metrics.chrome-top-off) - 8px - self.height;
            action => { AppState.toast-action(); }
            dismissed => { AppState.dismiss-toast(); }
        }
    }
}
