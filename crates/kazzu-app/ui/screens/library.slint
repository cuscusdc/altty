// Biblioteca (v4): título com "Criar playlist", grade de coleções (arte é o ladrilho), playlists, "Neste aparelho".
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Button, Pressable, Icon, IconButton, Mosaic, LibraryTile, TrackRow, SectionHeader, Group, GroupItem, StateCard } from "../components/atoms.slint";
import { Screen, RootHeader, Rows, Gutters, SkeletonRows } from "../components/shared.slint";

export component LibraryScreen inherits Rectangle {
    property <int> cols: Theme.compact ? 2 : 4;
    property <length> tile-w: (min(root.width, 920px) - 2 * Theme.gutter - (cols - 1) * Theme.s-md) / cols;
    property <length> step-x: tile-w + Theme.s-md;
    property <length> step-y: cols == 2 ? tile-w + 56px + Theme.s-lg : 0px;
    property <bool> is-empty: !AppState.has-library && !AppState.scanning && AppState.playlists.length == 0 && AppState.recents.length == 0;
    pure function icon-for(id: string, covers: int) -> image {
        return id == "downloads" ? Icons.download : id == "liked" ? (covers > 0 ? Icons.heart-fill : Icons.heart) : id == "albums" ? Icons.disc : Icons.queue;
    }
    Screen {
        tab: Tab.library;
        VerticalLayout {
            padding-top: AppState.safe-top + Theme.s-xs;
            padding-bottom: Metrics.reserve;
            spacing: Theme.s-xxl;
            alignment: start;
            VerticalLayout {
                RootHeader { }
                Rectangle {
                    height: 52px;
                    Text { x: Theme.gutter; text: "Biblioteca"; color: Theme.ink; font-family: Theme.font-display; font-size: Theme.text-xxxl; font-weight: 700; letter-spacing: -0.68px; vertical-alignment: center; accessible-role: AccessibleRole.text; }
                    Button {
                        x: parent.width - Theme.gutter - self.width;
                        y: 2px;
                        width: 172px;
                        text: "Criar playlist";
                        has-icon: true;
                        icon: Icons.plus;
                        clicked => { AppState.new-playlist-track = ""; AppState.new-playlist-open = true; }
                    }
                }
            }
            if AppState.loading : SkeletonRows { count: 4; }
            if !AppState.loading : Rectangle {
                height: root.cols == 2 ? 2 * (root.tile-w + 56px) + Theme.s-lg : root.tile-w + 56px;
                for c[i] in AppState.collections : LibraryTile {
                    x: Theme.gutter + (root.cols == 2 ? mod(i, 2) * root.step-x : i * root.step-x);
                    y: root.cols == 2 ? floor(i / 2) * root.step-y : 0px;
                    width: root.tile-w;
                    covers: c.covers;
                    icon: root.icon-for(c.id, c.covers.length);
                    title: c.title;
                    count: c.count-label;
                    soon: c.soon;
                    liked: c.id == "liked";
                    clicked => { AppState.open-collection(c.id); }
                }
            }
            if !AppState.loading && root.is-empty : Gutters {
                StateCard { icon: Icons.folder; title: "Traga a música do aparelho"; text: "Escolha uma pasta e o Kazzu toca FLAC, WAV, Opus e MP3 como são, sem mexer no som."; primary: "Adicionar pasta"; primary-clicked => { AppState.add-folder(); } }
            }
            if !AppState.loading && AppState.playlists.length > 0 : VerticalLayout {
                spacing: Theme.s-sm;
                SectionHeader { title: "Suas playlists"; }
                Rows {
                    for p[i] in AppState.playlists : Pressable {
                        height: Theme.row-h;
                        ring-radius: Theme.r-thumb;
                        label: p.name + ", " + p.count-label;
                        clicked => { AppState.open-playlist(p.id); }
                        HorizontalLayout {
                            spacing: Theme.s-sm;
                            VerticalLayout { alignment: center; Mosaic { width: 48px; height: 48px; radius: Theme.r-thumb; sources: p.covers; } }
                            Rectangle {
                                if i > 0 : Rectangle { x: 0; y: 0; width: parent.width - 12px; height: 1px; background: Theme.rule; }
                                HorizontalLayout {
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: p.name; color: Theme.ink; font-size: Theme.text-lg; overflow: elide; accessible-role: none; }
                                        Text { text: p.count-label; color: Theme.ink-2; font-size: Theme.text-md; overflow: elide; accessible-role: none; }
                                    }
                                    VerticalLayout { alignment: center; Icon { source: Icons.chevron-right; tint: Theme.muted; size: 20px; } }
                                }
                            }
                        }
                    }
                }
            }
            if !AppState.loading && !root.is-empty : VerticalLayout {
                spacing: Theme.s-sm;
                SectionHeader { title: "Neste aparelho"; }
                Gutters {
                    Group {
                        GroupItem {
                            separator: false;
                            has-icon: true;
                            icon: Icons.folder;
                            title: AppState.library-summary != "" ? AppState.library-summary : "Nenhuma pasta adicionada";
                            note: AppState.scanning ? (AppState.scan-label != "" ? AppState.scan-label : "Procurando músicas") : "";
                        }
                        if AppState.scanning : Rectangle {
                            height: 14px;
                            Rectangle { x: Theme.s-md; y: 0; width: parent.width - 2 * Theme.s-md; height: 6px; border-radius: 3px; background: Theme.paper-3; }
                            Rectangle { x: Theme.s-md; y: 0; width: (parent.width - 2 * Theme.s-md) * (AppState.scan-progress < 0.0 ? 0.35 : clamp(AppState.scan-progress, 0.0, 1.0)); height: 6px; border-radius: 3px; background: Theme.accent; }
                        }
                        Pressable {
                            height: 56px;
                            ring-radius: Theme.r-group;
                            label: "Adicionar pasta";
                            clicked => { AppState.add-folder(); }
                            GroupItem { has-icon: true; icon: Icons.plus; title: "Adicionar pasta"; chevron: true; }
                        }
                    }
                }
            }
            if !AppState.loading && AppState.recents.length > 0 : VerticalLayout {
                spacing: Theme.s-sm;
                SectionHeader { title: "Tocadas recentemente"; }
                Rows { for t[i] in AppState.recents : TrackRow { t: t; separator: i > 0; clicked => { AppState.play-track(t.id); } more-clicked => { Nav.open-menu(t); } } }
            }
        }
    }
}
