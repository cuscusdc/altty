// Biblioteca (SLINT_SPEC §4.4): título + "Criar playlist", 4 coleções, "Neste aparelho", playlists, tocadas recentemente.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab } from "../theme/app-contract.slint";
import { GlassPanel } from "../theme/atoms.slint";
import { ScreenScroll, Gutter, HRail } from "../components/layout.slint";
import { SectionHeader, EmptyState, PillButton, PillKind, SkeletonRow } from "../components/basics.slint";
import { TrackRow, CollectionCard, PlaylistRow } from "../components/media.slint";
import { TopBar } from "../components/nav.slint";

export component LibraryScreen inherits Rectangle {
    property <int> cols: Theme.expanded ? 4 : 2;
    property <length> gap: Theme.collection-gap;
    property <length> card-w: (Metrics.content-w - Metrics.side-l - Metrics.side-r - (cols - 1) * gap) / cols;
    property <bool> is-empty: !AppState.has-library && !AppState.scanning && AppState.playlists.length == 0 && AppState.recents.length == 0;

    ScreenScroll {
        tab: Tab.library; width: parent.width; height: parent.height;
        Gutter { TopBar { horizontal-stretch: 1; } }
        // título grande + "Criar playlist" (botão grande, zona do polegar também no menu da faixa)
        Gutter {
            height: 64px; spacing: 12px;
            Text { text: "Biblioteca"; font-size: Theme.fs-large-title; font-weight: Theme.fw-large-title; letter-spacing: Theme.ls-large-title; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; accessible-role: text; }
            VerticalLayout { alignment: center;
                PillButton { icon: Icons.playlist-add; label: "Criar playlist"; clicked => { AppState.new-playlist-track = ""; AppState.new-playlist-open = true; } }
            }
        }
        Rectangle { height: 12px; }

        if AppState.loading : Gutter { VerticalLayout { SkeletonRow { } SkeletonRow { } SkeletonRow { } SkeletonRow { } } }

        if !AppState.loading && root.is-empty : Gutter {
            EmptyState { icon: Icons.library; title: "Sua biblioteca está vazia"; message: "Curta uma música ou adicione uma pasta e ela aparece aqui."; action-label: "Adicionar pasta"; action => { AppState.add-folder(); } }
        }

        if !AppState.loading && !root.is-empty : VerticalLayout {
            Gutter { Rectangle {
                height: ceil(AppState.collections.length / root.cols) * (root.card-w + 56px + root.gap);
                for c[i] in AppState.collections : CollectionCard {
                    x: mod(i, root.cols) * (root.card-w + root.gap); y: floor(i / root.cols) * (root.card-w + 56px + root.gap);
                    width: root.card-w; item: c; kind: i;
                    clicked => { AppState.open-collection(c.id); }
                }
            } }
            Rectangle { height: 4px; }
            // "Neste aparelho"
            Gutter { GlassPanel {
                level: 1; radius: 24px; height: local-col.preferred-height;
                local-col := VerticalLayout {
                    padding: 16px; spacing: 6px;
                    Text { text: "Neste aparelho"; font-size: Theme.fs-headline; font-weight: Theme.fw-headline; color: Theme.ink; accessible-role: text; }
                    Text { text: AppState.library-summary != "" ? AppState.library-summary : "Nenhuma pasta adicionada."; font-size: Theme.fs-subhead; color: Theme.ink-2; wrap: word-wrap; accessible-role: text; }
                    if AppState.scanning : VerticalLayout { spacing: 6px; padding-top: 4px;
                        Rectangle { height: 6px; border-radius: 3px; background: Theme.ink.with-alpha(0.18);
                            Rectangle { x: 0px; width: AppState.scan-progress < 0.0 ? parent.width * 0.35 : parent.width * clamp(AppState.scan-progress, 0.0, 1.0); height: parent.height; border-radius: 3px; background: Theme.accent; } }
                        Text { text: AppState.scan-label != "" ? AppState.scan-label : "Procurando músicas"; font-size: Theme.fs-caption; font-weight: Theme.fw-caption; color: Theme.ink-2; overflow: elide; accessible-role: text; }
                    }
                    HorizontalLayout { padding-top: 6px; alignment: start;
                        PillButton { kind: PillKind.quiet; icon: Icons.folder; label: "Adicionar pasta"; clicked => { AppState.add-folder(); } }
                    }
                }
            } }
            if AppState.playlists.length > 0 : VerticalLayout {
                Rectangle { height: 28px; }
                Gutter { SectionHeader { horizontal-stretch: 1; title: "Playlists"; } }
                for p in AppState.playlists : Gutter {
                    PlaylistRow { horizontal-stretch: 1; covers: p.covers; title: p.name; subtitle: p.count-label; clicked => { AppState.open-playlist(p.id); } }
                }
            }
            if AppState.recents.length > 0 : VerticalLayout {
                Rectangle { height: 28px; }
                Gutter { SectionHeader { horizontal-stretch: 1; title: "Tocadas recentemente"; } }
                for t in AppState.recents : Gutter { TrackRow { horizontal-stretch: 1; track: t; show-format: true; clicked => { AppState.play-track(t.id); } } }
            }
        }
    }
}
