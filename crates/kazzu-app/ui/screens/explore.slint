// Explorar (v4): lançamentos em cartões grandes, momentos e gêneros em ladrilhos neutros, "Em alta" numerada.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab, LoadState } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { PickCard, TrackRow, MoodTile, SectionHeader, Skeleton, StateCard, Banner } from "../components/atoms.slint";
import { Screen, Rail, RootHeader, LargeTitle, Rows, Gutters, SkeletonRows } from "../components/shared.slint";

export component ExploreScreen inherits Rectangle {
    property <int> cols: Theme.compact ? 2 : Theme.wide ? 4 : 4;
    property <length> mood-w: (root.width - 2 * Theme.gutter - (cols - 1) * Theme.s-sm) / cols;
    property <int> mood-rows: ceil(AppState.moods.length / cols);
    Screen {
        tab: Tab.explore;
        VerticalLayout {
            padding-top: AppState.safe-top + Theme.s-xs;
            padding-bottom: Metrics.reserve;
            spacing: Theme.s-xxl;
            alignment: start;
            VerticalLayout { RootHeader { } LargeTitle { text: "Explorar"; } }
            if AppState.explore-state == LoadState.offline || !AppState.online : Gutters {
                Banner { icon: Icons.cloud-off; title: "Sem conexão"; text: "Explorar precisa de internet. A música do aparelho continua na Biblioteca."; action: "Tentar de novo"; action-clicked => { AppState.retry-explore(); } }
            }
            if AppState.explore-state == LoadState.loading : VerticalLayout {
                spacing: Theme.s-sm;
                Rectangle { height: 48px; Skeleton { x: Theme.gutter; width: 160px; height: 22px; y: 13px; } }
                Rectangle {
                    height: Theme.compact ? 340px : 386px;
                    clip: true;
                    Skeleton { x: Theme.gutter; width: Theme.compact ? 264px : 300px; height: parent.height; border-radius: Theme.r-card; }
                    Skeleton { x: Theme.gutter + (Theme.compact ? 264px : 300px) + Theme.s-md; width: Theme.compact ? 264px : 300px; height: parent.height; border-radius: Theme.r-card; }
                    Skeleton { x: Theme.gutter + 2 * ((Theme.compact ? 264px : 300px) + Theme.s-md); width: Theme.compact ? 264px : 300px; height: parent.height; border-radius: Theme.r-card; }
                }
            }
            if AppState.explore-state == LoadState.error : Gutters {
                StateCard {
                    icon: Icons.cloud-off;
                    title: "Não deu para carregar o Explorar";
                    text: AppState.explore-error-text != "" ? AppState.explore-error-text : "O YouTube Music não respondeu. Tente de novo em instantes.";
                    primary: "Tentar de novo";
                    primary-clicked => { AppState.retry-explore(); }
                }
            }
            if AppState.explore-state == LoadState.empty : Gutters {
                StateCard { icon: Icons.explore; title: "Nada por aqui ainda"; text: "Quando o YouTube Music tiver novidades, elas aparecem aqui."; primary: "Atualizar"; primary-clicked => { AppState.retry-explore(); } }
            }
            if AppState.explore-state == LoadState.ready : VerticalLayout {
                spacing: Theme.s-xxl;
                if AppState.new-releases.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Lançamentos"; }
                    Rail {
                        label: "Lançamentos";
                        card-h: Theme.compact ? 340px : 386px;
                        for a in AppState.new-releases : PickCard {
                            cover: a.cover;
                            title: a.title;
                            subtitle: a.artist;
                            clicked => { AppState.open-album(a.id); }
                            play => { AppState.play-item("album", a.id); }
                        }
                    }
                }
                if AppState.moods.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Momentos e gêneros"; }
                    Rectangle {
                        height: root.mood-rows * 56px + (root.mood-rows - 1) * Theme.s-sm;
                        for m[i] in AppState.moods : MoodTile {
                            x: Theme.gutter + mod(i, root.cols) * (root.mood-w + Theme.s-sm);
                            y: floor(i / root.cols) * (56px + Theme.s-sm);
                            width: root.mood-w;
                            title: m.title;
                            clicked => { AppState.open-item(m.kind, m.id); }
                        }
                    }
                }
                if AppState.trending.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Em alta"; }
                    Rows { for t[i] in AppState.trending : TrackRow { t: t; number: i + 1; ranked: true; separator: i > 0; clicked => { AppState.play-track(t.id); } more-clicked => { Nav.open-menu(t); } } }
                }
            }
        }
    }
}
