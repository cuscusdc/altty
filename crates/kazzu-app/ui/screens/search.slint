// Buscar (v4): campo no alto da tela, "Reconhecer pelo som" (Em breve), buscas recentes, sugestões e resultados por tipo.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab, SearchState } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { SearchField, Pressable, Icon, IconButton, Cover, Tile, TrackRow, Segmented, SectionHeader, Group, GroupItem, Tag, StateCard, Skeleton } from "../components/atoms.slint";
import { Screen, Rail, RootHeader, LargeTitle, Rows, Gutters, AlbumGrid, SkeletonRows } from "../components/shared.slint";

// Linha de texto da busca (recente ou sugestão): ícone, texto e, nas recentes, o X para tirar.
component TermRow inherits Pressable {
    in property <string> term;
    in property <image> icon;
    in property <bool> removable: false;
    in property <bool> separator: true;
    callback remove();
    height: Theme.row-h;
    ring-radius: Theme.r-thumb;
    label: "Buscar " + term;
    HorizontalLayout {
        spacing: Theme.s-sm;
        Rectangle { width: 48px; Icon { source: root.icon; tint: Theme.ink-2; } }
        Rectangle {
            if root.separator : Rectangle { x: 0; y: 0; width: parent.width - 12px; height: 1px; background: Theme.rule; }
            HorizontalLayout {
                Text { text: root.term; color: Theme.ink; font-size: Theme.text-lg; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; accessible-role: none; }
                if root.removable : VerticalLayout { alignment: center; IconButton { icon: Icons.close; label: "Tirar " + root.term + " das buscas recentes"; clicked => { root.remove(); } } }
            }
        }
    }
}

component MediaRow inherits Pressable {
    in property <image> cover;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> round: false;
    in property <bool> separator: true;
    height: Theme.row-h;
    ring-radius: Theme.r-thumb;
    label: title + ", " + subtitle;
    HorizontalLayout {
        spacing: Theme.s-sm;
        VerticalLayout { alignment: center; Cover { source: root.cover; radius: root.round ? 24px : Theme.r-thumb; } }
        Rectangle {
            if root.separator : Rectangle { x: 0; y: 0; width: parent.width - 12px; height: 1px; background: Theme.rule; }
            HorizontalLayout {
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: root.title; color: Theme.ink; font-size: Theme.text-lg; overflow: elide; accessible-role: none; }
                    Text { text: root.subtitle; color: Theme.ink-2; font-size: Theme.text-md; overflow: elide; accessible-role: none; }
                }
            }
        }
    }
}

export component SearchScreen inherits Rectangle {
    property <[string]> kinds: ["Tudo", "Músicas", "Álbuns", "Artistas", "Playlists"];
    property <bool> typing: AppState.search-text != "";
    function set-text(t: string) { AppState.search-text = t; AppState.search(t); field.focus-input(); }
    function set-kind(k: int) { AppState.search-kind = k; AppState.search-kind-changed(k); }
    /// a tela pede o foco do campo ao entrar (busca redonda, Buscar da barra lateral)
    init => { field.focus-input(); }
    Screen {
        tab: Tab.search;
        VerticalLayout {
            padding-top: AppState.safe-top + Theme.s-xs;
            padding-bottom: Metrics.reserve;
            spacing: Theme.s-xl;
            alignment: start;
            VerticalLayout { RootHeader { } LargeTitle { text: "Buscar"; } }
            Gutters {
                field := SearchField {
                    text <=> AppState.search-text;
                    edited(t) => { AppState.search(t); }
                    escaped => { root.set-text(""); }
                }
            }
            if AppState.search-state == SearchState.idle && !root.typing : Gutters {
                // recurso que ainda não existe: linha esmaecida com "Em breve", sem interruptor falso
                Group { GroupItem { separator: false; has-icon: true; icon: Icons.wave; title: "Reconhecer pelo som"; note: "Descubra a música que está tocando perto de você."; dimmed: true; VerticalLayout { alignment: center; Tag { text: "Em breve"; } } } }
            }
            if AppState.search-state == SearchState.idle && !root.typing && AppState.recent-searches.length > 0 : VerticalLayout {
                spacing: Theme.s-sm;
                SectionHeader { title: "Buscas recentes"; action: "Limpar"; action-clicked => { AppState.clear-recent-searches(); } }
                Rows {
                    for r[i] in AppState.recent-searches : TermRow {
                        term: r;
                        icon: Icons.clock;
                        removable: true;
                        separator: i > 0;
                        clicked => { root.set-text(r); }
                        remove => { AppState.remove-recent-search(r); }
                    }
                }
            }
            // sugestões enquanto digita (antes do resultado chegar)
            if root.typing && AppState.search-suggestions.length > 0 && AppState.search-state == SearchState.idle : Rows {
                for s[i] in AppState.search-suggestions : TermRow { term: s; icon: Icons.search; separator: i > 0; clicked => { root.set-text(s); } }
            }
            if AppState.search-state == SearchState.loading : SkeletonRows { count: 5; }
            if AppState.search-state == SearchState.empty : Gutters {
                StateCard {
                    icon: Icons.search;
                    title: AppState.search-empty-text != "" ? AppState.search-empty-text : "Nada para esta busca";
                    text: "Confira a grafia ou tente o nome do artista.";
                    primary: AppState.search-kind != 0 ? "Buscar em tudo" : "";
                    primary-clicked => { root.set-kind(0); }
                }
            }
            if AppState.search-state == SearchState.error : Gutters {
                StateCard {
                    icon: Icons.cloud-off;
                    title: "Não deu para buscar";
                    text: AppState.search-error-text != "" ? AppState.search-error-text : "O YouTube Music não respondeu. Tente de novo em instantes.";
                    primary: "Tentar de novo";
                    primary-clicked => { AppState.search(AppState.search-text); }
                }
            }
            if AppState.search-state == SearchState.offline : Gutters {
                StateCard {
                    icon: Icons.cloud-off;
                    title: "Sem conexão";
                    text: "A busca no YouTube Music precisa de internet. A música do aparelho continua tocando.";
                    primary: "Tentar de novo";
                    primary-clicked => { AppState.search(AppState.search-text); }
                }
            }
            if AppState.search-state == SearchState.results : VerticalLayout {
                spacing: Theme.s-xl;
                Gutters { Segmented { options: root.kinds; current: AppState.search-kind; changed(i) => { root.set-kind(i); } } }
                if AppState.search-kind == 0 && AppState.search-has-best : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Melhor resultado"; }
                    Gutters {
                        Group {
                            Pressable {
                                height: 72px;
                                ring-radius: Theme.r-group;
                                label: AppState.search-best.title + ", " + AppState.search-best.subtitle;
                                clicked => { AppState.open-item(AppState.search-best.kind, AppState.search-best.id); }
                                HorizontalLayout {
                                    padding-left: Theme.s-md;
                                    padding-right: Theme.s-sm;
                                    spacing: Theme.s-sm;
                                    VerticalLayout { alignment: center; Cover { source: AppState.search-best.cover; } }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: AppState.search-best.title; color: Theme.ink; font-size: Theme.text-lg; font-weight: 600; overflow: elide; accessible-role: none; }
                                        Text { text: AppState.search-best.subtitle; color: Theme.ink-2; font-size: Theme.text-sm; overflow: elide; accessible-role: none; }
                                    }
                                    VerticalLayout { alignment: center; IconButton { icon: Icons.play; label: "Tocar " + AppState.search-best.title; clicked => { AppState.play-item(AppState.search-best.kind, AppState.search-best.id); } } }
                                }
                            }
                        }
                    }
                }
                if (AppState.search-kind == 0 || AppState.search-kind == 1) && AppState.search-songs.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Músicas"; action: AppState.search-kind == 0 && AppState.search-songs.length > 5 ? "Ver todas" : ""; action-clicked => { root.set-kind(1); } }
                    Rows {
                        for t[i] in AppState.search-songs : TrackRow {
                            property <bool> shown: AppState.search-kind == 1 || i < 5;
                            visible: shown;
                            height: shown ? Theme.row-h : 0px;
                            t: t;
                            separator: i > 0;
                            clicked => { AppState.play-track(t.id); }
                            more-clicked => { Nav.open-menu(t); }
                        }
                    }
                }
                if (AppState.search-kind == 0 || AppState.search-kind == 2) && AppState.search-albums.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Álbuns"; }
                    if AppState.search-kind == 0 : Rail {
                        label: "Álbuns";
                        card-h: (Theme.compact ? 148px : 172px) + 52px;
                        for a in AppState.search-albums : Tile { cover: a.cover; title: a.title; subtitle: a.artist; clicked => { AppState.open-album(a.id); } }
                    }
                    if AppState.search-kind == 2 : AlbumGrid { albums: AppState.search-albums; }
                }
                if (AppState.search-kind == 0 || AppState.search-kind == 3) && AppState.search-artists.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Artistas"; }
                    Rows { for a[i] in AppState.search-artists : MediaRow { round: true; cover: a.cover; title: a.name; subtitle: a.subtitle; separator: i > 0; clicked => { AppState.open-item("artist", a.id); } } }
                }
                if (AppState.search-kind == 0 || AppState.search-kind == 4) && AppState.search-playlists.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Playlists"; }
                    Rows { for p[i] in AppState.search-playlists : MediaRow { cover: p.cover; title: p.title; subtitle: p.subtitle; separator: i > 0; clicked => { AppState.open-item(p.kind, p.id); } } }
                }
            }
        }
    }
}
