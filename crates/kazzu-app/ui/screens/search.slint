// Buscar (SLINT_SPEC §4.6): o campo vive SÓ aqui (vidro nível 2, 56, raio 28). `search(texto)` a cada edição; o Rust faz debounce.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab, SearchState } from "../theme/app-contract.slint";
import { IconButton, GlassPanel, Chip } from "../theme/atoms.slint";
import { ScreenScroll, Gutter, PageTitle, HRail } from "../components/layout.slint";
import { SectionHeader, EmptyState, SkeletonRow, TextButton, FocusRing } from "../components/basics.slint";
import { TrackRow, MediaTile, MediaRow, BestResult, PlaylistRow } from "../components/media.slint";
import { TopBar } from "../components/nav.slint";
import { AlbumGrid } from "../components/layout.slint";

export component SearchScreen inherits Rectangle {
    property <[string]> kinds: ["Tudo", "Músicas", "Álbuns", "Artistas", "Playlists"];
    property <length> tile: Theme.expanded ? 168px : 148px;
    function set-text(t: string) { AppState.search-text = t; AppState.search(t); field.focus(); }
    function set-kind(k: int) { AppState.search-kind = k; AppState.search-kind-changed(k); }
    init => { field.focus(); }

    ScreenScroll {
        tab: Tab.search; width: parent.width; height: parent.height;
        Gutter { TopBar { horizontal-stretch: 1; } }
        PageTitle { text: "Buscar"; }
        // ---- campo
        Gutter { Rectangle { height: Theme.field-h + 8px;
            GlassPanel {
                y: 4px; level: 2; radius: 28px; height: Theme.field-h;
                accessible-role: groupbox; accessible-label: "Campo de busca";
                Image { source: Icons.search; x: 18px; y: (parent.height - self.height) / 2; width: Theme.icon; height: Theme.icon; colorize: Theme.ink; }
                field := TextInput {
                    text <=> AppState.search-text;
                    x: 54px; width: parent.width - 54px - (field.text != "" ? 96px : 56px); height: parent.height;
                    font-size: Theme.fs-body; color: Theme.ink; vertical-alignment: center; single-line: true; input-type: text;
                    accessible-role: text-input; accessible-label: "Buscar músicas, artistas e álbuns"; accessible-placeholder-text: "Músicas, artistas, álbuns";
                    edited => { AppState.search(self.text); }
                    key-pressed(e) => { if (e.text == Key.Escape && self.text != "") { root.set-text(""); return accept; } return reject; }
                }
                if field.text == "" : Text { x: 54px; height: parent.height; text: "Músicas, artistas, álbuns"; font-size: Theme.fs-body; color: Theme.ink-2; vertical-alignment: center; accessible-role: none; }
                if field.text != "" : IconButton { x: parent.width - 96px - 4px; y: (parent.height - self.height) / 2; icon: Icons.close; glyph: Theme.icon-sm; label: "Limpar busca"; tint: Theme.ink; clicked => { root.set-text(""); } }
                IconButton { x: parent.width - 48px - 4px; y: (parent.height - self.height) / 2; icon: Icons.wave; label: "Reconhecer música pelo som ambiente"; tint: Theme.ink; clicked => { AppState.recognize-ambient(); } }
            }
        } }
        // ---- tipo
        HRail { label: "Tipo de resultado"; spacing: 8px;
            for name[i] in root.kinds : Chip { text: name; selected: AppState.search-kind == i; y: (parent.height - self.height) / 2; clicked => { root.set-kind(i); } }
        }
        // ---- sugestões (linha de chips que preenchem o campo)
        if AppState.search-suggestions.length > 0 && AppState.search-text != "" : HRail { label: "Sugestões de busca"; spacing: 8px;
            for s in AppState.search-suggestions : Chip { text: s; y: (parent.height - self.height) / 2; clicked => { root.set-text(s); } }
        }

        // ---- idle
        if AppState.search-state == SearchState.idle : VerticalLayout {
            Rectangle { height: 28px; }
            if AppState.recent-searches.length > 0 : VerticalLayout {
                Gutter { SectionHeader { horizontal-stretch: 1; title: "Buscas recentes"; action-label: "Limpar"; action => { AppState.clear-recent-searches(); } } }
                for r in AppState.recent-searches : Gutter { Rectangle {
                    height: Theme.row-h; horizontal-stretch: 1; border-radius: 18px;
                    background: rta.pressed ? Theme.ink.with-alpha(0.14) : rta.has-hover ? Theme.ink.with-alpha(0.08) : transparent;
                    accessible-role: button; accessible-label: "Buscar " + r; accessible-action-default => { root.set-text(r); }
                    rta := TouchArea { mouse-cursor: pointer; clicked => { root.set-text(r); } }
                    HorizontalLayout { padding-left: 8px; padding-right: 4px; spacing: 14px;
                        Rectangle { width: 40px; height: 40px; y: (parent.height - self.height) / 2; border-radius: 12px; background: Theme.ink.with-alpha(0.12);
                            Image { source: Icons.clock; width: Theme.icon; height: Theme.icon; x: 8px; y: 8px; colorize: Theme.ink; } }
                        Text { text: r; font-size: Theme.fs-body; font-weight: 600; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; accessible-role: none; }
                        IconButton { y: (parent.height - self.height) / 2; icon: Icons.close; glyph: Theme.icon-sm; label: "Remover busca recente " + r; tint: Theme.ink; clicked => { AppState.remove-recent-search(r); } }
                    }
                } }
                Rectangle { height: 20px; }
            }
            Gutter { SectionHeader { horizontal-stretch: 1; title: "Para experimentar"; } }
            Rectangle { height: 4px; }
            HRail { label: "Para experimentar"; spacing: 8px;
                for s in AppState.search-ideas : Chip { text: s; y: (parent.height - self.height) / 2; clicked => { root.set-text(s); } }
            }
        }

        // ---- carregando
        if AppState.search-state == SearchState.loading : Gutter { padding-top: 12px;
            VerticalLayout { SkeletonRow { } SkeletonRow { } SkeletonRow { } SkeletonRow { } SkeletonRow { } } }

        // ---- sem resultado / erro / offline
        if AppState.search-state == SearchState.empty : Gutter { padding-top: 16px;
            EmptyState { icon: Icons.search; title: AppState.search-empty-text != "" ? AppState.search-empty-text : "Nada para esta busca."; message: "Confira a grafia ou busque só o nome do artista."; action-label: "Limpar filtros"; action => { root.set-kind(0); } }
        }
        if AppState.search-state == SearchState.error : Gutter { padding-top: 16px;
            EmptyState { icon: Icons.cloud-off; title: "O YouTube Music não respondeu";
                message: AppState.search-error-text != "" ? AppState.search-error-text : "Sua conexão parece ok. O serviço pode estar fora do ar. Tente de novo em instantes.";
                action-label: "Tentar de novo"; action => { AppState.search(AppState.search-text); } }
        }
        if AppState.search-state == SearchState.offline : Gutter { padding-top: 16px;
            EmptyState { icon: Icons.cloud-off; title: "Sem conexão"; message: "A busca no YouTube Music precisa de internet. Suas músicas baixadas e locais continuam tocando."; action-label: "Tentar de novo"; action => { AppState.search(AppState.search-text); } }
        }

        // ---- resultados
        if AppState.search-state == SearchState.results : VerticalLayout {
            Rectangle { height: 16px; }
            if AppState.search-kind == 0 && AppState.search-has-best : Gutter { padding-bottom: 20px;
                BestResult { horizontal-stretch: 1; item: AppState.search-best; clicked => { AppState.open-item(AppState.search-best.kind, AppState.search-best.id); } play => { AppState.play-item(AppState.search-best.kind, AppState.search-best.id); } } }
            if (AppState.search-kind == 0 || AppState.search-kind == 1) && AppState.search-songs.length > 0 : VerticalLayout {
                Gutter { SectionHeader { horizontal-stretch: 1; title: "Músicas"; source-tag: AppState.source-label;
                    action-label: AppState.search-kind == 0 && AppState.search-songs.length > 5 ? "Ver todas" : ""; action => { root.set-kind(1); } } }
                for t[i] in AppState.search-songs : Gutter { property <bool> shown: AppState.search-kind == 1 || i < 5; visible: shown; height: shown ? self.preferred-height : 0px; TrackRow { horizontal-stretch: 1; track: t; show-format: true; clicked => { AppState.play-track(t.id); } } }
                Rectangle { height: 24px; }
            }
            if (AppState.search-kind == 0 || AppState.search-kind == 2) && AppState.search-albums.length > 0 : VerticalLayout {
                Gutter { SectionHeader { horizontal-stretch: 1; title: "Álbuns"; } }
                Rectangle { height: 8px; }
                if AppState.search-kind == 0 : HRail { rail-h: root.tile + 64px; label: "Álbuns";
                    for a in AppState.search-albums : MediaTile { side: root.tile; cover: a.cover; title: a.title; subtitle: a.artist; clicked => { AppState.open-album(a.id); } }
                }
                if AppState.search-kind == 2 : Gutter { AlbumGrid { albums: AppState.search-albums; } }
                Rectangle { height: 24px; }
            }
            if (AppState.search-kind == 0 || AppState.search-kind == 3) && AppState.search-artists.length > 0 : VerticalLayout {
                Gutter { SectionHeader { horizontal-stretch: 1; title: "Artistas"; } }
                for a in AppState.search-artists : Gutter { MediaRow { horizontal-stretch: 1; round: true; cover: a.cover; title: a.name; subtitle: a.subtitle; clicked => { AppState.open-item("artist", a.id); } } }
                Rectangle { height: 24px; }
            }
            if (AppState.search-kind == 0 || AppState.search-kind == 4) && AppState.search-playlists.length > 0 : VerticalLayout {
                Gutter { SectionHeader { horizontal-stretch: 1; title: "Playlists"; } }
                for p in AppState.search-playlists : Gutter { MediaRow { horizontal-stretch: 1; cover: p.cover; title: p.title; subtitle: p.subtitle; clicked => { AppState.open-item(p.kind, p.id); } } }
            }
        }
    }
}
