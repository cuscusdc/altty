// Detalhe (v4): álbum, artista, playlist, coleção ou humor. Capa de ponta a ponta no celular (por baixo da barra de status),
// com a placa de vidro do título; no desktop a capa fica ao lado das faixas. Tocar, Aleatório, faixas numeradas.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, DetailKind, LoadState } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { MediaGlass, MediaIconButton, Icon, Button, Tile, TrackRow, SectionHeader, StateCard, Banner } from "../components/atoms.slint";
import { Rail, Rows, Gutters, AlbumGrid, SkeletonRows } from "../components/shared.slint";

// A capa com Voltar, Salvar e a placa de vidro do título. `split`: cantos arredondados (desktop); senão ponta a ponta.
component DetailHero inherits Rectangle {
    in property <length> hero;
    in property <bool> split;
    width: root.hero;
    height: root.hero;
    border-radius: root.split ? 28px : 0px;
    clip: true;
    background: Theme.paper-2;
    if AppState.detail-cover.width == 0 : Icon { source: Icons.disc; tint: Theme.muted; size: 64px; }
    Image { source: AppState.detail-cover; width: 100%; height: 100%; image-fit: ImageFit.cover; accessible-role: none; }
    MediaIconButton { x: Theme.s-xs; y: (root.split ? 0px : AppState.safe-top) + Theme.s-xs; icon: Icons.chevron-left; label: "Voltar"; clicked => { Nav.close-detail(); } }
    if AppState.detail-can-save : MediaIconButton {
        x: parent.width - Theme.s-xs - 48px;
        y: (root.split ? 0px : AppState.safe-top) + Theme.s-xs;
        icon: AppState.detail-saved ? Icons.heart-fill : Icons.heart;
        label: AppState.detail-saved ? "Remover da Biblioteca" : "Salvar na Biblioteca";
        clicked => { AppState.toggle-detail-saved(); }
    }
    MediaGlass {
        x: root.split ? Theme.s-md : Theme.gutter;
        y: parent.height - self.height - Theme.s-md;
        width: parent.width - 2 * self.x;
        height: AppState.detail-subtitle != "" ? 88px : 64px;
        radius: Theme.r-card;
        VerticalLayout {
            padding-left: Theme.s-lg;
            padding-right: Theme.s-lg;
            alignment: center;
            spacing: Theme.s-xxxs;
            Text { text: AppState.detail-title; color: Theme.media-ink; font-family: Theme.font-display; font-size: Theme.text-xxl; font-weight: 700; letter-spacing: -0.56px; overflow: elide; accessible-role: AccessibleRole.text; }
            if AppState.detail-subtitle != "" : Text { text: AppState.detail-subtitle; color: Theme.media-ink; font-size: Theme.text-md; overflow: elide; accessible-role: AccessibleRole.text; }
        }
    }
}

export component DetailScreen inherits Rectangle {
    property <bool> split: root.width >= 840px;
    property <length> hero: root.split ? 360px : min(root.width, 520px);
    property <bool> has-tracks: AppState.detail-state == LoadState.ready && AppState.detail-kind != DetailKind.albums;
    property <bool> ready: AppState.detail-state == LoadState.ready;
    property <length> scroll-top: Metrics.scroll-detail;
    fl := Flickable {
        interactive: true;
        init => { Metrics.scroll-detail = 0px; }
        changed content-y => { Metrics.scroll-detail = self.content-y; }
        HorizontalLayout {
            padding-top: root.split ? AppState.safe-top + Theme.s-xl : 0px;
            spacing: 0px;
            alignment: root.split ? start : stretch;
            if root.split : VerticalLayout { width: root.hero + Theme.gutter; padding-left: Theme.gutter; alignment: start; Rectangle { height: root.hero; DetailHero { hero: root.hero; split: true; } } }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-bottom: Metrics.reserve;
                spacing: Theme.s-xl;
                alignment: start;
                if !root.split : Rectangle { height: root.hero; DetailHero { hero: root.hero; split: false; } }
                if root.ready && AppState.detail-kind != DetailKind.albums : HorizontalLayout {
                    padding-left: Theme.gutter;
                    padding-right: Theme.gutter;
                    spacing: Theme.s-sm;
                    Button { text: "Tocar"; has-icon: true; icon: Icons.play; primary: true; horizontal-stretch: 1; clicked => { AppState.play-all(); } }
                    Button { text: "Aleatório"; has-icon: true; icon: Icons.shuffle; horizontal-stretch: 1; clicked => { AppState.shuffle-all(); } }
                }
                if AppState.detail-state == LoadState.loading : SkeletonRows { count: 6; }
                if AppState.detail-state == LoadState.error : Gutters {
                    StateCard { icon: Icons.cloud-off; title: "Não deu para carregar"; text: AppState.detail-error-text != "" ? AppState.detail-error-text : "Tente de novo em instantes."; primary: "Tentar de novo"; primary-clicked => { AppState.retry-detail(); } }
                }
                if AppState.detail-state == LoadState.offline : Gutters {
                    StateCard { icon: Icons.cloud-off; title: "Sem conexão"; text: "Este conteúdo precisa de internet."; primary: "Tentar de novo"; primary-clicked => { AppState.retry-detail(); } }
                }
                if AppState.detail-state == LoadState.empty : Gutters {
                    StateCard { icon: Icons.disc; title: "Nenhuma música aqui ainda"; text: AppState.detail-empty-text != "" ? AppState.detail-empty-text : "Quando houver músicas, elas aparecem aqui."; }
                }
                if root.ready && AppState.detail-kind == DetailKind.albums : AlbumGrid { albums: AppState.detail-albums; }
                if root.has-tracks : VerticalLayout {
                    spacing: Theme.s-sm;
                    Rows {
                        for t[i] in AppState.detail-tracks : TrackRow { t: t; number: i + 1; separator: i > 0; clicked => { AppState.play-track(t.id); } more-clicked => { Nav.open-menu(t); } }
                    }
                    HorizontalLayout {
                        padding-left: Theme.gutter;
                        padding-right: Theme.gutter;
                        Text {
                            text: AppState.detail-tracks.length + (AppState.detail-tracks.length == 1 ? " música" : " músicas") + (AppState.detail-source != "" ? ". " + AppState.detail-source + "." : ".");
                            color: Theme.ink-2;
                            font-size: Theme.text-sm;
                            wrap: word-wrap;
                            accessible-role: AccessibleRole.text;
                        }
                    }
                }
                if root.has-tracks && AppState.detail-kind == DetailKind.artist && AppState.detail-albums.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Álbuns"; }
                    Rail {
                        label: "Álbuns";
                        card-h: (Theme.compact ? 148px : 172px) + 52px;
                        for a in AppState.detail-albums : Tile { cover: a.cover; title: a.title; subtitle: a.artist; clicked => { AppState.open-album(a.id); } }
                    }
                }
            }
        }
    }
}
