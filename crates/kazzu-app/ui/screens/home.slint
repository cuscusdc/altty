// Início (v4): logo e Ajustes, "Para ouvir agora" (cartões grandes), "Faixas para você", Mixes e Álbuns em destaque.
// Sem chips: as prateleiras têm nomes próprios (decisão A1/A11). Estados: carregando, vazio, erro, sem conexão, primeiro uso.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab, LoadState } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { PickCard, Tile, TrackRow, SectionHeader, Skeleton, StateCard, Banner } from "../components/atoms.slint";
import { Screen, Rail, RootHeader, Rows, Gutters, SkeletonRows } from "../components/shared.slint";

export component HomeScreen inherits Rectangle {
    property <LoadState> st: AppState.home-state;
    property <bool> stale: st == LoadState.error && AppState.home-stale;
    property <bool> content: st == LoadState.ready || root.stale;
    property <bool> offline: st == LoadState.offline;
    // sem YouTube Music (--no-youtube) ou sem feed: o Início mostra a música do aparelho, com os mesmos componentes
    property <bool> local-only: AppState.highlights.length == 0 && AppState.quick-picks.length == 0 && AppState.mixes.length == 0;
    Screen {
        tab: Tab.home;
        VerticalLayout {
            padding-top: AppState.safe-top + Theme.s-xs;
            padding-bottom: Metrics.reserve;
            spacing: Theme.s-sm;
            alignment: start;
            RootHeader { logo: true; }
            if AppState.first-run-banner && root.st != LoadState.loading : Gutters {
                Banner { icon: Icons.badge-check; title: "Pronto para tocar"; text: "O YouTube Music já vem ligado. Não precisa de conta."; action: "Entendi"; action-clicked => { AppState.dismiss-first-run-banner(); } }
            }
            if root.offline || (!AppState.online && root.st != LoadState.error) : Gutters {
                Banner { icon: Icons.cloud-off; title: "Sem conexão"; text: "A música do aparelho continua aqui."; action: "Tentar de novo"; action-clicked => { AppState.retry-home(); } }
            }
            if root.stale : Gutters {
                Banner { icon: Icons.info; title: "Não deu para atualizar"; text: "Mostrando o que já estava aqui."; action: "Tentar de novo"; action-clicked => { AppState.retry-home(); } }
            }
            if root.st == LoadState.error && !AppState.home-stale : Gutters {
                StateCard {
                    icon: Icons.cloud-off;
                    title: AppState.home-error-title != "" ? AppState.home-error-title : "Não deu para carregar o Início";
                    text: AppState.home-error-text != "" ? AppState.home-error-text : "O YouTube Music não respondeu. Sua música do aparelho continua na Biblioteca.";
                    primary: "Tentar de novo";
                    secondary: "Abrir a Biblioteca";
                    primary-clicked => { AppState.retry-home(); }
                    secondary-clicked => { Nav.go(Tab.library); }
                }
            }
            if root.st == LoadState.empty : Gutters {
                StateCard { icon: Icons.disc; title: "Nada por aqui ainda"; text: "Quando o YouTube Music tiver sugestões para você, elas aparecem aqui."; primary: "Atualizar"; primary-clicked => { AppState.retry-home(); } }
            }
            if root.st == LoadState.loading : VerticalLayout {
                spacing: Theme.s-xxl;
                VerticalLayout {
                    spacing: Theme.s-sm;
                    Rectangle { height: 48px; Skeleton { x: Theme.gutter; width: 160px; height: 22px; y: 13px; } }
                    Rectangle {
                        height: Theme.compact ? 340px : 386px;
                        clip: true;
                        Skeleton { x: Theme.gutter; width: Theme.compact ? 264px : 300px; height: parent.height; border-radius: Theme.r-card; }
                        Skeleton { x: Theme.gutter + (Theme.compact ? 264px : 300px) + Theme.s-md; width: Theme.compact ? 264px : 300px; height: parent.height; border-radius: Theme.r-card; }
                        Skeleton { x: Theme.gutter + 2 * ((Theme.compact ? 264px : 300px) + Theme.s-md); width: Theme.compact ? 264px : 300px; height: parent.height; border-radius: Theme.r-card; }
                    }
                }
                VerticalLayout {
                    spacing: Theme.s-sm;
                    Rectangle { height: 48px; Skeleton { x: Theme.gutter; width: 180px; height: 22px; y: 13px; } }
                    SkeletonRows { }
                }
            }
            if root.content : VerticalLayout {
                spacing: Theme.s-xxl;
                if AppState.highlights.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Para ouvir agora"; }
                    Rail {
                        label: "Para ouvir agora";
                        card-h: Theme.compact ? 340px : 386px;
                        for h in AppState.highlights : PickCard {
                            cover: h.cover;
                            title: h.title;
                            subtitle: h.subtitle;
                            clicked => { AppState.open-item(h.kind, h.id); }
                            play => { AppState.play-item(h.kind, h.id); }
                        }
                    }
                }
                if AppState.quick-picks.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Faixas para você"; }
                    Rows { for t[i] in AppState.quick-picks : TrackRow { t: t; separator: i > 0; clicked => { AppState.play-track(t.id); } more-clicked => { Nav.open-menu(t); } } }
                }
                if AppState.mixes.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Mixes"; }
                    Rail {
                        label: "Mixes";
                        card-h: (Theme.compact ? 148px : 172px) + 52px;
                        for m in AppState.mixes : Tile { cover: m.cover; title: m.title; subtitle: m.subtitle; clicked => { AppState.open-item(m.kind, m.id); } }
                    }
                }
                if root.local-only && AppState.albums.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Álbuns do aparelho"; }
                    Rail {
                        label: "Álbuns do aparelho";
                        card-h: Theme.compact ? 340px : 386px;
                        for a in AppState.albums : PickCard {
                            cover: a.cover;
                            title: a.title;
                            subtitle: a.artist;
                            clicked => { AppState.open-album(a.id); }
                            play => { AppState.play-item("album", a.id); }
                        }
                    }
                }
                if root.local-only && AppState.recents.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Tocadas recentemente"; }
                    Rows { for t[i] in AppState.recents : TrackRow { t: t; separator: i > 0; clicked => { AppState.play-track(t.id); } more-clicked => { Nav.open-menu(t); } } }
                }
                if !root.local-only && AppState.albums.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Álbuns em destaque"; }
                    Rail {
                        label: "Álbuns em destaque";
                        card-h: (Theme.compact ? 148px : 172px) + 52px;
                        for a in AppState.albums : Tile { cover: a.cover; title: a.title; subtitle: a.artist; clicked => { AppState.open-album(a.id); } }
                    }
                }
            }
            if root.offline : VerticalLayout {
                spacing: Theme.s-xxl;
                if AppState.recents.length > 0 : VerticalLayout {
                    spacing: Theme.s-sm;
                    SectionHeader { title: "Neste aparelho"; }
                    Rows { for t[i] in AppState.recents : TrackRow { t: t; separator: i > 0; clicked => { AppState.play-track(t.id); } more-clicked => { Nav.open-menu(t); } } }
                }
                if AppState.recents.length == 0 : Gutters {
                    StateCard {
                        icon: Icons.folder;
                        title: AppState.has-library ? "Sua música do aparelho" : "Traga a música do aparelho";
                        text: AppState.has-library && AppState.library-summary != "" ? AppState.library-summary : "Escolha uma pasta e o Kazzu toca sem internet.";
                        primary: AppState.has-library ? "Abrir a Biblioteca" : "Adicionar pasta";
                        primary-clicked => { if (AppState.has-library) { Nav.go(Tab.library); } else { AppState.add-folder(); } }
                    }
                }
            }
        }
    }
}
