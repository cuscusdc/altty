import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Tab, AppState } from "../theme/app-contract.slint";
import { CoverImage, IconButton, FormatBadge } from "../theme/atoms.slint";
import { EmptyState, PillButton, PillKind, NowBars } from "../components/basics.slint";
import { TrackRow } from "../components/media.slint";

export component QueueScreen inherits Rectangle {
    property <length> gutter: Theme.compact ? Theme.gutter-mobile : Theme.gutter-desktop;
    property <length> col-w: min(860px, root.width - 2 * gutter);
    property <float> appear: 0.0;
    init => { root.appear = 1.0; }
    opacity: appear;
    animate appear { duration: Theme.dur-short; easing: cubic-bezier(0.22, 0.9, 0.28, 1); }
    VerticalLayout {
        x: (root.width - self.width) / 2; width: root.col-w; height: parent.height;
        padding-bottom: Theme.compact ? 196px : 140px;
        spacing: 0px;
        HorizontalLayout {
            height: Theme.compact ? 72px : 88px; spacing: 8px; padding-top: Theme.compact ? 12px : 16px;
            VerticalLayout { alignment: center; IconButton { icon: Icons.back; label: "Voltar"; glyph: 24px; clicked => { AppState.queue-open = false; } } }
            Text { text: "Fila"; font-size: Theme.compact ? Theme.fs-large-title : 40px; font-weight: Theme.fw-large-title; letter-spacing: Theme.ls-large-title; color: Theme.ink; vertical-alignment: center; accessible-role: text; }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout { alignment: center; PillButton { kind: PillKind.quiet; icon: Icons.trash; label: "Limpar"; enabled: AppState.queue.length > 0 || AppState.has-now; clicked => { AppState.queue-clear(); } } }
        }
        if !AppState.has-now && AppState.queue.length == 0 : EmptyState {
            vertical-stretch: 1;
            icon: Icons.queue; title: "A fila está vazia";
            message: "Toque em uma música e ela aparece aqui, junto com as próximas.";
            action-label: "Ir para o Início"; action => { AppState.queue-open = false; AppState.navigate(Tab.home); }
        }
        if AppState.has-now : VerticalLayout {
            spacing: 12px; padding-top: 8px;
            Text { text: "Tocando agora"; font-size: Theme.fs-headline; font-weight: Theme.fw-headline; color: Theme.ink-2; }
            Rectangle {
                height: 88px; border-radius: Theme.r-lg; background: Theme.accent-soft;
                HorizontalLayout {
                    padding: 12px; spacing: 12px;
                    CoverImage { width: 64px; height: 64px; source: AppState.now.cover; radius: 14px; }
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: center;
                        Text { text: AppState.now.title; font-size: 18px; font-weight: 700; color: Theme.ink; overflow: elide; wrap: no-wrap; }
                        Text { text: AppState.now.artist; font-size: Theme.fs-callout; color: Theme.ink-2; overflow: elide; wrap: no-wrap; }
                    }
                    if AppState.now.codec != "" && !Theme.compact : VerticalLayout { alignment: center; FormatBadge { codec: AppState.now.codec; detail: AppState.now.detail; hires: AppState.now.hires; } }
                    VerticalLayout { alignment: center; NowBars { } }
                }
            }
        }
        if AppState.queue.length > 0 : Text {
            text: AppState.queue-summary; font-size: Theme.fs-headline; font-weight: Theme.fw-headline; color: Theme.ink-2;
            height: 48px; vertical-alignment: bottom;
        }
        if AppState.queue.length > 0 : ListView {
            vertical-stretch: 1; x: Theme.compact ? -8px : 0px; width: parent.width + (Theme.compact ? 16px : 0px); vertical-scrollbar-policy: always-off;
            for t[i] in AppState.queue : TrackRow {
                track: t; queue-mode: true; index: i;
                clicked => { AppState.queue-jump(i); }
                remove => { AppState.queue-remove(i); }
            }
        }
        if AppState.queue-more-label != "" : Text {
            height: 40px; text: AppState.queue-more-label; font-size: Theme.fs-subhead; color: Theme.ink-3; vertical-alignment: center; accessible-role: text;
        }
        if AppState.queue.length == 0 && AppState.has-now : Rectangle {
            vertical-stretch: 1;
            Text { y: 24px; text: "Não há próximas músicas. O que você tocar a seguir entra aqui."; font-size: Theme.fs-body; color: Theme.ink-3; wrap: word-wrap; width: parent.width; }
        }
    }
}
