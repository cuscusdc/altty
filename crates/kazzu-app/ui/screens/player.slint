// Player (v4): a capa INTEIRA de ponta a ponta; logo abaixo, o reflexo dela (imagem `backdrop` 192×464 do Rust); e UM console
// de vidro sobre o reflexo, que sobe 24 sobre a base da capa. Sem degradê desenhado: toda a cor é a própria capa, e o desfoque
// do console é ao vivo e moderado (24) para as formas grandes da capa continuarem reconhecíveis. SEMPRE escuro (decisão A3):
// só usa `media-*`. Em janelas largas (>= 1100): capa à esquerda e console à direita, sobre a capa muito desfocada.
// Arrastar a capa para baixo fecha; o botão de fechar é a alternativa.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState, RepeatMode } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { MediaGlass, MediaIconButton, Pressable, Icon, IconButton, TextButton, Scrubber, Spinner } from "../components/atoms.slint";

// Console: título, posição, transporte, volume, saída e fila. Mesmo conteúdo no celular, no tablet e no desktop.
component PlayerConsole inherits VerticalLayout {
    in property <length> pad-x: Theme.s-xl;
    in property <length> pad-top: Theme.s-xl + Theme.s-xs;
    in property <length> pad-bottom: Theme.s-lg;
    padding-left: root.pad-x;
    padding-right: root.pad-x;
    padding-top: root.pad-top;
    padding-bottom: root.pad-bottom;
    alignment: space-between;
    // título, artista, curtir. Todo texto do console é branco puro: a hierarquia vem do tamanho e do peso.
    HorizontalLayout {
        spacing: Theme.s-sm;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: AppState.now.title; color: Theme.media-ink; font-family: Theme.font-display; font-size: Theme.text-xl; font-weight: 700; letter-spacing: -0.44px; overflow: elide; accessible-role: AccessibleRole.text; }
            Text { text: AppState.now.artist; color: Theme.media-ink; font-size: Theme.text-lg; overflow: elide; accessible-role: AccessibleRole.text; }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: AppState.now.liked ? Icons.heart-fill : Icons.heart;
                tint: Theme.media-ink;
                media: true;
                ring-color: Theme.media-ink;
                label: AppState.now.liked ? "Descurtir" : "Curtir";
                clicked => { AppState.toggle-like(AppState.now.id); }
            }
        }
    }
    // erro: uma linha com a ação, entre o título e a posição
    if AppState.player-error != "" : VerticalLayout {
        spacing: Theme.s-xxs;
        Text { text: AppState.player-error; color: Theme.media-ink; font-size: Theme.text-md; font-weight: 600; wrap: word-wrap; accessible-role: AccessibleRole.text; accessible-live-region: AccessibleLiveness.polite; }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.s-sm;
            TextButton { text: AppState.player-error-action; ink: Theme.media-ink; ring-color: Theme.media-ink; width: 140px; clicked => { AppState.retry-track(); } }
            TextButton { text: "Pular"; ink: Theme.media-ink; ring-color: Theme.media-ink; width: 80px; clicked => { AppState.next(); } }
        }
    }
    // posição: tempo decorrido, de onde vem e em que formato, tempo que falta
    VerticalLayout {
        // o desenho da barra é fino; o toque tem os 48 (a linha ultrapassa 8 para cima e para baixo da faixa de 32)
        Rectangle {
            height: 32px;
            Scrubber {
                y: -8px;
                height: 48px;
                value: AppState.progress;
                label: "Posição";
                value-text: AppState.position-label + ", faltam " + AppState.remaining-label;
                seek(v) => { AppState.seek(v); }
            }
        }
        HorizontalLayout {
            height: 24px;
            spacing: Theme.s-xs;
            Text { width: 44px; text: AppState.position-label; color: Theme.media-ink; font-size: Theme.text-sm; vertical-alignment: center; accessible-role: none; }
            Text { text: AppState.now-source-line; color: Theme.media-ink; font-size: Theme.text-xs; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; accessible-label: AppState.now-source-line + (AppState.output-note != "" ? ". " + AppState.output-note : ""); }
            Text { width: 48px; text: AppState.remaining-label; color: Theme.media-ink; font-size: Theme.text-sm; horizontal-alignment: right; vertical-alignment: center; accessible-role: none; }
        }
    }
    HorizontalLayout {
        alignment: space-between;
        VerticalLayout { alignment: center; IconButton { icon: Icons.shuffle; tint: Theme.media-ink; media: true; on: AppState.shuffle; label: AppState.shuffle ? "Aleatório, ligado" : "Aleatório, desligado"; ring-color: Theme.media-ink; clicked => { AppState.toggle-shuffle(); } } }
        VerticalLayout { alignment: center; IconButton { width: 56px; height: 56px; visual: 56px; icon: Icons.prev; icon-size: 36px; tint: Theme.media-ink; media: true; label: "Anterior"; ring-color: Theme.media-ink; clicked => { AppState.previous(); } } }
        Pressable {
            width: 72px;
            height: 72px;
            label: AppState.player-loading ? "Carregando" : AppState.playing ? "Pausar" : "Tocar";
            ring-color: Theme.media-ink;
            clicked => { AppState.toggle-play(); }
            Rectangle { border-radius: 36px; background: Theme.media-ink; opacity: parent.pressed ? 0.85 : 1; }
            if !AppState.player-loading : Icon { source: AppState.playing ? Icons.pause : Icons.play; tint: Theme.media-console; size: 32px; }
            if AppState.player-loading : Rectangle { Spinner { tint: Theme.media-console; size: 32px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
        }
        VerticalLayout { alignment: center; IconButton { width: 56px; height: 56px; visual: 56px; icon: Icons.next; icon-size: 36px; tint: Theme.media-ink; media: true; label: "Próxima"; ring-color: Theme.media-ink; clicked => { AppState.next(); } } }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.repeat;
                tint: Theme.media-ink;
                media: true;
                on: AppState.repeat != RepeatMode.off;
                badge: AppState.repeat == RepeatMode.one ? "1" : "";
                label: AppState.repeat == RepeatMode.off ? "Repetir, desligado" : AppState.repeat == RepeatMode.all ? "Repetir tudo" : "Repetir esta música";
                ring-color: Theme.media-ink;
                clicked => { AppState.cycle-repeat(); }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.s-sm;
        Icon { source: Icons.vol-low; tint: Theme.media-ink; size: 20px; }
        Scrubber { height: 48px; value: AppState.volume; label: "Volume"; value-text: Math.round(AppState.volume * 100) + " por cento"; seek(v) => { AppState.set-volume(v); } }
        Icon { source: Icons.vol-high; tint: Theme.media-ink; size: 20px; }
    }
    // saída atual e Fila: dois botões com caixa (um poço mais escuro dentro do vidro; nunca vidro dentro de vidro)
    HorizontalLayout {
        spacing: Theme.s-sm;
        for a[i] in [{ icon: Icons.device, text: AppState.output-name != "" ? AppState.output-name : "Este aparelho", label: "Saída: " + AppState.output-name }, { icon: Icons.queue, text: "Fila", label: "Abrir a fila" }] : Pressable {
            height: Theme.control-h;
            horizontal-stretch: 1;
            ring-color: Theme.media-ink;
            label: a.label;
            clicked => { if (i == 1) { AppState.queue-open = true; } else { AppState.open-output-picker(); } }
            Rectangle { border-radius: parent.height / 2; background: Theme.media-well; border-width: 1px; border-color: Theme.media-edge-lo; opacity: parent.pressed ? 0.7 : 1; }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.s-xs;
                padding-left: Theme.s-sm;
                padding-right: Theme.s-sm;
                VerticalLayout { alignment: center; Icon { source: a.icon; tint: Theme.media-ink; size: 20px; } }
                Text { text: a.text; color: Theme.media-ink; font-size: Theme.text-md; font-weight: 600; vertical-alignment: center; overflow: elide; accessible-role: none; }
            }
        }
    }
}

// A pílula "Tocando de <origem>" e os botões de vidro do topo.
component PlayerTop inherits Rectangle {
    in property <length> art;
    in property <length> left;
    height: 48px + Theme.s-xs;
    MediaIconButton { x: root.left + Theme.s-xs; y: Theme.s-xs; icon: Icons.chevron-down; label: "Fechar o player"; clicked => { Nav.close-player(); } }
    MediaGlass {
        x: root.left + (root.art - self.width) / 2;
        y: Theme.s-xs + 2px;
        width: min(ctx.preferred-width + 2 * Theme.s-md, root.art - 128px);
        height: 44px;
        radius: 22px;
        ctx := HorizontalLayout {
            alignment: center;
            spacing: 4px;
            if AppState.now-origin != "" : Text { text: "Tocando de"; color: Theme.media-ink; font-size: Theme.text-sm; vertical-alignment: center; accessible-role: none; }
            Text { text: AppState.now-origin != "" ? AppState.now-origin : "Tocando agora"; color: Theme.media-ink; font-size: Theme.text-sm; font-weight: 600; vertical-alignment: center; overflow: elide; accessible-role: AccessibleRole.text; }
        }
    }
    MediaIconButton { x: root.left + root.art - Theme.s-xs - 48px; y: Theme.s-xs; icon: Icons.more; label: "Mais ações"; clicked => { Nav.open-menu(AppState.now); } }
}

export component PlayerScreen inherits Rectangle {
    property <float> appear: 0;
    property <length> drag-y: 0px;
    property <bool> dragging: false;
    property <bool> wide: Theme.wide;
    // celular e tablet: capa de ponta a ponta (até 520); desktop: cartão de capa + console lado a lado
    property <length> art: root.wide ? min(480px, root.height - 96px - AppState.safe-top - AppState.safe-bottom, (root.width - 64px) / 2) : min(root.width, 520px);
    property <length> left: root.wide ? (root.width - 2 * root.art) / 2 : (root.width - root.art) / 2;
    property <length> card-y: (root.height - root.art) / 2;
    init => { root.appear = 1; }
    animate appear { duration: Theme.dur-long; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
    background: Theme.media-console;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Player";
    // arrastar a capa para baixo fecha: segue o dedo; passando de 140 fecha, senão volta. O TouchArea fica FORA da folha que se move
    // (senão o mouse-y relativo realimentaria o arraste) e ABAIXO dela (os botões continuam clicáveis: a folha deixa passar o resto).
    drag := TouchArea {
        x: root.left;
        y: root.wide ? root.card-y : 0;
        width: root.art;
        height: root.wide ? root.art : root.art - Theme.s-xl;
        property <length> start-y: 0px;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.dragging = true; drag.start-y = drag.mouse-y; }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.dragging = false;
                if (root.drag-y > 140px) { Nav.close-player(); } else { root.drag-y = 0px; }
            }
        }
        moved => { if (self.pressed) { root.drag-y = max(0px, self.mouse-y - self.start-y); } }
    }
    sheet := Rectangle {
        y: root.drag-y + (Theme.reduce-motion ? 0px : (1 - root.appear) * root.height);
        opacity: Theme.reduce-motion ? root.appear : 1;
        animate y { duration: root.dragging ? 0ms : Theme.dur-short; }
        background: Theme.media-console;
        clip: true;
        // 1. fundo: em janelas mais largas que a capa, a capa muito desfocada cobre a janela, bem escurecida; por cima, no
        //    celular e no tablet, a capa + o reflexo (192 × 464 do Rust) desenhados na largura da capa, a partir do topo
        if Theme.glass-on && AppState.backdrop-wide.width > 0 && (root.wide || root.width > root.art) : Image { width: 100%; height: 100%; source: AppState.backdrop-wide; image-fit: ImageFit.cover; accessible-role: none; }
        if Theme.glass-on && (root.wide || root.width > root.art) : Rectangle { background: Theme.media-console.with-alpha(0.6); }
        if Theme.glass-on && !root.wide : Image { x: root.left; y: 0; width: root.art; height: root.art * 464 / 192; source: AppState.backdrop; image-fit: ImageFit.fill; accessible-role: none; }
        // 2. a capa nítida, inteira
        cover := Rectangle {
            x: root.left;
            y: root.wide ? root.card-y : 0;
            width: root.art;
            height: root.art;
            clip: true;
            background: Theme.media-console;
            border-top-left-radius: root.wide ? Theme.r-sheet : 0px;
            border-bottom-left-radius: root.wide ? Theme.r-sheet : 0px;
            if AppState.now-art.width == 0 && AppState.now.cover.width == 0 : Icon { source: Icons.disc; tint: Theme.muted; size: 96px; }
            Image { source: AppState.now-art.width > 0 ? AppState.now-art : AppState.now.cover; width: 100%; height: 100%; image-fit: ImageFit.cover; accessible-label: "Capa de " + AppState.now.album; }
        }
        // 3. controles do topo, em vidro sobre a capa
        PlayerTop { y: (root.wide ? root.card-y : AppState.safe-top) + 0px; art: root.art; left: root.left; }
        // 4. o console
        console := Rectangle {
            x: root.wide ? root.left + root.art : root.left;
            y: root.wide ? root.card-y : root.art - Theme.s-xl;
            width: root.art;
            height: root.wide ? root.art : root.height - self.y;
            border-top-left-radius: root.wide ? 0px : Theme.r-sheet;
            border-top-right-radius: Theme.r-sheet;
            border-bottom-right-radius: root.wide ? Theme.r-sheet : 0px;
            clip: true;
            background: Theme.glass-on ? Theme.media-console.with-alpha(AppState.player-dim) : Theme.media-console;
            backdrop-blur: Theme.glass-on ? Theme.glass-blur-console : 0px;
            border-width: 1px;
            border-color: @linear-gradient(180deg, Theme.media-edge-hi 0%, Theme.media-edge-lo 12%, Theme.media-edge-lo.with-alpha(0) 30%);
            Rectangle { y: 0; height: 96px; background: @linear-gradient(180deg, Theme.media-edge-hi.with-alpha(0.10) 0%, Theme.media-edge-hi.with-alpha(0) 100%); }
            PlayerConsole {
                pad-x: root.wide ? Theme.s-xl : root.width < 368px ? Theme.s-md : Theme.s-xl;     // 320 de largura: o transporte (280) precisa caber
                pad-top: root.wide ? Theme.s-xl : Theme.s-xl + Theme.s-xs;
                pad-bottom: Theme.s-lg + (root.wide ? 0px : AppState.safe-bottom);
            }
        }
    }
}
