// Ajustes (v4): grupos sólidos com linhas de 56+. "Sem telemetria" é uma constante (nenhum controle). Recursos que ainda não
// existem aparecem como "Em breve", sem interruptor falso.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab, ThemeMode } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { Pressable, Button, TextButton, IconButton, Switch, Segmented, Tag, Group, GroupItem } from "../components/atoms.slint";
import { Screen, RootHeader, LargeTitle, Gutters, Narrow } from "../components/shared.slint";

component GroupHead inherits Rectangle {
    in property <string> text;
    height: 28px;
    Text { x: Theme.gutter + Theme.s-md; text: root.text; color: Theme.ink-2; font-size: Theme.text-md; font-weight: 600; accessible-role: AccessibleRole.text; }
}

// Linha com escolha entre poucas opções: título em cima, `Segmented` embaixo.
component SegItem inherits Rectangle {
    in property <string> title;
    in property <[string]> options;
    in property <int> current;
    in property <bool> separator: true;
    callback changed(int);
    height: 104px;
    if root.separator : Rectangle { y: 0; height: 1px; background: Theme.rule; }
    Text { x: Theme.s-md; y: Theme.s-sm; text: root.title; color: Theme.ink; font-size: Theme.text-lg; accessible-role: AccessibleRole.text; }
    Segmented { x: Theme.s-md; y: 44px; width: parent.width - 2 * Theme.s-md; options: root.options; current: root.current; changed(i) => { root.changed(i); } }
}

export component SettingsScreen inherits Rectangle {
    property <bool> confirm-clear: false;
    property <bool> show-licenses: false;
    clear-timer := Timer { interval: 4s; running: root.confirm-clear; triggered => { root.confirm-clear = false; } }
    Screen {
        tab: Tab.settings;
        VerticalLayout {
            padding-top: AppState.safe-top + Theme.s-xs;
            padding-bottom: Metrics.reserve;
            spacing: Theme.s-xl;
            alignment: start;
            VerticalLayout { RootHeader { logo: false; back: true; gear: false; back-clicked => { Nav.go(Tab.home); } } LargeTitle { text: "Ajustes"; } }
            Narrow {
                VerticalLayout {
                    spacing: Theme.s-xl;
                    VerticalLayout {
                        GroupHead { text: "Reprodução"; }
                        Gutters {
                            Group {
                                SegItem { separator: false; title: "Qualidade do streaming"; options: ["Original", "Alta", "Econômica"]; current: AppState.stream-quality; changed(i) => { AppState.stream-quality = i; AppState.stream-quality-changed(i); } }
                                GroupItem {
                                    title: "Continuar com músicas parecidas";
                                    note: "Quando a fila acabar.";
                                    VerticalLayout { alignment: center; Switch { checked <=> AppState.autoplay-radio; label: "Continuar com músicas parecidas"; toggled(v) => { AppState.autoplay-radio-changed(v); } } }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        GroupHead { text: "Aparência"; }
                        Gutters {
                            Group {
                                SegItem {
                                    separator: false;
                                    title: "Tema";
                                    options: ["Automático", "Claro", "Escuro"];
                                    current: AppState.theme-mode == ThemeMode.auto ? 0 : AppState.theme-mode == ThemeMode.light ? 1 : 2;
                                    changed(i) => { AppState.theme-mode = i == 0 ? ThemeMode.auto : i == 1 ? ThemeMode.light : ThemeMode.dark; AppState.theme-mode-changed(AppState.theme-mode); }
                                }
                                GroupItem {
                                    title: "Reduzir transparência";
                                    note: "Troca o vidro por superfícies sólidas.";
                                    VerticalLayout { alignment: center; Switch { checked <=> Theme.reduce-transparency; label: "Reduzir transparência"; toggled(v) => { AppState.reduce-transparency-changed(v); } } }
                                }
                                GroupItem {
                                    title: "Reduzir movimento";
                                    note: "Tira os deslocamentos das transições.";
                                    VerticalLayout { alignment: center; Switch { checked <=> Theme.reduce-motion; label: "Reduzir movimento"; toggled(v) => { AppState.reduce-motion-changed(v); } } }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        GroupHead { text: "Fontes de música"; }
                        Gutters {
                            Group {
                                GroupItem { separator: false; has-icon: true; icon: Icons.badge-check; title: "YouTube Music"; note: "Sem conta."; value: "Ligado"; }
                                GroupItem {
                                    has-icon: true;
                                    icon: Icons.folder;
                                    title: "Arquivos neste aparelho";
                                    note: AppState.library-summary != "" ? AppState.library-summary : "Nenhuma pasta adicionada.";
                                }
                                for f in AppState.folders : GroupItem {
                                    title: f;
                                    VerticalLayout { alignment: center; IconButton { icon: Icons.trash; label: "Remover a pasta " + f; clicked => { AppState.remove-folder(f); } } }
                                }
                                Pressable {
                                    height: 56px;
                                    ring-radius: Theme.r-group;
                                    label: "Adicionar pasta";
                                    clicked => { AppState.add-folder(); }
                                    GroupItem { has-icon: true; icon: Icons.plus; title: "Adicionar pasta"; chevron: true; }
                                }
                                if AppState.folders.length > 0 : Pressable {
                                    height: 56px;
                                    enabled: !AppState.scanning;
                                    ring-radius: Theme.r-group;
                                    label: "Procurar músicas de novo";
                                    clicked => { AppState.rescan(); }
                                    GroupItem { has-icon: true; icon: Icons.refresh; title: "Procurar músicas de novo"; note: AppState.scanning ? AppState.scan-label : ""; dimmed: AppState.scanning; chevron: true; }
                                }
                                GroupItem { title: "Spotify"; value: "Em breve"; }
                                GroupItem { title: "Tidal"; value: "Em breve"; }
                                GroupItem { title: "Qobuz"; value: "Em breve"; }
                            }
                        }
                    }
                    VerticalLayout {
                        GroupHead { text: "Privacidade"; }
                        Gutters {
                            Group {
                                GroupItem { separator: false; has-icon: true; icon: Icons.shield; title: "Sem telemetria"; note: "O Kazzu não coleta nada. Não há conta."; }
                                Pressable {
                                    height: 72px;
                                    ring-radius: Theme.r-group;
                                    label: root.confirm-clear ? "Confirmar: apagar o histórico" : "Apagar histórico";
                                    clicked => { if (root.confirm-clear) { root.confirm-clear = false; AppState.clear-history(); } else { root.confirm-clear = true; } }
                                    GroupItem { has-icon: true; icon: Icons.trash; title: root.confirm-clear ? "Toque de novo para apagar" : "Apagar histórico"; note: root.confirm-clear ? "Não dá para desfazer." : "Buscas e reprodução deste aparelho."; chevron: !root.confirm-clear; }
                                }
                                Pressable {
                                    height: 72px;
                                    ring-radius: Theme.r-group;
                                    label: "Relatar um problema";
                                    clicked => { AppState.report-problem(); }
                                    GroupItem { has-icon: true; icon: Icons.info; title: "Relatar um problema"; note: "Gera um arquivo aqui. Você decide se envia."; chevron: true; }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        GroupHead { text: "Sobre"; }
                        Gutters {
                            Group {
                                GroupItem { separator: false; has-icon: true; icon: Icons.info; title: AppState.version-label; note: "Licença GPL-3.0. Software livre."; VerticalLayout { alignment: center; TextButton { text: root.show-licenses ? "Ocultar" : "Licenças"; ink: Theme.ink; width: 96px; clicked => { root.show-licenses = !root.show-licenses; } } } }
                                if root.show-licenses : Rectangle {
                                    height: lic.preferred-height + 2 * Theme.s-md;
                                    lic := Text { x: Theme.s-md; y: Theme.s-md; width: parent.width - 2 * Theme.s-md; text: AppState.licenses-text != "" ? AppState.licenses-text : "Licenças de terceiros: veja o arquivo LICENSE do projeto."; color: Theme.ink-2; font-size: Theme.text-sm; wrap: word-wrap; accessible-role: AccessibleRole.text; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
