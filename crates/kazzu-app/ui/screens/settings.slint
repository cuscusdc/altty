// Ajustes (SLINT_SPEC §4.9): grupos de vidro nível 1. Telemetria é constante (KSwitch locked), nunca um controle.
import { Theme } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { Metrics } from "../theme/metrics.slint";
import { AppState, Tab, ThemeMode, AccentMode } from "../theme/app-contract.slint";
import { Nav } from "../theme/nav-state.slint";
import { IconButton, GlassPanel, KSwitch } from "../theme/atoms.slint";
import { ScreenScroll, Gutter, PageTitle } from "../components/layout.slint";
import { PillButton, PillKind, Tag, Segmented, RoundButton, TextButton, Logo } from "../components/basics.slint";

// Linha de ajuste: ícone num quadrado de 40 (raio 12), título 16 semibold, descrição, controle à direita (@children).
component SettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <bool> divider: true;
    min-height: 64px;
    preferred-height: max(64px, text-col.preferred-height + 20px);
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 14px;
        Rectangle { width: 40px; height: 40px; y: (parent.height - self.height) / 2; border-radius: 12px; background: Theme.ink.with-alpha(0.10);
            Image { source: root.icon; width: Theme.icon-sm; height: Theme.icon-sm; x: 10px; y: 10px; colorize: Theme.ink; } }
        text-col := VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text { text: root.title; font-size: Theme.fs-body; font-weight: 600; color: Theme.ink; wrap: word-wrap; accessible-role: text; }
            if root.description != "" : Text { text: root.description; font-size: Theme.fs-subhead; color: Theme.ink-2; wrap: word-wrap; accessible-role: text; }
        }
        VerticalLayout { alignment: center; @children }
    }
    if root.divider : Rectangle { x: 14px + 40px + 14px; y: parent.height - 1px; width: parent.width - self.x; height: 1px; background: Theme.ink.with-alpha(0.10); }
}

// Grupo: título fora do vidro (subhead 14 semibold ink-2) + painel nível 1 com as linhas.
component SettingGroup inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    Text { text: root.title; font-size: Theme.fs-subhead; font-weight: 600; color: Theme.ink-2; accessible-role: text; }
    GlassPanel {
        level: 1; radius: 24px; height: col.preferred-height;
        col := VerticalLayout { padding-top: 4px; padding-bottom: 4px; @children }
    }
}

export component SettingsScreen inherits Rectangle {
    property <bool> confirm-clear: false;
    property <bool> show-licenses: false;
    clear-timer := Timer { interval: 4s; running: root.confirm-clear; triggered => { root.confirm-clear = false; } }

    ScreenScroll {
        tab: Tab.settings; width: parent.width; height: parent.height;
        // topo: voltar + título
        Gutter { height: 64px; spacing: 12px;
            RoundButton { y: (parent.height - self.height) / 2; icon: Icons.chevron-left; label: "Voltar ao Início"; clicked => { Nav.go(Tab.home); } }
            Text { text: "Ajustes"; font-size: Theme.fs-large-title; font-weight: Theme.fw-large-title; letter-spacing: Theme.ls-large-title; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; accessible-role: text; }
        }
        Rectangle { height: 12px; }

        Gutter { VerticalLayout { horizontal-stretch: 1; spacing: 24px;
            // ---- Fontes de música
            SettingGroup { title: "Fontes de música";
                SettingRow { icon: Icons.cloud; title: "YouTube Music"; description: "Ativo e padrão. Sem login."; Tag { label: "Ativo"; accent: true; } }
                SettingRow { icon: Icons.folder; title: "Arquivos neste aparelho"; description: AppState.library-summary != "" ? AppState.library-summary : "Nenhuma pasta adicionada";
                    PillButton { kind: PillKind.quiet; label: "Adicionar pasta"; clicked => { AppState.add-folder(); } } }
                for f in AppState.folders : SettingRow { icon: Icons.folder; title: f; divider: true;
                    IconButton { icon: Icons.trash; label: "Remover a pasta " + f; tint: Theme.ink; clicked => { AppState.remove-folder(f); } } }
                if AppState.folders.length > 0 : SettingRow { icon: Icons.refresh; title: "Procurar músicas de novo"; description: AppState.scanning ? AppState.scan-label : ""; 
                    TextButton { label: "Atualizar"; enabled: !AppState.scanning; clicked => { AppState.rescan(); } } }
                SettingRow { icon: Icons.plus; title: "Outras fontes"; description: "Spotify, Tidal e Qobuz entram depois, só se você ligar."; divider: false; Tag { label: "Em breve"; } }
            }
            // ---- Áudio
            SettingGroup { title: "Áudio";
                SettingRow { icon: Icons.sliders; title: "Qualidade do stream"; description: "Original usa o melhor formato que o YouTube Music oferece.";
                    divider: false; }
                Rectangle { height: 56px;
                    Segmented { x: 14px; width: parent.width - 28px; y: 0px; label: "Qualidade do stream"; options: ["Original", "Alta", "Baixa"]; selected: AppState.stream-quality;
                        changed(i) => { AppState.stream-quality = i; AppState.stream-quality-changed(i); } }
                }
                Rectangle { height: 1px; background: Theme.ink.with-alpha(0.10); }
                SettingRow { icon: Icons.wave; title: "Continuar com músicas parecidas"; description: "Quando a fila acabar, o Kazzu segue com sugestões do YouTube Music.";
                    KSwitch { label: "Continuar com músicas parecidas"; checked <=> AppState.autoplay-radio; toggled(v) => { AppState.autoplay-radio-changed(v); } } }
                SettingRow { icon: Icons.eq; title: "Equalizador"; Tag { label: "Em breve"; } }
                SettingRow { icon: Icons.download; title: "Baixar só no Wi-Fi"; divider: false; Tag { label: "Em breve"; } }
            }
            // ---- Aparência
            SettingGroup { title: "Aparência";
                SettingRow { icon: Icons.sun; title: "Tema"; divider: false; }
                Rectangle { height: 56px;
                    Segmented { x: 14px; width: parent.width - 28px; label: "Tema"; options: ["Automático", "Claro", "Escuro"];
                        selected: AppState.theme-mode == ThemeMode.auto ? 0 : AppState.theme-mode == ThemeMode.light ? 1 : 2;
                        changed(i) => { AppState.theme-mode = i == 0 ? ThemeMode.auto : i == 1 ? ThemeMode.light : ThemeMode.dark; AppState.theme-mode-changed(AppState.theme-mode); } }
                }
                Rectangle { height: 1px; background: Theme.ink.with-alpha(0.10); }
                SettingRow { icon: Icons.disc; title: "Cor de destaque"; divider: false; }
                Rectangle { height: 56px;
                    Segmented { x: 14px; width: parent.width - 28px; label: "Cor de destaque"; options: ["Da capa", "Marca"];
                        selected: AppState.accent-mode == AccentMode.from-cover ? 0 : 1;
                        changed(i) => { AppState.accent-mode = i == 0 ? AccentMode.from-cover : AccentMode.brand; AppState.accent-mode-changed(AppState.accent-mode); } }
                }
                Rectangle { height: 1px; background: Theme.ink.with-alpha(0.10); }
                SettingRow { icon: Icons.sliders; title: "Reduzir transparência"; description: "Troca o vidro por painéis sólidos. Ajuda em telas lentas e em baixa visão.";
                    KSwitch { label: "Reduzir transparência"; checked <=> Theme.reduce-transparency; toggled(v) => { AppState.reduce-transparency-changed(v); } } }
                SettingRow { icon: Icons.refresh; title: "Reduzir movimento"; description: "Troca de capa e animações viram cortes secos."; divider: false;
                    KSwitch { label: "Reduzir movimento"; checked <=> Theme.reduce-motion; toggled(v) => { AppState.reduce-motion-changed(v); } } }
            }
            // ---- Privacidade
            SettingGroup { title: "Privacidade";
                SettingRow { icon: Icons.shield; title: "Sem telemetria"; description: "O Kazzu só recebe dados. Nada sobre você sai do aparelho. Não dá para desligar.";
                    KSwitch { label: "Sem telemetria, sempre ligado"; locked: true; } }
                SettingRow { icon: Icons.clock; title: "Histórico de escuta"; description: root.confirm-clear ? "Toque de novo para apagar. Não dá para desfazer." : "Fica só neste aparelho."; divider: false;
                    PillButton { kind: root.confirm-clear ? PillKind.primary : PillKind.quiet; label: root.confirm-clear ? "Confirmar" : "Apagar";
                        clicked => { if (root.confirm-clear) { root.confirm-clear = false; AppState.clear-history(); } else { root.confirm-clear = true; } } } }
            }
            // ---- Sobre
            SettingGroup { title: "Sobre";
                SettingRow { icon: Icons.info; title: AppState.version-label; description: "Licença GPL-3.0. Software livre."; 
                    TextButton { label: root.show-licenses ? "Ocultar" : "Licenças"; clicked => { root.show-licenses = !root.show-licenses; } } }
                if root.show-licenses : Rectangle { height: lic.preferred-height + 24px;
                    lic := Text { x: 16px; y: 12px; width: parent.width - 32px; text: AppState.licenses-text != "" ? AppState.licenses-text : "Licenças de terceiros: veja o arquivo LICENSE do projeto."; font-size: Theme.fs-caption; font-family: Theme.font-mono; color: Theme.ink-2; wrap: word-wrap; accessible-role: text; } }
                SettingRow { icon: Icons.info; title: "Relatar um problema"; description: "Gera um arquivo neste aparelho. Nada é enviado."; divider: false;
                    PillButton { kind: PillKind.quiet; label: "Gerar"; clicked => { AppState.report-problem(); } } }
            }
        } }
    }
}
